#!/usr/bin/env python3
"""turtle-bg — Run an AI agent plan in the background.

The plan executes detached from your terminal. Get notified when done.

Usage:
  turtle-bg "deploy to staging"          Start a background plan
  turtle-bg list                          List running/recent plans
  turtle-bg status [PLAN_ID]             Show status of a plan
  turtle-bg cancel PLAN_ID               Cancel a running plan
  turtle-bg log PLAN_ID                  Tail the plan log
"""
from __future__ import annotations
import json, subprocess, sys
from pathlib import Path

AGENTCTL = Path(__file__).parent / "turtle-agentctl"

def agentd(payload: dict) -> dict | None:
    try:
        r = subprocess.run([sys.executable, str(AGENTCTL), "--stdio"],
            input=json.dumps(payload), text=True, capture_output=True, timeout=30)
        return json.loads(r.stdout)
    except Exception: return None

def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__); return 0

    if args[0] == "list":
        r = agentd({"action": "bg-plan-list"})
        if not r: print("agentd not responding", file=sys.stderr); return 1
        plans = r.get("data", {}).get("plans", [])
        if not plans: print("No background plans.")
        for p in plans:
            status = p.get("status", "?")
            icon = {"running": "⟳", "completed": "✓", "cancelled": "✗", "failed": "✗"}.get(status, "?")
            print(f"  {icon}  {p.get('plan_id','?')}  [{status}]  {p.get('goal','')[:60]}")
        return 0

    if args[0] == "status":
        plan_id = args[1] if len(args) > 1 else ""
        r = agentd({"action": "bg-plan-status", "plan_id": plan_id})
        if not r: print("agentd not responding", file=sys.stderr); return 1
        d = r.get("data", {})
        if not d.get("found"): print(f"Plan not found: {plan_id}"); return 1
        print(f"Plan:   {d.get('plan_id')}")
        print(f"Goal:   {d.get('goal')}")
        print(f"Status: {d.get('status')}")
        print(f"PID:    {d.get('pid')}")
        if d.get("log_tail"):
            print(f"\nLog (last 20 lines):\n{d['log_tail']}")
        return 0

    if args[0] == "cancel":
        if len(args) < 2: print("Usage: turtle-bg cancel PLAN_ID", file=sys.stderr); return 1
        r = agentd({"action": "bg-plan-cancel", "plan_id": args[1]})
        if not r: return 1
        d = r.get("data", {})
        print("Cancelled." if d.get("cancelled") else f"Not cancelled: {d.get('reason','?')}")
        return 0

    if args[0] == "log":
        plan_id = args[1] if len(args) > 1 else ""
        r = agentd({"action": "bg-plan-status", "plan_id": plan_id})
        if not r: return 1
        d = r.get("data", {})
        log_dir = Path.home() / ".config" / "turtleterm" / "bg_plans"
        log_file = log_dir / f"{d.get('plan_id','?')}.log"
        if not log_file.exists(): print("No log found."); return 1
        import subprocess as sp
        sp.run(["tail", "-f", "-n", "50", str(log_file)])
        return 0

    # Default: start a background plan
    goal = " ".join(args)
    print(f"Starting background plan: {goal}")
    r = agentd({"action": "bg-plan-start", "goal": goal})
    if not r: print("agentd not responding", file=sys.stderr); return 1
    d = r.get("data", {})
    if d.get("started"):
        print(f"  Plan ID : {d['plan_id']}")
        print(f"  Log     : {d['log']}")
        print(f"  Status  : turtle-bg status {d['plan_id']}")
    else:
        print(f"Failed: {d.get('reason','?')}", file=sys.stderr); return 1
    return 0

if __name__ == "__main__": raise SystemExit(main())
