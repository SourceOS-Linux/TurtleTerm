#!/usr/bin/env python3
"""TurtleTerm language-intelligence CLI v0.

Routes language intelligence requests to SynapseIQ LSP
(SOURCEOS_SYNAPSEIQ_URL, default http://localhost:2087) when available,
falling back to built-in heuristics. Never mutates files.

SynapseIQ owns Tree-sitter grammars and the language server implementation.
TurtleTerm is the terminal surface that bridges to it.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Any
from urllib import error as urlerror
from urllib import request as urlrequest


SCHEMA = "sourceos.turtle.language.response.v0"


# ---------------------------------------------------------------------------
# SynapseIQ LSP bridge
# ---------------------------------------------------------------------------

def synapseiq_url() -> str:
    return os.environ.get("SOURCEOS_SYNAPSEIQ_URL", "http://localhost:2087")


def _synapseiq_post(path: str, payload: dict[str, Any], timeout: int = 4) -> dict[str, Any] | None:
    url = synapseiq_url().rstrip("/") + path
    try:
        body = json.dumps(payload).encode("utf-8")
        req = urlrequest.Request(
            url,
            data=body,
            method="POST",
            headers={"Content-Type": "application/json", "Accept": "application/json"},
        )
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8", errors="replace"))
    except (urlerror.URLError, OSError, TimeoutError, json.JSONDecodeError):
        return None


def synapseiq_diagnostics(file: str, text: str, language: str) -> dict[str, Any] | None:
    return _synapseiq_post("/lsp/diagnostics", {"file": file, "text": text, "language": language})


def synapseiq_symbols(file: str, text: str, language: str) -> dict[str, Any] | None:
    return _synapseiq_post("/lsp/symbols", {"file": file, "text": text, "language": language})


def synapseiq_hover(file: str, text: str, language: str, line: int, character: int) -> dict[str, Any] | None:
    return _synapseiq_post("/lsp/hover", {"file": file, "text": text, "language": language, "line": line, "character": character})


def synapseiq_status() -> dict[str, Any] | None:
    try:
        req = urlrequest.Request(synapseiq_url().rstrip("/") + "/health", method="GET")
        with urlrequest.urlopen(req, timeout=2) as resp:
            return json.loads(resp.read().decode("utf-8", errors="replace"))
    except (urlerror.URLError, OSError, TimeoutError, json.JSONDecodeError):
        return None


def ensure_synapseiq() -> bool:
    """Start SynapseIQ if not reachable. Returns True if now reachable."""
    import subprocess
    import time
    if synapseiq_status() is not None:
        return True
    launcher = Path(__file__).with_name("turtle-synapseiq")
    if not launcher.exists():
        # Try PATH
        import shutil
        found = shutil.which("turtle-synapseiq")
        if found:
            launcher = Path(found)
        else:
            return False
    try:
        subprocess.Popen(
            [sys.executable, str(launcher), "start"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        for _ in range(8):
            time.sleep(0.35)
            if synapseiq_status() is not None:
                return True
    except (OSError, subprocess.SubprocessError):
        pass
    return False


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def read_file(path: Path) -> str:
    if not path.exists():
        raise SystemExit(f"file not found: {path}")
    return path.read_text(encoding="utf-8", errors="replace")


def response(kind: str, data: dict[str, Any]) -> dict[str, Any]:
    return {"schema": SCHEMA, "kind": kind, "data": data}


def language_for(path: Path) -> str:
    suffix = path.suffix.lower()
    return {
        ".py": "python",
        ".lua": "lua",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".rs": "rust",
        ".go": "go",
        ".sh": "shell",
        ".bash": "shell",
        ".zsh": "shell",
        ".md": "markdown",
        ".json": "json",
        ".yaml": "yaml",
        ".yml": "yaml",
    }.get(suffix, suffix[1:] if suffix else "text")


def python_symbols(path: Path, text: str) -> list[dict[str, Any]]:
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return []
    symbols: list[dict[str, Any]] = []
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            symbols.append({"name": node.name, "kind": type(node).__name__, "line": node.lineno, "file": str(path)})
    return sorted(symbols, key=lambda item: item["line"])


def generic_symbols(path: Path, text: str) -> list[dict[str, Any]]:
    symbols: list[dict[str, Any]] = []
    for idx, line in enumerate(text.splitlines(), start=1):
        stripped = line.strip()
        if stripped.startswith(("def ", "class ", "function ", "fn ", "func ", "export function ")):
            symbols.append({"name": stripped.split("(")[0][:120], "kind": "heuristic", "line": idx, "file": str(path)})
    return symbols


def diagnostics(path: Path) -> dict[str, Any]:
    text = read_file(path)
    lang = language_for(path)
    sha = sha256_text(text)
    base = {"file": str(path), "language": lang, "content_sha256": sha, "mutationAllowed": False}

    # Prefer SynapseIQ LSP when available — auto-start if not running.
    ensure_synapseiq()
    synapse = synapseiq_diagnostics(str(path), text, lang)
    if synapse is not None:
        base["source"] = "synapseiq-lsp"
        base["synapseiq_url"] = synapseiq_url()
        base["diagnostics"] = synapse.get("diagnostics", [])
        return base

    # Built-in fallback: Python AST parse only.
    items: list[dict[str, Any]] = []
    if lang == "python":
        try:
            ast.parse(text)
        except SyntaxError as exc:
            items.append({"severity": "error", "message": exc.msg, "line": exc.lineno, "column": exc.offset})
    base["source"] = "builtin-heuristic"
    base["diagnostics"] = items
    return base


def symbols(path: Path) -> dict[str, Any]:
    text = read_file(path)
    lang = language_for(path)
    sha = sha256_text(text)
    base = {"file": str(path), "language": lang, "content_sha256": sha, "mutationAllowed": False}

    # The local AST walk is complete (classes AND their methods); the SynapseIQ
    # LSP may only surface top-level symbols. Compute local first, then let the
    # LSP enrich it — never drop a symbol the local pass found.
    local = python_symbols(path, text) if lang == "python" else generic_symbols(path, text)

    ensure_synapseiq()
    synapse = synapseiq_symbols(str(path), text, lang)
    if synapse is not None:
        base["source"] = "synapseiq-lsp"
        base["synapseiq_url"] = synapseiq_url()
        symbols = list(synapse.get("symbols", []))
        seen = {s.get("name") for s in symbols}
        symbols.extend(s for s in local if s.get("name") not in seen)
        base["symbols"] = sorted(symbols, key=lambda item: item.get("line", 0))
        return base

    base["source"] = "builtin-heuristic"
    base["symbols"] = local
    return base


def explain_selection(path: Path, start: int, end: int) -> dict[str, Any]:
    text = read_file(path)
    lines = text.splitlines()
    start = max(1, start)
    end = min(len(lines), max(start, end))
    selected = "\n".join(lines[start - 1:end])
    return {
        "file": str(path),
        "language": language_for(path),
        "range": {"start": start, "end": end},
        "selection_sha256": sha256_text(selected),
        "selection_preview": selected[:4000],
        "explanation": "Read-only explanation scaffold. Route this packet to Superconscious or an approved model for explanation.",
        "mutationAllowed": False,
    }


def propose_patch(path: Path, prompt: str) -> dict[str, Any]:
    text = read_file(path)
    return {
        "file": str(path),
        "language": language_for(path),
        "content_sha256": sha256_text(text),
        "prompt": prompt,
        "proposal": {
            "status": "deferred",
            "reason": "Patch proposal requires approved model route and review. turtle-language v0 does not mutate files.",
        },
        "mutationAllowed": False,
    }


def index_root(root: Path) -> dict[str, Any]:
    files: list[dict[str, Any]] = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and ".git" not in path.parts:
            try:
                rel = path.relative_to(root)
            except ValueError:
                rel = path
            files.append({"path": str(rel), "language": language_for(path), "size": path.stat().st_size})
            if len(files) >= 500:
                break
    return {"root": str(root), "files": files, "truncated": len(files) >= 500, "mutationAllowed": False}


def print_json(payload: dict[str, Any]) -> int:
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="TurtleTerm language-intelligence CLI v0")
    sub = parser.add_subparsers(dest="command")

    diagnostics_p = sub.add_parser("diagnostics")
    diagnostics_p.add_argument("file")

    symbols_p = sub.add_parser("symbols")
    symbols_p.add_argument("file")

    explain_p = sub.add_parser("explain-selection")
    explain_p.add_argument("file")
    explain_p.add_argument("--start", type=int, required=True)
    explain_p.add_argument("--end", type=int, required=True)

    patch_p = sub.add_parser("propose-patch")
    patch_p.add_argument("file")
    patch_p.add_argument("--prompt", required=True)

    index_p = sub.add_parser("index")
    index_p.add_argument("root", nargs="?", default=os.getcwd())

    hover_p = sub.add_parser("hover", help="hover info at a position (routes to SynapseIQ LSP)")
    hover_p.add_argument("file")
    hover_p.add_argument("--line", type=int, required=True)
    hover_p.add_argument("--character", type=int, default=0)

    sub.add_parser("synapseiq-status", help="check SynapseIQ LSP reachability")

    code_actions_p = sub.add_parser("code-actions", help="get code actions (quick-fix, refactor) for a file")
    code_actions_p.add_argument("file", help="file to analyze")
    code_actions_p.add_argument("--line", type=int, default=0, help="cursor line")
    code_actions_p.add_argument("--col", type=int, default=0, help="cursor column")

    workspace_symbols_p = sub.add_parser("workspace-symbols", help="search workspace symbols across project")
    workspace_symbols_p.add_argument("query", nargs="?", default="", help="symbol name filter")
    workspace_symbols_p.add_argument("--cwd", default=".", help="project root")

    document_symbols_p = sub.add_parser("document-symbols", help="list all symbols in a file")
    document_symbols_p.add_argument("file", help="file to outline")

    rename_p = sub.add_parser("rename", help="rename a symbol across the file")
    rename_p.add_argument("file", help="file to edit")
    rename_p.add_argument("--line", type=int, default=0)
    rename_p.add_argument("--col", type=int, default=0)
    rename_p.add_argument("--new-name", required=True, help="new symbol name")

    workspace_diagnostics_p = sub.add_parser("workspace-diagnostics", help="run diagnostics on all git-changed files")
    workspace_diagnostics_p.add_argument("--cwd", default=".", help="project root")

    args = parser.parse_args(argv)
    if args.command == "diagnostics":
        return print_json(response("diagnostics", diagnostics(Path(args.file))))
    if args.command == "symbols":
        return print_json(response("symbols", symbols(Path(args.file))))
    if args.command == "explain-selection":
        return print_json(response("explanation", explain_selection(Path(args.file), args.start, args.end)))
    if args.command == "propose-patch":
        return print_json(response("patch_proposal", propose_patch(Path(args.file), args.prompt)))
    if args.command == "index":
        return print_json(response("index", index_root(Path(args.root))))
    if args.command == "hover":
        path = Path(args.file)
        text = read_file(path)
        lang = language_for(path)
        synapse = synapseiq_hover(str(path), text, lang, args.line, args.character)
        data = {"file": str(path), "language": lang, "line": args.line, "character": args.character, "mutationAllowed": False}
        if synapse is not None:
            data["source"] = "synapseiq-lsp"
            data["hover"] = synapse
        else:
            data["source"] = "unavailable"
            data["hover"] = None
            data["note"] = f"SynapseIQ LSP not reachable at {synapseiq_url()}"
        return print_json(response("hover", data))
    if args.command == "synapseiq-status":
        status = synapseiq_status()
        return print_json(response("synapseiq_status", {
            "url": synapseiq_url(),
            "reachable": status is not None,
            "status": status,
        }))
    if args.command == "code-actions":
        file_path = Path(args.file).resolve()
        text = file_path.read_text(errors="replace") if file_path.exists() else ""
        r = _synapseiq_post("/lsp/code-actions", {
            "text": text,
            "filename": str(file_path),
            "range": {"start": {"line": args.line, "character": args.col}, "end": {"line": args.line, "character": args.col}},
            "diagnostics": [],
        }) or {}
        actions = r.get("code_actions", [])
        if not actions:
            print("No code actions available.")
        else:
            for i, a in enumerate(actions, 1):
                print(f"{i}. [{a.get('kind','?')}] {a.get('title','')}")
        return 0
    if args.command == "workspace-symbols":
        cwd = str(Path(args.cwd).resolve())
        r = _synapseiq_post("/lsp/workspace-symbols", {"query": args.query, "cwd": cwd}) or {}
        symbols_list = r.get("symbols", [])
        if not symbols_list:
            print(f"No symbols matching '{args.query}'")
        else:
            for s in symbols_list:
                loc = s.get("location", {})
                uri = loc.get("uri", "").replace("file://", "")
                ln  = loc.get("range", {}).get("start", {}).get("line", 0)
                kind_map = {5: "class", 12: "function", 13: "variable", 14: "constant"}
                kind = kind_map.get(s.get("kind", 0), "symbol")
                print(f"  {s['name']:30} {kind:10} {uri}:{ln+1}")
        return 0
    if args.command == "document-symbols":
        file_path = Path(args.file).resolve()
        text = file_path.read_text(errors="replace") if file_path.exists() else ""
        r = _synapseiq_post("/lsp/workspace-symbols", {"query": "", "cwd": str(file_path.parent)}) or {}
        # Fallback: parse file directly for symbols
        doc_symbols = []
        import re as _re_ds
        for i, line in enumerate(text.splitlines()):
            m = _re_ds.match(r'^(?:export\s+)?(?:async\s+)?(?:function|class|const|let|var|def|pub fn|fn|type|interface|enum)\s+([A-Za-z_$][A-Za-z0-9_$<>]*)', line)
            if m:
                doc_symbols.append({"name": m.group(1), "line": i + 1, "text": line.strip()[:60]})
        if not doc_symbols:
            print("No symbols found.")
        else:
            for s in doc_symbols:
                print(f"  L{s['line']:4}  {s['name']:30}  {s['text']}")
        return 0
    if args.command == "rename":
        file_path = Path(args.file).resolve()
        text = file_path.read_text(errors="replace") if file_path.exists() else ""
        r = _synapseiq_post("/lsp/rename", {
            "text": text,
            "filename": str(file_path),
            "line": args.line,
            "character": args.col,
            "new_name": args.new_name,
        }) or {}
        changes = r.get("changes", {})
        edits = changes.get(str(file_path), changes.get(f"file://{file_path}", []))
        if not edits:
            print(f"Nothing to rename at line {args.line}:{args.col}")
        else:
            print(f"Would rename {len(edits)} occurrence(s) to '{args.new_name}'. Apply? [y/N] ", end="")
            if input().strip().lower() == "y":
                lines = text.splitlines(keepends=True)
                for edit in sorted(edits, key=lambda e: (e["range"]["start"]["line"], e["range"]["start"]["character"]), reverse=True):
                    l = edit["range"]["start"]["line"]
                    cs = edit["range"]["start"]["character"]
                    ce = edit["range"]["end"]["character"]
                    if l < len(lines):
                        lines[l] = lines[l][:cs] + args.new_name + lines[l][ce:]
                file_path.write_text("".join(lines))
                print(f"Renamed in {args.file}")
        return 0
    if args.command == "workspace-diagnostics":
        cwd = str(Path(args.cwd).resolve())
        r = _synapseiq_post("/lsp/workspace-diagnostics", {"cwd": cwd, "files": []}) or {}
        diags = r.get("diagnostics", {})
        checked = r.get("files_checked", 0)
        if not diags:
            print(f"No issues found across {checked} file(s).")
        else:
            for fname, issues in diags.items():
                print(f"\n{fname}:")
                for d in issues:
                    ln = d.get("range", {}).get("start", {}).get("line", 0)
                    print(f"  L{ln+1}: {d.get('message','?')}")
        return 0
    parser.print_help(sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
