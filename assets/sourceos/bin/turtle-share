#!/usr/bin/env python3
"""turtle-share — Pair on a live terminal. Self-hosted. No cloud. No account.

Wraps WezTerm's built-in multiplexer (wezterm-mux-server) so two or more shells
can attach to ONE live session and see + type in the same panes — the way Warp's
live shared sessions work, but with zero cloud, zero login. A named unix-domain
socket is the rendezvous point; remote collaborators tunnel it over SSH.

Modes:
  local  (default)  Same machine. Another local shell runs `turtle-share join`.
  ssh               Remote collaborator forwards the socket over SSH, then joins.
  tls               Opt-in network listener (requires YOUR OWN certs). Not default.

Usage:
  turtle-share start [--name NAME] [--mode local|ssh|tls] [--addr HOST:PORT]
                                        Start (or reuse) a shared session
  turtle-share join <name|addr>         Attach this terminal to a shared session
  turtle-share list [--json]            List active shared sessions
  turtle-share stop [NAME]              Stop sharing + clean up the socket

Security:
  Anyone who can reach the socket can SEE and TYPE in your session. The default
  (local/ssh) keeps it to a unix socket on your box — no network port is opened
  unless you explicitly pass --mode tls with your own certificates.

Examples:
  turtle-share start                    Share the current session (local pair)
  turtle-share start --name demo --mode ssh
  turtle-share join demo
  turtle-share list --json
  turtle-share stop demo
"""
from __future__ import annotations
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent

# ---------------------------------------------------------------------------
# State / paths
# ---------------------------------------------------------------------------
STATE_DIR = Path(
    os.environ.get("TURTLE_SHARE_STATE")
    or (Path.home() / ".local" / "state" / "turtleterm" / "share")
)


def _state_dir() -> Path:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    return STATE_DIR


def _sock_path(name: str) -> Path:
    return _state_dir() / f"{name}.sock"


def _pid_path(name: str) -> Path:
    return _state_dir() / f"{name}.pid"


def _cfg_path(name: str) -> Path:
    return _state_dir() / f"{name}.lua"


def _safe_name(name: str) -> str:
    name = re.sub(r"[^A-Za-z0-9_.-]", "-", name.strip())
    return name or "share"


def _default_name() -> str:
    sid = os.environ.get("SOURCEOS_TERMINAL_SESSION_ID", "").strip()
    if sid:
        return _safe_name(f"sess-{sid}")[:48]
    return _safe_name(f"share-{os.getpid()}")


# ---------------------------------------------------------------------------
# Binary resolution — mirror the turtleterm / turtleterm-mux-server wrappers.
# ---------------------------------------------------------------------------
def _find_binary(stem: str) -> str | None:
    """Locate a wezterm* binary using the same search order as the wrappers."""
    candidates: list[Path] = []
    runtime = os.environ.get("TURTLE_TERM_RUNTIME_DIR")
    if runtime:
        candidates.append(Path(runtime) / stem)
    parent = BIN_DIR.parent
    candidates += [
        parent / "libexec" / "turtle-term" / stem,
        parent / "opt" / "turtle-term" / "libexec" / "turtle-term" / stem,
        parent / "Cellar" / "turtle-term" / "HEAD" / "libexec" / "turtle-term" / stem,
    ]
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)
    found = shutil.which(stem)
    if found:
        return found
    return None


def _mux_server_bin() -> str | None:
    return _find_binary("wezterm-mux-server")


def _wezterm_bin() -> str | None:
    # The `wezterm` CLI drives `connect` and `cli list-clients`.
    return _find_binary("wezterm")


def _die_no_mux() -> int:
    print(
        "ERROR: wezterm-mux-server not found.\n"
        "  TurtleTerm's multiplexer binary ships in libexec/turtle-term/ or on PATH.\n"
        "  Set TURTLE_TERM_RUNTIME_DIR to the directory containing it, or install\n"
        "  TurtleTerm so the bundled wezterm binaries are available.",
        file=sys.stderr,
    )
    return 1


# ---------------------------------------------------------------------------
# Config generation — a standalone --config-file that defines ONE unix_domain.
# This avoids requiring the user to pre-edit turtleterm.lua.
# ---------------------------------------------------------------------------
def _write_domain_config(name: str, sock: Path) -> Path:
    """Write a minimal wezterm config defining a single named unix domain."""
    lua = (
        "-- Auto-generated by turtle-share. Defines one shared unix domain.\n"
        "local wezterm = require 'wezterm'\n"
        "local config = wezterm.config_builder and wezterm.config_builder() or {}\n"
        "config.unix_domains = {\n"
        "  {\n"
        f"    name = {_lua_str(name)},\n"
        f"    socket_path = {_lua_str(str(sock))},\n"
        "    -- We start the server explicitly; do not auto-spawn another.\n"
        "    no_serve_automatically = true,\n"
        "  },\n"
        "}\n"
        "return config\n"
    )
    cfg = _cfg_path(name)
    cfg.write_text(lua)
    return cfg


def _lua_str(s: str) -> str:
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"


# ---------------------------------------------------------------------------
# Liveness helpers
# ---------------------------------------------------------------------------
def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _read_pid(name: str) -> int | None:
    p = _pid_path(name)
    if not p.exists():
        return None
    try:
        return int(p.read_text().strip())
    except (ValueError, OSError):
        return None


def _socket_live(sock: Path) -> bool:
    if not sock.exists():
        return False
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(0.5)
        s.connect(str(sock))
        return True
    except OSError:
        return False
    finally:
        s.close()


def _session_active(name: str) -> bool:
    pid = _read_pid(name)
    if pid is not None and _pid_alive(pid):
        return True
    return _socket_live(_sock_path(name))


def _client_count(name: str) -> int | None:
    """Best-effort attached-client count via `wezterm cli list-clients`."""
    wez = _wezterm_bin()
    if not wez:
        return None
    cfg = _cfg_path(name)
    cmd = [wez]
    if cfg.exists():
        cmd += ["--config-file", str(cfg)]
    cmd += ["cli", "list-clients", "--format", "json"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        if r.returncode != 0 or not r.stdout.strip():
            return None
        data = json.loads(r.stdout)
        if isinstance(data, list):
            return len(data)
    except Exception:
        return None
    return None


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------
def cmd_start(argv: list[str]) -> int:
    name = ""
    mode = "local"
    addr = ""
    as_json = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--name":
            i += 1
            name = argv[i] if i < len(argv) else ""
        elif a == "--mode":
            i += 1
            mode = (argv[i] if i < len(argv) else "").lower()
        elif a == "--addr":
            i += 1
            addr = argv[i] if i < len(argv) else ""
        elif a == "--json":
            as_json = True
        else:
            print(f"Unknown option: {a}", file=sys.stderr)
            return 2
        i += 1

    name = _safe_name(name) if name else _default_name()
    if mode not in ("local", "ssh", "tls"):
        print(f"Invalid --mode: {mode} (local|ssh|tls)", file=sys.stderr)
        return 2

    sock = _sock_path(name)

    # Reuse an already-running session with this name.
    reused = _session_active(name)
    if not reused:
        rc = _spawn_mux(name, sock, mode, addr)
        if rc != 0:
            return rc

    out: dict = {
        "name": name,
        "mode": mode,
        "socket": str(sock),
        "reused": reused,
    }
    if mode == "tls" and addr:
        out["addr"] = addr

    if as_json:
        print(json.dumps(out, indent=2))
        return 0

    _print_start_banner(name, sock, mode, addr, reused)
    return 0


def _spawn_mux(name: str, sock: Path, mode: str, addr: str) -> int:
    mux = _mux_server_bin()
    if not mux:
        return _die_no_mux()

    if mode == "tls":
        if not addr:
            print(
                "ERROR: --mode tls requires --addr HOST:PORT and your own TLS certs.\n"
                "  This opens a NETWORK listener. Generate certs and define a\n"
                "  tls_servers entry; turtle-share will not open a raw port for you.",
                file=sys.stderr,
            )
            return 2
        print(
            "WARNING: --mode tls opens a network listener at %s.\n"
            "  You must supply your own TLS certificates (see wezterm tls_servers).\n"
            "  Prefer --mode ssh for remote collaborators (no open port)." % addr,
            file=sys.stderr,
        )

    cfg = _write_domain_config(name, sock)

    # Stale socket cleanup before binding.
    if sock.exists() and not _socket_live(sock):
        try:
            sock.unlink()
        except OSError:
            pass

    log_path = _state_dir() / f"{name}.log"
    cmd = [mux, "--config-file", str(cfg), "--daemonize"]
    try:
        log = open(log_path, "ab")
    except OSError:
        log = subprocess.DEVNULL
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=log,
            stderr=log,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as e:
        print(f"ERROR: failed to start wezterm-mux-server: {e}", file=sys.stderr)
        return 1

    _pid_path(name).write_text(str(proc.pid))
    return 0


def _print_start_banner(name: str, sock: Path, mode: str, addr: str, reused: bool) -> None:
    verb = "Reusing" if reused else "Started"
    print(f"{verb} shared session '{name}' (mode: {mode})")
    print(f"  socket: {sock}")
    print()
    print("  ⚠  Anyone who can reach this socket can SEE and TYPE in your")
    print("     session. Only share with people you trust.")
    print()
    if mode == "local":
        print("  Pair locally — another shell on THIS machine runs:")
        print(f"      turtle-share join {name}")
    elif mode == "ssh":
        user = os.environ.get("USER", "you")
        host = socket.gethostname()
        print("  Pair remotely — your collaborator forwards the socket over SSH:")
        print(f"      ssh -N -L {sock}:{sock} {user}@{host}")
        print("  …then, in another shell on their machine:")
        print(f"      turtle-share join {name}")
        print()
        print("  (The SSH tunnel keeps it secure: no network port is opened.)")
    elif mode == "tls":
        print("  TLS mode — collaborators connect to your listener:")
        print(f"      turtle-share join {addr}")
        print("  Requires your own certs configured via wezterm tls_servers/tls_clients.")
    print()
    print(f"  Stop sharing:  turtle-share stop {name}")


def cmd_join(argv: list[str]) -> int:
    target = ""
    for a in argv:
        if not a.startswith("-"):
            target = a
            break
    if not target:
        print("Usage: turtle-share join <name|addr>", file=sys.stderr)
        return 2

    wez = _wezterm_bin()
    if not wez:
        print(
            "ERROR: wezterm CLI not found (needed to attach).\n"
            "  Install TurtleTerm or set TURTLE_TERM_RUNTIME_DIR.",
            file=sys.stderr,
        )
        return 1

    name = _safe_name(target)
    cfg = _cfg_path(name)
    cmd = [wez]

    if cfg.exists():
        # Local / SSH-forwarded named unix domain we know about.
        cmd += ["--config-file", str(cfg), "connect", name]
    else:
        # Unknown to us locally: assume it's a domain name or addr the user's
        # own wezterm config knows. Attach directly.
        cmd += ["connect", target]

    print(f"Attaching to shared session '{target}' …")
    print("  (Ctrl-Shift-D or close the window to detach; the session stays alive.)")
    try:
        os.execv(cmd[0], cmd)
    except OSError as e:
        print(f"ERROR: failed to attach: {e}", file=sys.stderr)
        return 1
    return 0  # unreachable


def cmd_list(argv: list[str]) -> int:
    as_json = "--json" in argv
    sessions = []
    if STATE_DIR.exists():
        for cfg in sorted(STATE_DIR.glob("*.lua")):
            name = cfg.stem
            sock = _sock_path(name)
            active = _session_active(name)
            entry = {
                "name": name,
                "socket": str(sock),
                "active": active,
                "pid": _read_pid(name),
                "clients": _client_count(name) if active else 0,
            }
            sessions.append(entry)

    if as_json:
        print(json.dumps(sessions, indent=2))
        return 0

    if not sessions:
        print("No shared sessions.")
        print("  Start one with:  turtle-share start")
        return 0

    print("Active shared sessions:")
    for s in sessions:
        state = "live" if s["active"] else "dead"
        clients = s["clients"]
        ctxt = f"{clients} client(s)" if clients is not None else "clients: ?"
        mark = "●" if s["active"] else "○"
        print(f"  {mark}  {s['name']:<24} [{state}]  {ctxt}")
        print(f"        {s['socket']}")
    return 0


def cmd_stop(argv: list[str]) -> int:
    name = ""
    for a in argv:
        if not a.startswith("-"):
            name = a
            break
    if not name:
        # Default to the current session's name.
        name = _default_name()
    name = _safe_name(name)

    pid = _read_pid(name)
    killed = False
    if pid is not None and _pid_alive(pid):
        try:
            os.kill(pid, signal.SIGTERM)
            killed = True
        except OSError as e:
            print(f"WARNING: could not signal pid {pid}: {e}", file=sys.stderr)

    # Clean up artifacts.
    for p in (_sock_path(name), _pid_path(name), _cfg_path(name)):
        try:
            if p.exists():
                p.unlink()
        except OSError:
            pass

    if killed:
        print(f"Stopped shared session '{name}'.")
    else:
        print(f"No live mux-server for '{name}' — cleaned up any stale socket.")
    return 0


# ---------------------------------------------------------------------------
def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if args[0] in ("--version", "-V"):
        print("turtle-share 0.1.0")
        return 0

    cmd, rest = args[0], args[1:]
    if cmd == "start":
        return cmd_start(rest)
    if cmd == "join":
        return cmd_join(rest)
    if cmd == "list":
        return cmd_list(rest)
    if cmd == "stop":
        return cmd_stop(rest)

    print(f"Unknown command: {cmd}\nRun 'turtle-share --help'.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
