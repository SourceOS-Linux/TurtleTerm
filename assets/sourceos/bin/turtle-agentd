    if action in ("ssh_profiles", "ssh-profiles"):
        import re as _re_ssh
        ssh_config = Path.home() / ".ssh" / "config"
        profiles = []
        if ssh_config.exists():
            current: dict[str, Any] = {}
            for line in ssh_config.read_text(errors="replace").splitlines():
                line = line.strip()
                if line.lower().startswith("host ") and not line.startswith("#"):
                    if current.get("host"):
                        profiles.append(current)
                    host = line[5:].strip()
                    if "*" not in host:  # skip wildcards
                        current = {"host": host}
                elif current and "=" not in line and line:
                    m = _re_ssh.match(r'(\w+)\s+(.*)', line, _re_ssh.IGNORECASE)
                    if m:
                        current[m.group(1).lower()] = m.group(2).strip()
            if current.get("host"):
                profiles.append(current)
        # Also check ~/.config/turtleterm/ssh_profiles.json for user-saved profiles
        extra_profiles_file = Path.home() / ".config" / "turtleterm" / "ssh_profiles.json"
        if extra_profiles_file.exists():
            try:
                extra = json.loads(extra_profiles_file.read_text())
                profiles.extend(extra)
            except (json.JSONDecodeError, OSError):
                pass
        return response("ssh_profiles", {"profiles": profiles, "count": len(profiles)})

    if action in ("ssh_connect", "ssh-connect"):
        host = request.get("host", "").strip()
        user = request.get("user", "").strip()
        port = request.get("port", "22")
        identity = request.get("identity", "").strip()
        if not host:
            return response("error", {"message": "host required"}, status="error")
        # Build SSH command
        parts = ["ssh"]
        if user:
