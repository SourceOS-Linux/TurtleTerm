#!/usr/bin/env python3
"""TurtleTerm local agent gateway v0.

Conservative local JSON gateway for TurtleTerm. Supports:
- stdio (one request / one response)
- Unix socket daemon mode
- Shell-hook event ingestion + receipt writing
- Git enrichment and execution domain detection
- Secret redaction in receipts
- Noetica cognition loop wire (POST /api/chat)
- Policy Fabric evaluation (POST /v1/operations/action-decision)
- SynapseIQ LSP status check
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
import uuid
from pathlib import Path
from typing import Any
from urllib import error as urlerror
from urllib import request as urlrequest


SCHEMA = "sourceos.turtle.agentd.response.v0"

# Patterns that should never appear in receipts or logs.
_SECRET_PATTERNS: list[re.Pattern[str]] = [
    re.compile(r"(sk-ant-[A-Za-z0-9\-_]{20,})", re.IGNORECASE),
    re.compile(r"(sk-[A-Za-z0-9]{20,})", re.IGNORECASE),
    re.compile(r"(ghp_[A-Za-z0-9]{36,})", re.IGNORECASE),
    re.compile(r"(ghs_[A-Za-z0-9]{36,})", re.IGNORECASE),
    re.compile(r"(AKIA[0-9A-Z]{16})", re.IGNORECASE),
    re.compile(r"(-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----.*?-----END[^-]*-----)", re.DOTALL),
    re.compile(r'(?:password|passwd|secret|token|api[_-]?key)\s*[=:]\s*(["\']?)([^\s"\']{8,})\1', re.IGNORECASE),
]


# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def env(name: str, fallback: str = "") -> str:
    value = os.environ.get(name)
    return value if value else fallback


def runtime_dir() -> Path:
    return Path(env("XDG_RUNTIME_DIR", f"/tmp/sourceos-runtime-{os.getuid()}")) / "sourceos" / "turtle-term"


def default_socket_path() -> Path:
    return Path(env("TURTLE_AGENTD_SOCKET", str(runtime_dir() / "agentd.sock")))


def event_stream_path() -> Path:
    return Path(env("SOURCEOS_TERMINAL_EVENTS", str(runtime_dir().parent / "terminal" / "events.ndjson")))


def plan_events_path() -> Path:
    return Path.home() / ".local" / "state" / "sourceos" / "terminal" / "plan-events.ndjson"


def _emit_plan_event(event_type: str, **kwargs: Any) -> None:
    """Append a plan lifecycle event to plan-events.ndjson for real-time view."""
    path = plan_events_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    event = {"type": event_type, "ts": utc_now(), **kwargs}
    try:
        with path.open("a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError:
        pass


def receipts_root() -> Path:
    return Path(env("SOURCEOS_TERMINAL_RECEIPTS", str(Path.home() / ".local" / "state" / "sourceos" / "terminal" / "receipts")))


def read_ndjson(path: Path, limit: int = 100) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    rows: list[dict[str, Any]] = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]:
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return rows


def redact_secrets(text: str) -> str:
    """Replace known secret patterns with [REDACTED]."""
    for pattern in _SECRET_PATTERNS:
        text = pattern.sub("[REDACTED]", text)
    return text


def compute_sha256(data: str | bytes) -> str:
    if isinstance(data, str):
        data = data.encode("utf-8", errors="replace")
    return "sha256:" + hashlib.sha256(data).hexdigest()


def git_info(cwd: str | None = None) -> dict[str, str | None]:
    """Return {repo_root, git_branch} for cwd, or nulls if not a git repo."""
    kwargs: dict[str, Any] = {
        "text": True,
        "stdout": subprocess.PIPE,
        "stderr": subprocess.DEVNULL,
        "timeout": 3,
    }
    if cwd:
        kwargs["cwd"] = cwd
    try:
        root = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=False,
            **kwargs,
        ).stdout.strip() or None
        branch = subprocess.run(
            ["git", "branch", "--show-current"],
            check=False,
            **kwargs,
        ).stdout.strip() or None
        return {"repo_root": root, "git_branch": branch}
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return {"repo_root": None, "git_branch": None}


def detect_execution_domain() -> str:
    """Infer execution domain from environment and filesystem markers."""
    explicit = os.environ.get("SOURCEOS_EXECUTION_DOMAIN")
    if explicit:
        return explicit
    if os.environ.get("DISTROBOX_HOST_HOME"):
        return "distrobox"
    if os.environ.get("TOOLBOX_PATH"):
        return "toolbox"
    if os.environ.get("SSH_CLIENT") or os.environ.get("SSH_TTY"):
        return "ssh"
    if Path("/.dockerenv").exists():
        return "container"
    if os.environ.get("CONTAINER_ID") or os.environ.get("container"):
        return "container"
    if Path("/run/secrets/kubernetes.io").exists():
        return "container"
    return "host"


# ---------------------------------------------------------------------------
# Event stream + receipt writers
# ---------------------------------------------------------------------------

def append_event(event: dict[str, Any]) -> None:
    """Append a single event to the NDJSON event stream."""
    path = event_stream_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(event, sort_keys=True) + "\n")


def write_receipt(event: dict[str, Any]) -> str:
    """Write a command receipt JSON file. Returns the receipt path."""
    session_id = event.get("session_id", "unknown")
    event_id = event.get("event_id", f"evt_{uuid.uuid4().hex}")
    root = receipts_root() / session_id
    root.mkdir(parents=True, exist_ok=True)
    receipt_path = root / f"{event_id}.json"

    receipt = {
        "schema": "sourceos.terminal.receipt.v0",
        "receipt_id": f"receipt_{uuid.uuid4().hex}",
        "session_id": session_id,
        "workspace_id": event.get("workspace_id", env("SOURCEOS_WORKSPACE", "default")),
        "event_id": event_id,
        "actor_id": event.get("actor_id", "human:local-user"),
        "requested_by": event.get("actor_id", "human:local-user"),
        "approved_by": "policy:auto-local",
        "policy_bundle_id": event.get("policy_bundle_id", "unbound"),
        "execution_domain": event.get("execution_domain", detect_execution_domain()),
        "cwd": event.get("cwd", os.getcwd()),
        "repo_root": event.get("repo_root"),
        "git_branch": event.get("git_branch"),
        "host": event.get("host", os.uname().nodename),
        "user": event.get("user", os.environ.get("USER", "unknown")),
        "container_id": event.get("container_id"),
        "command": redact_secrets(event.get("command", "")),
        "command_argv": event.get("command_argv"),
        "exit_status": event.get("exit_status"),
        "started_at": event.get("started_at"),
        "completed_at": event.get("completed_at"),
        "stdout_digest": event.get("stdout_digest", "sha256:uncaptured"),
        "stderr_digest": event.get("stderr_digest", "sha256:uncaptured"),
        "policy_decision_id": event.get("policy_decision_id"),
        "artifacts": event.get("artifact_paths", []),
        "replay": {
            "kind": "terminal-event-pointer",
            "uri": f"sourceos-terminal://{session_id}/events/{event_id}",
        },
    }

    receipt_path.write_text(json.dumps(receipt, indent=2, sort_keys=True), encoding="utf-8")
    return str(receipt_path)


# ---------------------------------------------------------------------------
# Noetica wire
# ---------------------------------------------------------------------------

def noetica_url() -> str:
    return env("SOURCEOS_NOETICA_URL", "http://localhost:8080")


def _noetica_request(method: str, path: str, payload: dict[str, Any] | None = None, timeout: int = 3) -> dict[str, Any] | None:
    url = noetica_url().rstrip("/") + path
    try:
        body = json.dumps(payload).encode("utf-8") if payload is not None else None
        req = urlrequest.Request(
            url,
            data=body,
            method=method,
            headers={"Content-Type": "application/json", "Accept": "application/json"},
        )
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return {"raw": raw[:500]}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def noetica_post(path: str, payload: dict[str, Any], timeout: int = 3) -> dict[str, Any] | None:
    return _noetica_request("POST", path, payload, timeout=timeout)


def noetica_get(path: str, timeout: int = 3) -> dict[str, Any] | None:
    return _noetica_request("GET", path, timeout=timeout)


# ---------------------------------------------------------------------------
# Local policy rule engine
# ---------------------------------------------------------------------------

_LOCAL_POLICY_RULES: list[dict[str, str]] = [
    {"pattern": r"rm\s+-rf\s+/\s*$", "decision": "deny", "reason": "Recursive deletion of filesystem root is destructive."},
    {"pattern": r"rm\s+-rf\s+/\b", "decision": "deny", "reason": "Recursive deletion from root path is destructive."},
    {"pattern": r"rm\s+-rf\s+~\s*$", "decision": "deny", "reason": "Recursive deletion of home directory is destructive."},
    {"pattern": r"rm\s+-rf\s+~/", "decision": "deny", "reason": "Recursive deletion within home directory requires review."},
    {"pattern": r"git\s+push\s+--force", "decision": "warn", "reason": "Force push rewrites remote history."},
    {"pattern": r"curl\b.*\|\s*sh", "decision": "deny", "reason": "Piping curl to shell executes untrusted remote code."},
    {"pattern": r"curl\b.*\|\s*bash", "decision": "deny", "reason": "Piping curl to bash executes untrusted remote code."},
    {"pattern": r"sudo\s+rm\s+-rf", "decision": "deny", "reason": "Privileged recursive deletion is destructive."},
    {"pattern": r"kill\s+-9\s+1\b", "decision": "deny", "reason": "Killing PID 1 crashes the system."},
    {"pattern": r"DROP\s+TABLE", "decision": "warn", "reason": "DROP TABLE permanently destroys database table data."},
    {"pattern": r":\(\)\s*\{.*:\|:.*\}", "decision": "deny", "reason": "Fork bomb detected."},
    {"pattern": r"chmod\s+-R\s+777\s+/", "decision": "deny", "reason": "Recursive 777 on root removes all access controls."},
]

_COMPILED_LOCAL_RULES: list[tuple[re.Pattern[str], str, str, str]] = [
    (re.compile(rule["pattern"], re.IGNORECASE | re.DOTALL), rule["decision"], rule["reason"], rule["pattern"])
    for rule in _LOCAL_POLICY_RULES
]


def _local_policy_check(command: str) -> tuple[str, str, str | None]:
    """Check command against local policy rules. Returns (decision, reason, matched_pattern)."""
    warn_hit: tuple[str, str, str] | None = None
    for compiled, decision, reason, pattern in _COMPILED_LOCAL_RULES:
        if compiled.search(command):
            if decision == "deny":
                return "deny", reason, pattern
            if decision == "warn" and warn_hit is None:
                warn_hit = (decision, reason, pattern)
    if warn_hit:
        return warn_hit[0], warn_hit[1], warn_hit[2]
    return "allow", "No local policy rules matched.", None


# ---------------------------------------------------------------------------
# Policy Fabric wire (Track D)
# ---------------------------------------------------------------------------

def policy_fabric_url() -> str:
    return env("SOURCEOS_POLICY_FABRIC_URL", "http://localhost:8081")


def policy_evaluate(
    action_type: str,
    command: str,
    execution_domain: str = "host",
    actor_id: str = "human:local-user",
    risk_level: str | None = None,
) -> dict[str, Any] | None:
    """POST an execution request to Policy Fabric. Returns decision or None if unreachable.
    Short-circuits with a local deny result if the built-in rule engine rejects the command."""
    # Check local rules first — deny short-circuits without hitting Policy Fabric.
    local_decision, local_reason, local_pattern = _local_policy_check(command)
    if local_decision == "deny":
        return {
            "decision": {
                "outcome": "deny",
                "reason": f"[local-policy] {local_reason}",
                "matched_rule": local_pattern,
            },
            "decision_id": None,
            "source": "local-policy",
        }

    if risk_level is None:
        # host is high-risk, isolated domains are lower
        risk_level = "high" if execution_domain == "host" else "medium"

    recommendation = {
        "recommendation_id": f"urn:srcos:turtle:rec:{uuid.uuid4().hex}",
        "action": {"type": action_type, "command": command},
        "risk_level": risk_level,
        "requested_outcome": "allow",
        "subject": {"actor_id": actor_id, "execution_domain": execution_domain},
        "policy_refs": ["policy://sourceos/terminal/v1"],
        "requires_change_window": False,
    }
    result = _noetica_request(
        "POST",
        "/v1/operations/action-decision",
        {"recommendation": recommendation, "mode": env("TURTLE_POLICY_MODE", "report_only")},
        timeout=4,
    )
    # If policy fabric isn't on the Noetica URL, try the dedicated policy URL.
    if result is None:
        try:
            url = policy_fabric_url().rstrip("/") + "/v1/operations/action-decision"
            body = json.dumps({"recommendation": recommendation, "mode": env("TURTLE_POLICY_MODE", "report_only")}).encode()
            req = urlrequest.Request(url, data=body, method="POST",
                                     headers={"Content-Type": "application/json", "Accept": "application/json"})
            with urlrequest.urlopen(req, timeout=4) as resp:
                result = json.loads(resp.read().decode("utf-8", errors="replace"))
        except (urlerror.URLError, OSError, TimeoutError, json.JSONDecodeError):
            return None
    return result


def _policy_outcome_to_decision(pf_result: dict[str, Any] | None, action: str, command: str) -> tuple[str, str, str | None]:
    """Map a Policy Fabric result to (decision, reason, decision_id)."""
    if pf_result is None:
        return "ask", "Policy Fabric unreachable; defaulting to manual review.", None
    outcome = pf_result.get("decision", {}).get("outcome", "manual_review")
    reason = pf_result.get("decision", {}).get("reason", "no reason provided")
    decision_id = pf_result.get("decision_id")
    if outcome == "allow":
        return "allow", reason, decision_id
    if outcome == "deny":
        return "deny", reason, decision_id
    return "ask", reason, decision_id


def agent_machine_url() -> str:
    return env("SOURCEOS_AGENT_MACHINE_URL", "http://localhost:9000")


def bearbrowser_a2a_url() -> str:
    return env("BEARBROWSER_A2A_URL", "http://localhost:3031")


def _http_get(url: str, timeout: int = 3) -> dict[str, Any] | None:
    try:
        req = urlrequest.Request(url, headers={"Accept": "application/json"})
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return {"raw": raw[:500]}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def _http_post(url: str, payload: dict[str, Any], timeout: int = 5) -> dict[str, Any] | None:
    try:
        body = json.dumps(payload).encode("utf-8")
        req = urlrequest.Request(
            url,
            data=body,
            method="POST",
            headers={"Content-Type": "application/json", "Accept": "application/json"},
        )
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return {"raw": raw[:500]}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def noetica_chat(text: str, session_id: str | None = None, context: dict[str, Any] | None = None) -> dict[str, Any] | None:
    """POST a message to Noetica /api/chat in sourceos mode."""
    payload: dict[str, Any] = {
        "mode": "sourceos",
        "session_id": session_id or env("SOURCEOS_TERMINAL_SESSION_ID") or str(uuid.uuid4()),
        "messages": [{"role": "user", "content": text}],
    }
    if context:
        ctx_text = json.dumps(context, sort_keys=True)
        payload["system_prompt"] = f"Terminal context: {ctx_text}"
    return noetica_post("/api/chat", payload, timeout=5)


def _claude_chat(text: str, system: str | None = None, model: str | None = None, timeout: int = 15) -> dict[str, Any] | None:
    """Call Anthropic Messages API directly. Returns None if ANTHROPIC_API_KEY is unset or call fails."""
    api_key = env("ANTHROPIC_API_KEY")
    if not api_key:
        return None
    base = env("ANTHROPIC_API_URL", "https://api.anthropic.com")
    model = model or env("TURTLE_CLAUDE_MODEL", "claude-haiku-4-5-20251001")
    payload: dict[str, Any] = {
        "model": model,
        "max_tokens": 1024,
        "messages": [{"role": "user", "content": text}],
    }
    if system:
        payload["system"] = system
    try:
        body = json.dumps(payload).encode("utf-8")
        req = urlrequest.Request(
            base.rstrip("/") + "/v1/messages",
            data=body,
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Accept": "application/json",
                "x-api-key": api_key,
                "anthropic-version": "2023-06-01",
            },
        )
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                data = json.loads(raw)
                blocks = [b.get("text", "") for b in data.get("content", []) if b.get("type") == "text"]
                return {"response": "\n".join(blocks), "model": data.get("model"), "source": "claude"}
            except json.JSONDecodeError:
                return {"raw": raw[:500], "source": "claude"}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def smart_chat(
    text: str,
    system: str | None = None,
    session_id: str | None = None,
    context: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    """Claude API when ANTHROPIC_API_KEY is set, else Noetica, else None."""
    result = _claude_chat(text, system=system)
    if result is not None:
        return result
    return noetica_chat(text, session_id=session_id, context=context)


# ---------------------------------------------------------------------------
# Session context helpers
# ---------------------------------------------------------------------------

def _get_session_context(n: int = 10) -> str:
    """Return the last n command.completed events as a formatted string (max 2000 chars)."""
    events = read_ndjson(event_stream_path(), limit=500)
    completed = [e for e in events if e.get("event_type") == "command.completed"]
    recent = completed[-n:]
    if not recent:
        return ""
    lines: list[str] = ["Recent commands:"]
    for idx, evt in enumerate(recent):
        cmd = (evt.get("command") or "").replace("\n", " ")
        if len(cmd) > 80:
            cmd = cmd[:77] + "..."
        exit_status = evt.get("exit_status")
        exit_str = f"exit {exit_status}" if exit_status is not None else "exit ?"
        lines.append(f"  [{idx}] $ {cmd} → {exit_str}")
    result = "\n".join(lines)
    if len(result) > 2000:
        result = result[:1997] + "..."
    return result


# ---------------------------------------------------------------------------
# Shared response / decision helpers
# ---------------------------------------------------------------------------

def decision_stub(action: str, reason: str, decision: str = "ask") -> dict[str, Any]:
    return {
        "id": f"urn:srcos:exec-decision:{uuid.uuid4().hex}",
        "type": "ExecutionDecision",
        "specVersion": "2.0.0",
        "decision": decision,
        "reason": reason,
        "issuedAt": utc_now(),
        "action": action,
    }


def response(kind: str, data: dict[str, Any] | list[Any] | None = None, *, status: str = "ok") -> dict[str, Any]:
    return {
        "schema": SCHEMA,
        "status": status,
        "kind": kind,
        "capturedAt": utc_now(),
        "data": data if data is not None else {},
    }


# ---------------------------------------------------------------------------
# Surfaces
# ---------------------------------------------------------------------------

def default_surfaces() -> list[dict[str, Any]]:
    workspace = env("SOURCEOS_WORKSPACE", "default")
    cwd = os.getcwd()
    return [
        {
            "surface_id": "local/default",
            "label": "Local Workspace",
            "kind": "host",
            "workspace_id": workspace,
            "cwd": cwd,
            "execution_domain": "host",
            "policy_profile": "standard",
            "agent_allowed": False,
            "receipt_required": True,
            "provider": "turtleterm",
        },
        {
            "surface_id": "tmux/attached",
            "label": "Attached tmux Session",
            "kind": "tmux",
            "workspace_id": workspace,
            "cwd": cwd,
            "execution_domain": "host",
            "policy_profile": "standard",
            "agent_allowed": False,
            "receipt_required": True,
            "provider": "turtle-tmux",
        },
        {
            "surface_id": "neovim/context",
            "label": "Neovim Context",
            "kind": "editor-context",
            "workspace_id": workspace,
            "cwd": cwd,
            "execution_domain": "host",
            "policy_profile": "review-only",
            "agent_allowed": False,
            "receipt_required": True,
            "provider": "turtle.nvim",
        },
        {
            "surface_id": "cloudfog/local-devshell",
            "label": "CloudFog Local Devshell",
            "kind": "devshell",
            "workspace_id": workspace,
            "cwd": cwd,
            "execution_domain": "devshell",
            "policy_profile": "low-risk",
            "agent_allowed": False,
            "receipt_required": True,
            "provider": "cloudfog-shell",
        },
        {
            "surface_id": "agent-machine/local-agentpod",
            "label": "Agent Machine Local AgentPod",
            "kind": "agentpod",
            "workspace_id": workspace,
            "cwd": cwd,
            "execution_domain": "agent-machine",
            "policy_profile": "activation-required",
            "agent_allowed": False,
            "receipt_required": True,
            "provider": "agent-machine",
        },
    ]


def surface_by_id(surface_id: str | None) -> dict[str, Any] | None:
    for surface in default_surfaces():
        if surface["surface_id"] == surface_id:
            return surface
    return None


# ---------------------------------------------------------------------------
# Request handler
# ---------------------------------------------------------------------------

def handle_request(request: dict[str, Any]) -> dict[str, Any]:  # noqa: C901
    action = request.get("action")

    # ------------------------------------------------------------------
    # Core
    # ------------------------------------------------------------------
    if action == "ping":
        noetica_reachable = noetica_get("/api/status", timeout=1) is not None
        return response("pong", {
            "service": "turtle-agentd",
            "version": "0.1.0",
            "noetica_url": noetica_url(),
            "noetica_reachable": noetica_reachable,
        })

    if action == "sessions":
        events = read_ndjson(event_stream_path(), limit=500)
        sessions: dict[str, dict[str, Any]] = {}
        for event in events:
            session_id = event.get("session_id")
            if not session_id:
                continue
            sessions.setdefault(session_id, {}).update({
                "session_id": session_id,
                "workspace_id": event.get("workspace_id"),
                "frontend": event.get("frontend"),
                "execution_domain": event.get("execution_domain"),
                "git_branch": event.get("git_branch"),
                "repo_root": event.get("repo_root"),
                "last_event_type": event.get("event_type", event.get("schema")),
            })
        return response("sessions", {"sessions": list(sessions.values()), "event_stream": str(event_stream_path())})

    if action == "surfaces":
        return response("surfaces", {"surfaces": default_surfaces()})

    if action == "inspect_surface":
        surface_id = request.get("surface_id")
        surface = surface_by_id(surface_id)
        if not surface:
            return response("error", {"message": f"unknown surface: {surface_id}", "known_surfaces": [s["surface_id"] for s in default_surfaces()]}, status="error")
        return response("surface_inspection", {"surface": surface, "decision": decision_stub("surface.inspect", "Surface inspection is review-only.", "allow")})

    if action == "request_surface_execution":
        surface_id = request.get("surface_id")
        command = request.get("command")
        surface = surface_by_id(surface_id)
        if not surface:
            return response("error", {"message": f"unknown surface: {surface_id}"}, status="error")
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        actor_id = request.get("actor_id", "human:local-user")
        domain = surface.get("execution_domain", "host")
        pf_result = policy_evaluate("surface.execute_command", command, domain, actor_id)
        pf_decision, pf_reason, pf_decision_id = _policy_outcome_to_decision(pf_result, "surface.execute_command", command)
        return response("surface_execution_request", {
            "surface": surface,
            "command": command,
            "executionAllowed": pf_decision == "allow",
            "policy_decision": pf_decision,
            "policy_decision_id": pf_decision_id,
            "decision": {
                "id": f"urn:srcos:exec-decision:{uuid.uuid4().hex}",
                "type": "ExecutionDecision",
                "specVersion": "2.0.0",
                "decision": pf_decision,
                "reason": pf_reason,
                "issuedAt": utc_now(),
                "action": "surface.execute_command",
                "policyDecisionId": pf_decision_id,
            },
        })

    if action == "inspect":
        session_id = request.get("session_id")
        events = [row for row in read_ndjson(event_stream_path(), limit=500) if not session_id or row.get("session_id") == session_id]
        return response("inspection", {"session_id": session_id, "events": events[-50:]})

    if action == "summarize":
        session_id = request.get("session_id")
        events = [row for row in read_ndjson(event_stream_path(), limit=500) if not session_id or row.get("session_id") == session_id]
        completed = [row for row in events if row.get("event_type") == "command.completed"]
        failures = [row for row in completed if row.get("exit_status") not in (0, None)]
        summary = {
            "session_id": session_id,
            "event_count": len(events),
            "completed_commands": len(completed),
            "failed_commands": len(failures),
            "last_command": completed[-1].get("command") if completed else None,
            "last_exit_status": completed[-1].get("exit_status") if completed else None,
            "last_git_branch": completed[-1].get("git_branch") if completed else None,
        }
        return response("summary", summary)

    if action == "propose_command":
        command = request.get("command")
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        return response("command_proposal", {
            "command": command,
            "requiresDecision": True,
            "decision": decision_stub("terminal.propose_command", "Command proposal recorded; execution still requires policy."),
        })

    if action == "request_execution":
        command = request.get("command")
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        domain = detect_execution_domain()
        actor_id = request.get("actor_id", "human:local-user")
        pf_result = policy_evaluate("terminal.execute_command", command, domain, actor_id)
        pf_decision, pf_reason, pf_decision_id = _policy_outcome_to_decision(pf_result, "terminal.execute_command", command)
        execution_allowed = pf_decision == "allow"
        return response("execution_request", {
            "command": command,
            "executionAllowed": execution_allowed,
            "policy_decision": pf_decision,
            "policy_decision_id": pf_decision_id,
            "policy_result": pf_result,
            "decision": {
                "id": f"urn:srcos:exec-decision:{uuid.uuid4().hex}",
                "type": "ExecutionDecision",
                "specVersion": "2.0.0",
                "decision": pf_decision,
                "reason": pf_reason,
                "issuedAt": utc_now(),
                "action": "terminal.execute_command",
                "policyDecisionId": pf_decision_id,
            },
        })

    if action == "policy_status":
        pf_result = None
        reachable = False
        try:
            url = policy_fabric_url().rstrip("/") + "/healthz"
            req = urlrequest.Request(url, method="GET")
            with urlrequest.urlopen(req, timeout=3) as resp:
                pf_result = json.loads(resp.read().decode("utf-8", errors="replace"))
                reachable = True
        except (urlerror.URLError, OSError, TimeoutError, json.JSONDecodeError):
            pass
        return response("policy_status", {
            "url": policy_fabric_url(),
            "reachable": reachable,
            "mode": env("TURTLE_POLICY_MODE", "report_only"),
            "status": pf_result,
        })

    # ------------------------------------------------------------------
    # Track A: shell event ingestion + receipt writing
    # ------------------------------------------------------------------
    if action == "ingest_event":
        event = request.get("event", {})
        if not event:
            return response("error", {"message": "event is required"}, status="error")

        # Ensure event has required fields.
        now = utc_now()
        event.setdefault("event_id", f"evt_{uuid.uuid4().hex}")
        event.setdefault("schema", "sourceos.terminal.event.v0")
        event.setdefault("session_id", env("SOURCEOS_TERMINAL_SESSION_ID", f"term-{uuid.uuid4().hex}"))
        event.setdefault("workspace_id", env("SOURCEOS_WORKSPACE", "default"))
        event.setdefault("actor_id", "human:local-user")
        event.setdefault("frontend", env("SOURCEOS_TERMINAL_FRONTEND", "turtle-term"))
        event.setdefault("host", os.uname().nodename)
        event.setdefault("user", os.environ.get("USER", "unknown"))
        event.setdefault("capturedAt", now)

        # Enrich: execution domain.
        if not event.get("execution_domain"):
            event["execution_domain"] = detect_execution_domain()

        # Enrich: git metadata.
        if not event.get("repo_root"):
            git = git_info(event.get("cwd"))
            event.setdefault("repo_root", git["repo_root"])
            event.setdefault("git_branch", git["git_branch"])

        # Redact secrets from command string before persisting.
        if event.get("command"):
            event["command"] = redact_secrets(event["command"])

        receipt_path: str | None = None
        append_event(event)

        # Write receipt for completed commands.
        if event.get("event_type") == "command.completed":
            receipt_path = write_receipt(event)

        return response("event_ingested", {
            "event_id": event["event_id"],
            "session_id": event["session_id"],
            "event_type": event.get("event_type"),
            "receipt_path": receipt_path,
        })

    # ------------------------------------------------------------------
    # Track B: Noetica cognition wire
    # ------------------------------------------------------------------
    if action == "noetica_status":
        noetica_resp = noetica_get("/api/status", timeout=3)
        reachable = noetica_resp is not None
        return response("noetica_status", {
            "url": noetica_url(),
            "reachable": reachable,
            "status": noetica_resp,
        })

    if action == "noetica_query":
        text = request.get("text", "")
        if not text:
            return response("error", {"message": "text is required"}, status="error")
        session_id = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID")
        context = request.get("context")
        noetica_resp = noetica_chat(text, session_id=session_id, context=context)
        return response("noetica_query_result", {
            "text": text,
            "noetica_response": noetica_resp,
            "reachable": noetica_resp is not None,
        })

    if action == "superconscious_observe":
        observation = request.get("observation", {})
        trace_ref = f"urn:srcos:turtle:superconscious-observation:{uuid.uuid4().hex}"

        # Wire to Noetica: translate observation into a chat message.
        obs_text = observation.get("text") or json.dumps(observation, sort_keys=True)
        noetica_resp = noetica_chat(
            f"[terminal-observation] {obs_text}",
            session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
            context={"source": "turtleterm", "type": "observation"},
        )

        return response("superconscious_observation", {
            "status": "recorded",
            "observation": observation,
            "traceRef": trace_ref,
            "noetica_response": noetica_resp,
            "decision": decision_stub("superconscious.observe", "Observation handoff is review-only; no shell authority granted.", "allow"),
        })

    if action == "superconscious_propose":
        prompt = request.get("prompt", "")

        noetica_resp = noetica_chat(
            f"[terminal-proposal-request] {prompt}",
            session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
            context={"source": "turtleterm", "type": "proposal_request"},
        )

        return response("superconscious_proposal", {
            "status": "proposed" if noetica_resp else "deferred",
            "prompt": prompt,
            "noetica_response": noetica_resp,
            "decision": decision_stub("superconscious.propose", "Superconscious proposal routed to Noetica cognition loop.", "defer"),
        })

    # ------------------------------------------------------------------
    # Agent Machine
    # ------------------------------------------------------------------
    if action == "agent_machine_surfaces":
        return response("agent_machine_surfaces", {"surfaces": [s for s in default_surfaces() if s["provider"] == "agent-machine"]})

    if action == "agent_machine_probe":
        base = agent_machine_url()
        result = _http_get(base.rstrip("/") + "/health", timeout=3)
        if result is None:
            result = _http_get(base.rstrip("/") + "/api/probe", timeout=3)
        reachable = result is not None
        return response("agent_machine_probe", {
            "agent_machine_url": base,
            "reachable": reachable,
            "probe_response": result,
            "decision": decision_stub(
                "agent-machine.probe",
                f"Agent Machine {'reachable' if reachable else 'unreachable'} at {base}.",
                "allow" if reachable else "defer",
            ),
        })

    # ------------------------------------------------------------------
    # CloudFog
    # ------------------------------------------------------------------
    if action == "cloudfog_surfaces":
        return response("cloudfog_surfaces", {"surfaces": [s for s in default_surfaces() if s["provider"] == "cloudfog-shell"]})

    if action == "cloudfog_inspect":
        surface_id = request.get("surface_id", "cloudfog/local-devshell")
        surface = surface_by_id(surface_id)
        if not surface or surface.get("provider") != "cloudfog-shell":
            return response("error", {"message": f"unknown cloudfog surface: {surface_id}"}, status="error")
        return response("cloudfog_surface_inspection", {"surface": surface, "decision": decision_stub("cloudfog.inspect", "CloudFog surface inspection is review-only.", "allow")})

    # ------------------------------------------------------------------
    # Receipts + AgentPlane
    # ------------------------------------------------------------------
    if action == "receipts":
        session_id = request.get("session_id")
        root = receipts_root()
        paths: list[str] = []
        if session_id:
            paths = sorted(str(p) for p in (root / session_id).glob("*.json")) if (root / session_id).exists() else []
        else:
            paths = sorted(str(p) for p in root.glob("*/*.json")) if root.exists() else []
        return response("receipts", {"session_id": session_id, "receipts": paths[-100:]})

    if action == "promote_agentplane_bundle":
        return response("agentplane_promotion_request", {
            "status": "deferred",
            "decision": decision_stub("agentplane.bundle.create", "AgentPlane bundle promotion is specified but not implemented in turtle-agentd v0.", "defer"),
        })

    # ------------------------------------------------------------------
    # AI-powered terminal intelligence
    # ------------------------------------------------------------------

    if action == "explain_selection":
        text = request.get("text", "").strip()
        if not text:
            return response("error", {"message": "text is required"}, status="error")
        context = request.get("context") or {}
        cwd = context.get("cwd") or os.getcwd()
        git = git_info(cwd)
        system_prompt = (
            "You are a terminal intelligence assistant. Explain what the following terminal output "
            "or selected text means, in 2-4 concise sentences. Identify errors, key data, or "
            "actionable next steps if relevant. Be direct and technical."
        )
        ctx_suffix = ""
        if git.get("git_branch"):
            ctx_suffix = f"\n\nContext: git branch `{git['git_branch']}`, cwd `{cwd}`"
        session_ctx = _get_session_context()
        if session_ctx:
            ctx_suffix += f"\n\n{session_ctx}"
        user_prompt = f"Selected text:\n```\n{text}\n```{ctx_suffix}"
        ai_resp = smart_chat(
            user_prompt,
            system=system_prompt,
            session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
            context=context,
        )
        explanation = None
        if ai_resp:
            explanation = (
                ai_resp.get("response")
                or ai_resp.get("message")
                or ai_resp.get("content")
                or ai_resp.get("raw")
            )
        source = (ai_resp or {}).get("source", "unknown") if ai_resp else "none"
        return response("explain_selection", {
            "text": text[:200],
            "explanation": explanation or "(no AI backend reachable — set ANTHROPIC_API_KEY or start Noetica on :8080)",
            "source": source,
            "ai_response": ai_resp,
        })

    if action == "nl_to_shell":
        text = request.get("text", "").strip()
        if not text:
            return response("error", {"message": "text is required"}, status="error")
        context = request.get("context") or {}
        cwd = context.get("cwd") or os.getcwd()
        git = git_info(cwd)
        shell = context.get("shell") or os.environ.get("SHELL", "zsh").split("/")[-1]
        system_prompt = (
            f"You are a {shell} shell command generator. The user describes what they want to do. "
            f"Output ONLY a single {shell} command, no explanation, no markdown fences, no commentary. "
            "If the task requires multiple steps, chain them with && or use a subshell. "
            "Never output multiple lines unless using a heredoc."
        )
        ctx_suffix = ""
        if git.get("git_branch"):
            ctx_suffix = f"\n\nContext: git branch `{git['git_branch']}`, cwd `{cwd}`"
        session_ctx = _get_session_context()
        if session_ctx:
            ctx_suffix += f"\n\n{session_ctx}"
        user_prompt = f"Request: {text}{ctx_suffix}"
        ai_resp = smart_chat(
            user_prompt,
            system=system_prompt,
            session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
            context=context,
        )
        command = None
        if ai_resp:
            raw = (
                ai_resp.get("response")
                or ai_resp.get("message")
                or ai_resp.get("content")
                or ai_resp.get("raw")
                or ""
            )
            command = raw.strip().strip("`").strip()
            # Remove leading shell name prefix if model echoed it
            for prefix in (f"{shell}: ", f"$ ", f"% "):
                if command.startswith(prefix):
                    command = command[len(prefix):]
        source = (ai_resp or {}).get("source", "unknown") if ai_resp else "none"
        return response("nl_to_shell", {
            "request": text,
            "command": command or "",
            "source": source,
            "ai_response": ai_resp,
            "reachable": ai_resp is not None,
        })

    if action == "terminal_execute_with_confirmation":
        command = request.get("command", "").strip()
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        description = request.get("description", "")
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        pending_dir.mkdir(parents=True, exist_ok=True)
        pending_file = pending_dir / "pending_command"
        tmp_file = pending_dir / "pending_command.tmp"
        tmp_file.write_text(command, encoding="utf-8")
        tmp_file.rename(pending_file)
        meta = {
            "command": command,
            "description": description,
            "requested_at": utc_now(),
            "source": "mcp",
        }
        meta_file = pending_dir / "pending_command.json"
        meta_tmp = pending_dir / "pending_command.json.tmp"
        meta_tmp.write_text(json.dumps(meta, indent=2, sort_keys=True), encoding="utf-8")
        meta_tmp.rename(meta_file)
        return response("execution_pending", {
            "command": command,
            "status": "pending_confirmation",
            "note": "Command written to pending_command file. The terminal will display it for human review and execution.",
        })

    if action == "atlas_context":
        cwd = request.get("cwd") or os.getcwd()
        # Walk up from cwd looking for .atlas/ directory
        atlas_dir: Path | None = None
        p = Path(cwd)
        for _ in range(8):
            candidate = p / ".atlas"
            if candidate.is_dir():
                atlas_dir = candidate
                break
            if p.parent == p:
                break
            p = p.parent
        if atlas_dir is None:
            return response("atlas_context", {
                "found": False,
                "atlas_dir": None,
                "entries": [],
                "note": "No .atlas/ directory found in cwd or parent directories.",
            })
        entries: list[dict[str, Any]] = []
        for md_file in sorted(atlas_dir.rglob("*.md"))[:20]:
            try:
                content = md_file.read_text(encoding="utf-8", errors="replace")[:2000]
                entries.append({"path": str(md_file.relative_to(atlas_dir)), "content": content})
            except OSError:
                continue
        return response("atlas_context", {
            "found": True,
            "atlas_dir": str(atlas_dir),
            "entries": entries,
            "entry_count": len(entries),
        })

    if action == "atlas_acp_register":
        atlas_url = env("ATLAS_ACP_URL", "http://localhost:3000/acp/")
        registration = {
            "agent": {
                "id": "turtleterm",
                "name": "TurtleTerm",
                "description": "TurtleTerm terminal intelligence agent (SourceOS)",
                "version": "0.1.1",
                "capabilities": ["terminal", "shell", "explain_selection", "nl_to_shell"],
                "endpoint": env("TURTLETERM_ACP_ENDPOINT", ""),
            }
        }
        result = _http_post(atlas_url.rstrip("/") + "/register", registration, timeout=5)
        reachable = result is not None
        return response("atlas_acp_register", {
            "atlas_url": atlas_url,
            "reachable": reachable,
            "registration": registration["agent"],
            "atlas_response": result,
            "status": "registered" if reachable else "atlas_unreachable",
        })

    # ------------------------------------------------------------------
    # Local policy rule engine
    # ------------------------------------------------------------------

    if action == "policy_evaluate_local":
        command = request.get("command", "").strip()
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        local_decision, local_reason, local_matched = _local_policy_check(command)
        return response("policy_local", {
            "command": command,
            "decision": local_decision,
            "reason": local_reason,
            "matched_rule": local_matched,
        })

    # ------------------------------------------------------------------
    # BearBrowser A2A handoff
    # ------------------------------------------------------------------
    if action == "bearbrowser_handoff":
        task_description = request.get("task", "")
        if not task_description:
            return response("error", {"message": "bearbrowser_handoff requires 'task' field"}, status="error")
        base = bearbrowser_a2a_url()
        session_id = env("SOURCEOS_TERMINAL_SESSION_ID") or str(uuid.uuid4())
        handoff_id = str(uuid.uuid4())
        payload = {
            "task": {
                "id": f"urn:srcos:bearbrowser:task:{handoff_id}",
                "description": task_description,
                "skill": "browser.handoff",
                "context": {
                    "source": "turtleterm",
                    "session_id": session_id,
                    "workspace": env("SOURCEOS_WORKSPACE", "default"),
                    "execution_domain": detect_execution_domain(),
                    "actor_id": env("SOURCEOS_ACTOR_ID", "human:local-user"),
                    "policy_bundle_id": env("SOURCEOS_POLICY_BUNDLE_ID", "policy:default"),
                    "handoff_id": handoff_id,
                },
            }
        }
        result = _http_post(base.rstrip("/") + "/a2a/tasks", payload, timeout=8)
        reachable = result is not None
        status_label = "submitted" if reachable else "queued_offline"
        receipt = write_receipt({
            "schema": "sourceos.terminal.event.v0",
            "event_type": "bearbrowser.handoff",
            "session_id": session_id,
            "task": task_description,
            "handoff_id": handoff_id,
            "bearbrowser_url": base,
            "reachable": reachable,
            "status": status_label,
            "capturedAt": utc_now(),
        })
        return response("bearbrowser_handoff", {
            "handoff_id": handoff_id,
            "task": task_description,
            "bearbrowser_url": base,
            "reachable": reachable,
            "status": status_label,
            "bearbrowser_response": result,
            "receipt": receipt,
            "decision": decision_stub(
                "bearbrowser.handoff",
                f"BearBrowser A2A handoff {'submitted' if reachable else 'queued (BearBrowser unreachable)'}.",
                "allow" if reachable else "defer",
            ),
        })

    # ------------------------------------------------------------------
    # Agent planner loop — multi-step command planning with confirmation
    # ------------------------------------------------------------------
    if action == "plan_execute":
        import re as _re
        goal = request.get("goal", "").strip()
        if not goal:
            return response("error", {"message": "goal is required"}, status="error")

        system_prompt = (
            "You are a shell command planner for a terminal intelligence system. "
            "Given a user goal, generate a step-by-step plan as JSON. "
            "Output ONLY valid JSON with this exact schema (no markdown, no prose):\n"
            '{"goal":"...","steps":[{"description":"...","command":"...","reversible":true}]}\n'
            "Rules: each step is ONE shell command; max 8 steps; prefer safe, reversible commands; "
            "mark reversible=false only for delete/overwrite operations."
        )
        session_ctx = _get_session_context()
        user_msg = f"Goal: {goal}"
        if session_ctx:
            user_msg += f"\n\n{session_ctx}"

        ai_resp = _claude_chat(user_msg, system=system_prompt, timeout=20)
        if ai_resp is None:
            ai_resp = smart_chat(user_msg, system=system_prompt)
        if ai_resp is None:
            return response("error", {"message": "AI backend unavailable — set ANTHROPIC_API_KEY or start Noetica"}, status="error")

        raw = (ai_resp.get("response") or ai_resp.get("message") or ai_resp.get("raw") or "")
        json_match = _re.search(r'\{.*\}', raw, _re.DOTALL)
        steps: list[dict[str, Any]] = []
        parsed_goal = goal
        if json_match:
            try:
                plan = json.loads(json_match.group(0))
                steps = plan.get("steps", [])
                parsed_goal = plan.get("goal", goal)
            except json.JSONDecodeError:
                pass
        if not steps:
            return response("error", {"message": "AI did not return a valid plan", "raw": raw[:500]}, status="error")

        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        pending_dir.mkdir(parents=True, exist_ok=True)
        plan_data: dict[str, Any] = {
            "goal": parsed_goal,
            "steps": steps,
            "current_step": 0,
            "created_at": utc_now(),
            "source": "plan_execute",
        }
        (pending_dir / "current_plan.json").write_text(json.dumps(plan_data, indent=2))
        _emit_plan_event("plan_created", goal=parsed_goal, step_count=len(steps), current_step=0)

        first_cmd = steps[0].get("command", "") if steps else ""
        if first_cmd:
            tmp = pending_dir / "pending_command.tmp"
            tmp.write_text(first_cmd)
            tmp.rename(pending_dir / "pending_command")
            meta: dict[str, Any] = {
                "command": first_cmd,
                "description": steps[0].get("description", ""),
                "requested_at": utc_now(),
                "source": "plan",
                "plan_step": 0,
                "plan_total": len(steps),
                "goal": parsed_goal,
            }
            mtmp = pending_dir / "pending_command.json.tmp"
            mtmp.write_text(json.dumps(meta, indent=2))
            mtmp.rename(pending_dir / "pending_command.json")

        return response("plan_execute", {
            "goal": parsed_goal,
            "step_count": len(steps),
            "steps": steps,
            "current_step": 0,
            "status": "first_step_ready",
            "note": "Step 1 written to terminal prompt. Run it, then call plan_next to advance.",
        })

    if action == "plan_next":
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        plan_file = pending_dir / "current_plan.json"
        if not plan_file.exists():
            return response("error", {"message": "no active plan — call plan_execute first"}, status="error")
        try:
            plan_data = json.loads(plan_file.read_text())
        except (json.JSONDecodeError, OSError):
            return response("error", {"message": "could not read current plan"}, status="error")
        steps = plan_data.get("steps", [])
        next_idx = plan_data.get("current_step", 0) + 1
        if next_idx >= len(steps):
            plan_file.unlink(missing_ok=True)
            _emit_plan_event("plan_complete", goal=plan_data.get("goal"), total_steps=len(steps))
            return response("plan_complete", {
                "goal": plan_data.get("goal"),
                "total_steps": len(steps),
                "status": "all_steps_complete",
            })
        plan_data["current_step"] = next_idx
        plan_file.write_text(json.dumps(plan_data, indent=2))
        _emit_plan_event("step_started",
            goal=plan_data.get("goal"), step=next_idx,
            total=len(steps), command=steps[next_idx].get("command", ""),
            description=steps[next_idx].get("description", ""))
        next_cmd = steps[next_idx].get("command", "")
        if next_cmd:
            tmp = pending_dir / "pending_command.tmp"
            tmp.write_text(next_cmd)
            tmp.rename(pending_dir / "pending_command")
            meta = {
                "command": next_cmd,
                "description": steps[next_idx].get("description", ""),
                "requested_at": utc_now(),
                "source": "plan",
                "plan_step": next_idx,
                "plan_total": len(steps),
                "goal": plan_data.get("goal"),
            }
            mtmp = pending_dir / "pending_command.json.tmp"
            mtmp.write_text(json.dumps(meta, indent=2))
            mtmp.rename(pending_dir / "pending_command.json")
        return response("plan_next", {
            "goal": plan_data.get("goal"),
            "step": next_idx,
            "step_count": len(steps),
            "command": next_cmd,
            "description": steps[next_idx].get("description", ""),
            "status": "step_ready",
            "remaining": len(steps) - next_idx - 1,
        })

    if action == "plan_status":
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        plan_file = pending_dir / "current_plan.json"
        if not plan_file.exists():
            return response("plan_status", {"active": False})
        try:
            plan_data = json.loads(plan_file.read_text())
            return response("plan_status", {
                "active": True,
                "goal": plan_data.get("goal"),
                "current_step": plan_data.get("current_step", 0),
                "step_count": len(plan_data.get("steps", [])),
                "steps": plan_data.get("steps", []),
            })
        except (json.JSONDecodeError, OSError):
            return response("plan_status", {"active": False})

    if action == "plan_abort":
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        plan_file = pending_dir / "current_plan.json"
        goal = None
        try:
            goal = json.loads(plan_file.read_text()).get("goal")
        except (OSError, json.JSONDecodeError):
            pass
        plan_file.unlink(missing_ok=True)
        (pending_dir / "pending_command").unlink(missing_ok=True)
        (pending_dir / "pending_command.json").unlink(missing_ok=True)
        _emit_plan_event("plan_aborted", goal=goal)
        return response("plan_abort", {"status": "aborted"})

    return response("error", {"message": f"unknown action: {action}"}, status="error")


# ---------------------------------------------------------------------------
# Server modes
# ---------------------------------------------------------------------------

def serve_stdio() -> int:
    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(json.dumps(response("error", {"message": str(exc)}, status="error")))
        return 2
    print(json.dumps(handle_request(request), indent=2, sort_keys=True))
    return 0


def serve_socket(path: Path) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        path.unlink()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    server.listen(8)
    print(json.dumps(response("listening", {"socket": str(path)})), flush=True)
    try:
        while True:
            conn, _ = server.accept()
            with conn:
                raw = conn.recv(4 * 1024 * 1024)
                try:
                    req = json.loads(raw.decode("utf-8"))
                    result = handle_request(req)
                except Exception as exc:  # noqa: BLE001
                    result = response("error", {"message": str(exc)}, status="error")
                conn.sendall((json.dumps(result, sort_keys=True) + "\n").encode("utf-8"))
    finally:
        server.close()
        if path.exists():
            path.unlink()


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="TurtleTerm local agent gateway v0")
    parser.add_argument("--stdio", action="store_true", help="read one JSON request from stdin and write one JSON response")
    parser.add_argument("--socket", default=str(default_socket_path()), help="Unix socket path for daemon mode")
    args = parser.parse_args(argv)

    if args.stdio:
        return serve_stdio()
    return serve_socket(Path(args.socket))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
