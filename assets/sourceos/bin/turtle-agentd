            "agent_allowed": False,
            "receipt_required": True,
            "provider": "turtle-tmux",
        },
        {
            "surface_id": "neovim/context",
            "label": "Neovim Context",
            "kind": "editor-context",
            "workspace_id": workspace,
            "cwd": cwd,
            "execution_domain": "host",
            "policy_profile": "review-only",
            "agent_allowed": False,
            "receipt_required": True,
