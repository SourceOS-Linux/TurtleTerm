    if action in ("coach_analyze", "coach-analyze"):
        """Detect inefficient command patterns and teach better alternatives."""
        session_id = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID")
        focus = request.get("focus", "")
        events = read_ndjson(event_stream_path(), limit=500)
        if session_id:
            events = [e for e in events if e.get("session_id") == session_id]
        completed = [e for e in events if e.get("event_type") == "command.completed"]
        if len(completed) < 3:
            return response("coach_analyze", {"insights": [], "message": "Need at least 3 commands to analyze patterns."})
        commands = [e.get("command", "") for e in completed[-50:]]
        cmds_text = "\n".join(commands)
        _persona = _load_persona_system()
        _mems    = _load_memories_context()
        _prefix  = "\n\n".join(x for x in [_persona, _mems] if x)
        system = (_prefix + "\n\n" if _prefix else "") + (
            "You are an expert shell programmer acting as a terminal coach. "
            "Analyze these recent shell commands for inefficient patterns, repeated anti-patterns, "
            "or missed opportunities for better tools. "
            f"{'Focus on: ' + focus + '. ' if focus else ''}"
            "Return JSON: {\"insights\": [{\"pattern\": \"...\", \"better\": \"...\", \"example\": \"...\"}], \"score\": 0-10} "
            "where score=10 means highly efficient. Max 3 insights. Be specific with actual commands."
        )
        ai_resp = smart_chat(cmds_text, system=system)
        import re as _re_coach
        insights = []
        score = 7
        if ai_resp:
            raw = (ai_resp.get("response") or "")
            m = _re_coach.search(r'\{.*\}', raw, _re_coach.DOTALL)
            if m:
                try:
                    parsed = json.loads(m.group(0))
                    insights = parsed.get("insights", [])
                    score = parsed.get("score", 7)
                except json.JSONDecodeError:
                    pass
        return response("coach_analyze", {"insights": insights, "score": score, "command_count": len(commands)})

    if action in ("smart_paste_sanitize", "smart-paste-sanitize"):
        text = request.get("text", "").strip()
        shell = request.get("shell", "bash")
        if not text:
            return response("smart_paste_sanitize", {"sanitized": "", "changes": [], "safe": True})

        import re as _re_sp
        changes = []
        sanitized = text

        # Fix common quoting issues
        # Curly quotes → straight quotes
        for bad, good in [('‘', "'"), ('’', "'"), ('“', '"'), ('”', '"')]:
            if bad in sanitized:
                sanitized = sanitized.replace(bad, good)
                changes.append(f"replaced curly quote {bad!r} → {good!r}")

        # Zero-width chars
        for zwc in ['​', '‌', '‍', '﻿']:
            if zwc in sanitized:
                sanitized = sanitized.replace(zwc, '')
                changes.append("removed zero-width character")

        # Detect unbalanced quotes
        single_count = sanitized.count("'") - sanitized.count("\\'")
        double_count = sanitized.count('"') - sanitized.count('\\"')
        if single_count % 2 != 0:
            changes.append("warning: unbalanced single quotes")
        if double_count % 2 != 0:
            changes.append("warning: unbalanced double quotes")

        # Trailing semicolons that could concatenate dangerously
        if sanitized.rstrip().endswith(';'):
            changes.append("info: trailing semicolon detected")

        # Also get AI improvement if complex command
        if len(text) > 30 and env("ANTHROPIC_API_KEY"):
            _persona = _load_persona_system()
            _mems    = _load_memories_context()
            _prefix  = "\n\n".join(x for x in [_persona, _mems] if x)
            ai = _claude_chat(
                f"Sanitize and improve this {shell} command for safety and correctness. "
                f"Return ONLY the improved command, no explanation:\n{text}",
                system=(_prefix + "\n\n" if _prefix else "") + f"You are a {shell} expert. Fix quoting, escaping, and safety issues only. Return only the command.",
                timeout=8
            )
            if ai:
                ai_cmd = (ai.get("response") or "").strip().strip("`").strip()
                if ai_cmd and ai_cmd != sanitized and len(ai_cmd) < len(sanitized) * 3:
                    sanitized = ai_cmd
                    changes.append("AI improved quoting/safety")

        return response("smart_paste_sanitize", {
            "sanitized": sanitized,
            "original": text,
            "changes": changes,
            "safe": len([c for c in changes if "warning" in c]) == 0,
        })

    if action in ("dep_vuln_scan", "dep-vuln-scan"):
        command = request.get("command", "").strip()
        cwd = request.get("cwd", ".") or "."
        if not command:
            return response("dep_vuln_scan", {"vulnerabilities": [], "safe": True, "scanned": 0})
        import subprocess as _sp_dv, re as _re_dv, shutil as _sh_dv

        vulns = []
        scanned = 0

        # npm audit for npm installs
        if _re_dv.match(r'npm (install|i|add)\b', command):
            if _sh_dv.which("npm"):
                r = _sp_dv.run(
                    ["npm", "audit", "--json", "--package-lock-only"],
                    capture_output=True, text=True, cwd=cwd, timeout=20
                )
                if r.returncode != 0 and r.stdout:
                    try:
                        audit = json.loads(r.stdout)
                        vulns_data = audit.get("vulnerabilities", {})
                        for name, v in list(vulns_data.items())[:10]:
                            sev = v.get("severity", "unknown")
                            if sev in ("critical", "high", "moderate"):
                                vulns.append({"package": name, "severity": sev, "fixAvailable": v.get("fixAvailable", False)})
                                scanned += 1
                    except json.JSONDecodeError:
                        pass

        # pip-audit for pip installs
        if _re_dv.match(r'pip(3)? install\b', command) and _sh_dv.which("pip-audit"):
            pkgs = _re_dv.findall(r'(?:install\s+)([A-Za-z0-9_\-\[\]>=<.,!]+)', command)
            if pkgs:
                r = _sp_dv.run(
                    ["pip-audit", "--json", "-r", "/dev/stdin"],
                    input="\n".join(pkgs), capture_output=True, text=True, timeout=30
                )
                if r.stdout:
                    try:
                        audit = json.loads(r.stdout)
                        for dep in (audit if isinstance(audit, list) else []):
                            for vuln in dep.get("vulns", [])[:3]:
                                vulns.append({
                                    "package": dep.get("name", "?"),
                                    "severity": vuln.get("aliases", ["?"])[0],
                                    "fixAvailable": bool(dep.get("fix_versions")),
                                    "id": vuln.get("id", ""),
                                })
                                scanned += 1
                    except json.JSONDecodeError:
                        pass

        # cargo audit for rust
        if _re_dv.match(r'cargo (add|install)\b', command) and _sh_dv.which("cargo-audit"):
            r = _sp_dv.run(["cargo", "audit", "--json"], capture_output=True, text=True, cwd=cwd, timeout=30)
            if r.stdout:
                try:
                    audit = json.loads(r.stdout)
                    for v in (audit.get("vulnerabilities", {}).get("list", []))[:5]:
                        vulns.append({
                            "package": v.get("package", {}).get("name", "?"),
                            "severity": v.get("advisory", {}).get("cvss", {}).get("score", "?"),
                            "id": v.get("advisory", {}).get("id", ""),
                        })
                        scanned += 1
                except json.JSONDecodeError:
                    pass

        critical = [v for v in vulns if v.get("severity") in ("critical", "high")]
        return response("dep_vuln_scan", {
            "vulnerabilities": vulns,
            "critical_count": len(critical),
            "safe": len(critical) == 0,
            "scanned": scanned or len(vulns),
            "command": command,
        })

    if action in ("session_to_pr", "session-to-pr"):
        cwd = request.get("cwd", ".") or "."
        style = request.get("style", "detailed")
        import subprocess as _sp_pr
        def _git_pr(*args: str) -> str:
            r = _sp_pr.run(["git"] + list(args), capture_output=True, text=True, cwd=cwd, timeout=8)
            return r.stdout.strip() if r.returncode == 0 else ""

        branch   = _git_pr("rev-parse", "--abbrev-ref", "HEAD")
        commits  = _git_pr("log", "--oneline", "main..HEAD")[:1000] or _git_pr("log", "--oneline", "-10")
        diff_stat= _git_pr("diff", "--stat", "main..HEAD")[:800] or _git_pr("diff", "--stat", "HEAD~5..HEAD")[:800]
        diff_body= _git_pr("diff", "--unified=2", "main..HEAD")[:3000] or ""

        if not commits and not diff_stat:
            return response("session_to_pr", {"title": "", "body": "", "error": "no commits found vs main"})

        style_instr = {
            "concise": "Write a concise 1-sentence title and 2-3 bullet summary.",
            "detailed": "Write a clear title and a structured body with ## Summary (bullets), ## Changes (file-level), ## Testing.",
            "conventional": "Use Conventional Commits format for the title (feat/fix/chore/docs/refactor). Body in standard PR template.",
        }.get(style, "Write a clear title and structured body.")

        prompt = (
            f"Branch: {branch}\n\nCommits:\n{commits}\n\nDiff stat:\n{diff_stat}\n\nDiff:\n{diff_body[:2000]}"
        )
        _persona = _load_persona_system()
        _mems    = _load_memories_context()
        _prefix  = "\n\n".join(x for x in [_persona, _mems] if x)
        system = (_prefix + "\n\n" if _prefix else "") + (
            f"You are a senior engineer writing a GitHub PR description. {style_instr} "
            "Return JSON: {\"title\": \"...\", \"body\": \"...\"}"
        )
        ai_resp = smart_chat(prompt, system=system)
        title = ""
        body  = ""
        if ai_resp:
            raw = (ai_resp.get("response") or "")
            import re as _re_pr
            m = _re_pr.search(r'\{.*\}', raw, _re_pr.DOTALL)
            if m:
                try:
                    parsed = json.loads(m.group(0))
                    title = parsed.get("title", "")
                    body  = parsed.get("body", "")
                except json.JSONDecodeError:
                    title = branch.replace("-", " ").replace("_", " ").title()
                    body  = raw[:1000]

        return response("session_to_pr", {"title": title, "body": body, "branch": branch, "style": style})

    # ------------------------------------------------------------------
    # G9: Alias Learning + Style Profile
    # ------------------------------------------------------------------
    if action in ("alias_learn", "alias-learn"):
        original = request.get("original", "").strip()
        correction = request.get("correction", "").strip()
        if not original or not correction or original == correction:
            return response("alias_learn", {"learned": False, "reason": "no change"})

        profile_path = Path.home() / ".config" / "turtleterm" / "alias_profile.json"
        profile_path.parent.mkdir(parents=True, exist_ok=True)
        profile: dict = {}
        if profile_path.exists():
            try:
                profile = json.loads(profile_path.read_text())
            except json.JSONDecodeError:
                profile = {}

        entries: list = profile.get("corrections", [])
        # deduplicate — update existing entry for same original
        for e in entries:
            if e.get("original") == original:
                e["correction"] = correction
                e["count"] = e.get("count", 1) + 1
                break
        else:
            entries.append({"original": original, "correction": correction, "count": 1})

        # keep most recent 500
        entries = sorted(entries, key=lambda x: x.get("count", 1), reverse=True)[:500]
        profile["corrections"] = entries

        # Derive style preferences
        style_notes = []
        if any("--no-" in e["correction"] for e in entries[:20]):
            style_notes.append("prefers explicit flags")
        if any(len(e["correction"]) < len(e["original"]) for e in entries[:20]):
            style_notes.append("prefers brevity")
        profile["style_notes"] = style_notes
        profile["updated"] = __import__('datetime').datetime.utcnow().isoformat()

        profile_path.write_text(json.dumps(profile, indent=2))
        return response("alias_learn", {"learned": True, "total_entries": len(entries), "style_notes": style_notes})

    if action in ("alias_list", "alias-list"):
        profile_path = Path.home() / ".config" / "turtleterm" / "alias_profile.json"
        if not profile_path.exists():
            return response("alias_list", {"corrections": [], "style_notes": []})
        try:
            profile = json.loads(profile_path.read_text())
        except json.JSONDecodeError:
            return response("alias_list", {"corrections": [], "style_notes": []})
        entries = profile.get("corrections", [])
        limit = int(request.get("limit", 20))
        return response("alias_list", {
            "corrections": entries[:limit],
            "style_notes": profile.get("style_notes", []),
            "total": len(entries),
        })

    if action in ("alias_apply", "alias-apply"):
        command = request.get("command", "").strip()
        if not command:
            return response("alias_apply", {"command": command, "applied": False})
        profile_path = Path.home() / ".config" / "turtleterm" / "alias_profile.json"
        if not profile_path.exists():
            return response("alias_apply", {"command": command, "applied": False})
        try:
            profile = json.loads(profile_path.read_text())
        except json.JSONDecodeError:
            return response("alias_apply", {"command": command, "applied": False})

        entries = profile.get("corrections", [])
        style_notes = profile.get("style_notes", [])
        entries_text = "\n".join(f"{e['original']} → {e['correction']}" for e in entries[:30])

        _persona = _load_persona_system()
        _mems    = _load_memories_context()
        _prefix  = "\n\n".join(x for x in [_persona, _mems] if x)
        system = (_prefix + "\n\n" if _prefix else "") + (
            "You are a shell command personalizer. "
            "The user has a personal style profile based on their past corrections. "
            f"Style: {', '.join(style_notes) or 'none'}.\n"
            f"Past corrections:\n{entries_text}\n\n"
            "Apply the user's style preferences to improve the given command. "
            "Return ONLY the improved command, no explanation."
        )
        ai = _claude_chat(command, system=system, timeout=8)
        improved = (ai.get("response") or "").strip() if ai else ""
        if improved and improved != command and len(improved) < 500:
            return response("alias_apply", {"command": improved, "original": command, "applied": True})
        return response("alias_apply", {"command": command, "applied": False})

    # ------------------------------------------------------------------
    # G10: Git Context Injection
    # ------------------------------------------------------------------
    if action in ("git_context", "git-context"):
        cwd = request.get("cwd", ".") or "."
        import subprocess as _sp_gc
        def _git(*args: str) -> str:
            r = _sp_gc.run(["git"] + list(args), capture_output=True, text=True, cwd=cwd, timeout=8)
            return r.stdout.strip() if r.returncode == 0 else ""

        branch       = _git("rev-parse", "--abbrev-ref", "HEAD")
        recent       = _git("log", "--oneline", "-8")
        status       = _git("status", "--short")
        diff_stat    = _git("diff", "--stat", "HEAD")[:800]
        remote_url   = _git("remote", "get-url", "origin")
        # Try to derive PR URL (GitHub heuristic)
        pr_base = ""
        if "github.com" in remote_url:
            repo_path = remote_url.replace("git@github.com:", "").replace("https://github.com/", "").removesuffix(".git")
            pr_base = f"https://github.com/{repo_path}/compare/{branch}"
        blame_files: list[str] = []
        changed_files = _git("diff", "--name-only", "HEAD").splitlines()[:5]
        for f in changed_files:
            blame = _git("log", "--oneline", "-3", "--follow", f)
            if blame:
                blame_files.append(f"{f}: {blame.splitlines()[0]}")

        context = {
            "branch": branch,
            "recent_commits": recent,
            "status": status,
            "diff_stat": diff_stat,
            "remote": remote_url,
            "pr_url": pr_base,
            "blame_summary": blame_files,
        }
        return response("git_context", context)

    # ------------------------------------------------------------------
    # G11: Session Narrate
    # ------------------------------------------------------------------
    if action in ("session_narrate", "session-narrate"):
        session_id = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID", "")
        limit = int(request.get("limit", 200))
        events = read_ndjson(event_stream_path(), limit=limit)
        if session_id:
            events = [e for e in events if e.get("session_id") == session_id]
        completed = [e for e in events if e.get("event_type") == "command.completed"]
        if not completed:
            return response("session_narrate", {"narrative": "No completed commands in this session yet.", "commands": 0})

        lines = []
        for e in completed[-40:]:
            cmd = e.get("command", "")
            rc  = e.get("exit_code", 0)
            out = (e.get("output") or "")[:120]
            lines.append(f"$ {cmd}  [exit {rc}]{' → ' + out.strip()[:80] if out.strip() else ''}")

        prompt = "\n".join(lines)
        _persona = _load_persona_system()
        _mems    = _load_memories_context()
        _prefix  = "\n\n".join(x for x in [_persona, _mems] if x)
        system = (_prefix + "\n\n" if _prefix else "") + (
            "You are a technical scribe. Given a list of terminal commands with their exit codes, "
            "write a 3-5 sentence narrative in past tense describing what the developer was working on. "
            "Be specific, use technical terms, mention tools, file names, or patterns you observe. "
            "Do NOT just list the commands. Write prose."
        )
        ai = _claude_chat(prompt, system=system, timeout=12)
        narrative = (ai.get("response") or "").strip() if ai else "Unable to generate narrative (no AI key)."
        return response("session_narrate", {"narrative": narrative, "commands": len(completed)})

    # ------------------------------------------------------------------
    # G12: Share Session
    # ------------------------------------------------------------------
    if action in ("share_session", "share-session"):
        import subprocess as _sp_sh, shutil as _sh_sh
        port = int(request.get("port", 7723))
        ttl  = int(request.get("ttl_minutes", 60))
        role  = request.get("role", "writer")  # "writer" | "viewer"
        token = request.get("token", "") or __import__('secrets').token_urlsafe(8)

        if _sh_sh.which("ttyd"):
            shell = env("SHELL", "/bin/zsh")
            proc = _sp_sh.Popen(
                ["ttyd", "-p", str(port), "-t", "titleFixed=TurtleTerm Share", shell],
                stdout=_sp_sh.DEVNULL, stderr=_sp_sh.DEVNULL,
            )
            import atexit as _ae_sh
            _ae_sh.register(proc.terminate)
            url = f"http://localhost:{port}"
            return response("share_session", {
                "url": url,
                "pid": proc.pid,
                "backend": "ttyd",
                "role": role,
                "token": token,
                "ttl_minutes": ttl,
                "hint": f"Open {url}?token={token} — role={role}",
            })
        elif _sh_sh.which("upterm"):
            r = _sp_sh.run(
                ["upterm", "host", "--force-command", env("SHELL", "/bin/zsh")],
                capture_output=True, text=True, timeout=15,
            )
            lines = r.stdout.splitlines()
            join_line = next((l for l in lines if "ssh" in l or "uptermd" in l), "")
            return response("share_session", {
                "url": join_line,
                "backend": "upterm",
                "ttl_minutes": ttl,
                "hint": "Share the ssh command above",
            })
        else:
            return response("share_session", {
                "url": "",
                "backend": "none",
                "error": "Install ttyd (brew install ttyd) or upterm for session sharing",
            })

    if action in ("stop_share", "stop-share"):
        import subprocess as _sp_ss
        _sp_ss.run(["pkill", "-f", "ttyd"], capture_output=True)
        _sp_ss.run(["pkill", "-f", "upterm"], capture_output=True)
        return response("stop_share", {"stopped": True})

    # ------------------------------------------------------------------
    # G13: Sync Push / Pull
    # ------------------------------------------------------------------
    if action in ("sync_push", "sync-push"):
        import subprocess as _sp_sy, shutil as _sh_sy
        remote = request.get("remote", "").strip()
        config_dir = Path.home() / ".config" / "turtleterm"
        sync_repo  = config_dir / "sync"

        # Files to sync
        sync_files = [
            config_dir / "bookmarks.json",
            config_dir / "alias_profile.json",
            config_dir / "env_baseline.json",
            config_dir / "theme.txt",
        ]
        runbooks_dir = Path.home() / ".turtle" / "runbooks"

        def _git_sync(*args: str) -> tuple[int, str]:
            r = _sp_sy.run(["git"] + list(args), capture_output=True, text=True, cwd=sync_repo)
            return r.returncode, r.stdout.strip() + r.stderr.strip()

        if not sync_repo.exists():
            if not remote:
                return response("sync_push", {"status": "error", "message": "No sync repo yet. Run turtle-sync push --remote <URL>"})
            sync_repo.mkdir(parents=True)
            _git_sync("init")
            if remote:
                _git_sync("remote", "add", "origin", remote)

        # Copy files into sync repo
        synced = []
        for f in sync_files:
            if f.exists():
                import shutil as _sh2
                _sh2.copy2(f, sync_repo / f.name)
                synced.append(f.name)

        if runbooks_dir.exists():
            import shutil as _sh3
            rb_dest = sync_repo / "runbooks"
            rb_dest.mkdir(exist_ok=True)
            for rb in runbooks_dir.glob("*.yaml"):
                _sh3.copy2(rb, rb_dest / rb.name)
            synced.append("runbooks/")

        _git_sync("add", "-A")
        rc, out = _git_sync("commit", "-m", f"turtle-sync: {__import__('datetime').datetime.utcnow().strftime('%Y-%m-%d %H:%M')}")
        if rc != 0 and "nothing to commit" in out:
            return response("sync_push", {"status": "ok", "status_detail": "up-to-date", "files": synced})

        if remote or _git_sync("remote", "get-url", "origin")[0] == 0:
            push_rc, push_out = _git_sync("push", "-u", "origin", "main", "--force")
            if push_rc != 0:
                # try master
                _git_sync("push", "-u", "origin", "master", "--force")

        return response("sync_push", {"status": "ok", "status_detail": "pushed", "files": synced})

    if action in ("sync_pull", "sync-pull"):
        import subprocess as _sp_sp
        config_dir = Path.home() / ".config" / "turtleterm"
        sync_repo  = config_dir / "sync"
        if not sync_repo.exists():
            return response("sync_pull", {"status": "error", "message": "No sync repo. Run turtle-sync push --remote <URL> first."})

        def _git_sp(*args: str) -> tuple[int, str]:
            r = _sp_sp.run(["git"] + list(args), capture_output=True, text=True, cwd=sync_repo)
            return r.returncode, r.stdout.strip()

        rc, out = _git_sp("pull", "--rebase", "origin", "HEAD")
        if rc != 0:
            return response("sync_pull", {"status": "error", "message": out})

        # Copy files back
        import shutil as _sh_pull
        pulled = []
        for f in sync_repo.iterdir():
            if f.is_file() and f.suffix in (".json", ".txt", ".yaml"):
                _sh_pull.copy2(f, config_dir / f.name)
                pulled.append(f.name)
        rb_src = sync_repo / "runbooks"
        if rb_src.exists():
            rb_dest = Path.home() / ".turtle" / "runbooks"
            rb_dest.mkdir(parents=True, exist_ok=True)
            for rb in rb_src.glob("*.yaml"):
                _sh_pull.copy2(rb, rb_dest / rb.name)
            pulled.append("runbooks/")

        return response("sync_pull", {"status": "ok", "files": pulled, "output": out})

    # ------------------------------------------------------------------
    # G14: Voice to Shell
    # ------------------------------------------------------------------
    if action in ("voice_to_shell", "voice-to-shell"):
        import subprocess as _sp_v, shutil as _sh_v, tempfile as _tf_v
        duration = int(request.get("duration", 4))

        # Check sox available
        if not _sh_v.which("sox"):
            return response("voice_to_shell", {
                "status": "unavailable",
                "hint": "Install: brew install sox whisper-cpp",
                "transcript": "",
                "command": "",
            })

        # Record audio
        with _tf_v.NamedTemporaryFile(suffix=".wav", delete=False) as tmp_wav:
            wav_path = tmp_wav.name

        try:
            rec_r = _sp_v.run(
                ["sox", "-d", "-r", "16000", "-c", "1", "-b", "16", wav_path, "trim", "0", str(duration)],
                capture_output=True, timeout=duration + 5,
            )
            if rec_r.returncode != 0:
                return response("voice_to_shell", {"status": "unavailable", "hint": "sox recording failed", "transcript": "", "command": ""})

            # Try whisper.cpp (offline, fast)
            transcript = ""
            if _sh_v.which("whisper-cpp") or _sh_v.which("whisper"):
                model_paths = [
                    Path.home() / ".local" / "share" / "whisper" / "ggml-base.en.bin",
                    Path.home() / ".local" / "share" / "whisper" / "ggml-tiny.en.bin",
                    Path("/usr/local/share/whisper/ggml-base.en.bin"),
                ]
                model = next((str(p) for p in model_paths if p.exists()), None)
                whisper_bin = _sh_v.which("whisper-cpp") or _sh_v.which("whisper")
                if model and whisper_bin:
                    wh_r = _sp_v.run(
                        [whisper_bin, "-m", model, "-f", wav_path, "-otxt", "-of", wav_path + "_out"],
                        capture_output=True, text=True, timeout=30,
                    )
                    out_file = Path(wav_path + "_out.txt")
                    if out_file.exists():
                        transcript = out_file.read_text().strip()
                        out_file.unlink(missing_ok=True)
                    elif wh_r.stdout:
                        # parse from stdout
                        import re as _re_v
                        m = _re_v.search(r'\] (.+)', wh_r.stdout)
                        transcript = m.group(1).strip() if m else wh_r.stdout.strip()[:200]

            # Fallback: use macOS Dictation via osascript
            if not transcript:
                r_dict = _sp_v.run(
                    ["osascript", "-e", 'tell application "System Events" to keystroke "d" using {command down}'],
                    capture_output=True, timeout=3,
                )
                return response("voice_to_shell", {
                    "status": "dictation_triggered",
                    "hint": "macOS Dictation triggered. Install whisper-cpp for offline transcription.",
                    "transcript": "",
                    "command": "",
                })

            if not transcript:
                return response("voice_to_shell", {"status": "no_speech", "transcript": "", "command": ""})

            # Convert transcript → shell command
            system = (
                "Convert the following spoken natural language to a shell command. "
                "Return ONLY the raw shell command, no explanation, no backticks."
            )
            ai = _claude_chat(transcript, system=system, timeout=10)
            command = (ai.get("response") or "").strip().strip("`") if ai else ""

        finally:
            Path(wav_path).unlink(missing_ok=True)

        return response("voice_to_shell", {
            "status": "ok",
            "transcript": transcript,
            "command": command,
        })

    # ------------------------------------------------------------------
    # T1-A: Cross-Session AI Memory
    # ------------------------------------------------------------------
    if action in ("memory_add", "memory-add"):
        key   = request.get("key", "").strip()
        value = request.get("value", "").strip()
        tags  = request.get("tags", [])
        if not key or not value:
            return response("memory_add", {"saved": False, "reason": "key and value required"})
        mem_path = Path.home() / ".config" / "turtleterm" / "memories.json"
        mem_path.parent.mkdir(parents=True, exist_ok=True)
        mems = []
        if mem_path.exists():
            try: mems = json.loads(mem_path.read_text())
            except: mems = []
        # Update existing key or append
        for m in mems:
            if m.get("key") == key:
                m["value"] = value
                m["tags"]  = tags
                m["updated"] = __import__('datetime').datetime.utcnow().isoformat()
                break
        else:
            mems.append({"key": key, "value": value, "tags": tags,
                         "created": __import__('datetime').datetime.utcnow().isoformat()})
        mems = mems[-200:]  # cap at 200 memories
        mem_path.write_text(json.dumps(mems, indent=2))
        return response("memory_add", {"saved": True, "total": len(mems), "key": key})

    if action in ("memory_list", "memory-list"):
        query = request.get("query", "").lower().strip()
        tags  = request.get("tags", [])
        limit = int(request.get("limit", 20))
        mem_path = Path.home() / ".config" / "turtleterm" / "memories.json"
        mems = []
        if mem_path.exists():
            try: mems = json.loads(mem_path.read_text())
            except: mems = []
        if query:
            mems = [m for m in mems if query in m.get("key","").lower() or query in m.get("value","").lower()]
        if tags:
            mems = [m for m in mems if any(t in m.get("tags",[]) for t in tags)]
        return response("memory_list", {"memories": mems[-limit:], "total": len(mems)})

    if action in ("memory_forget", "memory-forget"):
        key = request.get("key", "").strip()
        mem_path = Path.home() / ".config" / "turtleterm" / "memories.json"
        if not mem_path.exists():
            return response("memory_forget", {"removed": False, "reason": "no memories"})
        try: mems = json.loads(mem_path.read_text())
        except: mems = []
        before = len(mems)
        mems = [m for m in mems if m.get("key") != key]
        mem_path.write_text(json.dumps(mems, indent=2))
        return response("memory_forget", {"removed": len(mems) < before, "remaining": len(mems)})

    if action in ("memory_search", "memory-search"):
        query = request.get("query", "").strip()
        limit = int(request.get("limit", 5))
        mem_path = Path.home() / ".config" / "turtleterm" / "memories.json"
        mems = []
        if mem_path.exists():
            try: mems = json.loads(mem_path.read_text())
            except: mems = []
        if not mems:
            return response("memory_search", {"memories": [], "total": 0})
        if not query:
            return response("memory_search", {"memories": mems[-limit:], "total": len(mems)})
        # Simple relevance: count query word hits in key+value
        scored = []
        words = query.lower().split()
        for m in mems:
            text = (m.get("key","") + " " + m.get("value","")).lower()
            score = sum(1 for w in words if w in text)
            if score > 0:
                scored.append((score, m))
        scored.sort(key=lambda x: x[0], reverse=True)
        return response("memory_search", {"memories": [m for _, m in scored[:limit]], "total": len(scored)})

    # ------------------------------------------------------------------
    # T1-B: Custom AI Persona
    # ------------------------------------------------------------------
    if action in ("persona_set", "persona-set"):
        persona = request.get("persona", {})
        if not persona:
            # Accept flat params too
            persona = {k: v for k, v in request.items()
                       if k not in ("action", "session_id") and v}
        p_path = Path.home() / ".config" / "turtleterm" / "persona.json"
        p_path.parent.mkdir(parents=True, exist_ok=True)
        existing = {}
        if p_path.exists():
            try: existing = json.loads(p_path.read_text())
            except: existing = {}
        existing.update(persona)
        existing["updated"] = __import__('datetime').datetime.utcnow().isoformat()
        p_path.write_text(json.dumps(existing, indent=2))
        return response("persona_set", {"saved": True, "persona": existing})

    if action in ("persona_get", "persona-get"):
        p_path = Path.home() / ".config" / "turtleterm" / "persona.json"
        if not p_path.exists():
            return response("persona_get", {"persona": {}, "exists": False})
        try:
            persona = json.loads(p_path.read_text())
        except Exception:
            persona = {}
        return response("persona_get", {"persona": persona, "exists": bool(persona)})

    # ------------------------------------------------------------------
    # T2-A: AI Workflow Template Detection
    # ------------------------------------------------------------------
    if action in ("workflow_detect", "workflow-detect"):
        session_id = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID", "")
        threshold  = int(request.get("threshold", 3))
        events = read_ndjson(event_stream_path(), limit=500)
        if session_id:
            events = [e for e in events if e.get("session_id") == session_id]
        completed = [e.get("command","").strip() for e in events if e.get("event_type") == "command.completed" and e.get("command")]
        if len(completed) < threshold * 2:
            return response("workflow_detect", {"patterns": [], "message": "Not enough history yet"})

        # Detect repeated n-grams (sequences of 2-4 commands that appear >= threshold times)
        from collections import Counter as _Ctr
        patterns: list[dict] = []
        for n in (4, 3, 2):
            ngrams = [tuple(completed[i:i+n]) for i in range(len(completed)-n+1)]
            counts = _Ctr(ngrams)
            for seq, cnt in counts.most_common(5):
                if cnt >= threshold:
                    patterns.append({"commands": list(seq), "count": cnt, "n": n})
            if patterns:
                break

        if not patterns:
            return response("workflow_detect", {"patterns": [], "message": "No repeated patterns detected"})

        # AI-generate runbook for top pattern
        top = patterns[0]
        cmds_text = "\n".join(f"  - {c}" for c in top["commands"])
        _persona = _load_persona_system()
        _mems    = _load_memories_context()
        _prefix  = "\n\n".join(x for x in [_persona, _mems] if x)
        ai = _claude_chat(
            f"This sequence of shell commands was repeated {top['count']} times:\n{cmds_text}\n\n"
            "Generate a YAML runbook for TurtleTerm. Format:\n"
            "name: <short-name>\ndescription: <one line>\nsteps:\n  - name: <step>\n    command: <cmd>\n",
            system=(_prefix + "\n\n" if _prefix else "") + "You are a DevOps automation expert. Generate a clean YAML runbook. No markdown fences.",
            timeout=12,
        )
        suggested_runbook = (ai.get("response") or "").strip() if ai else ""
        return response("workflow_detect", {
            "patterns": patterns,
            "top_pattern": top,
            "suggested_runbook": suggested_runbook,
        })

    if action in ("workflow_save", "workflow-save"):
        name    = request.get("name", "workflow").strip().replace(" ", "-").lower()
        content = request.get("content", "").strip()
        if not content:
            return response("workflow_save", {"saved": False, "reason": "no content"})
        rb_dir = Path.home() / ".turtle" / "runbooks"
        rb_dir.mkdir(parents=True, exist_ok=True)
        rb_path = rb_dir / f"{name}.yaml"
        rb_path.write_text(content)
        return response("workflow_save", {"saved": True, "path": str(rb_path), "name": name})

    # ------------------------------------------------------------------
    # T2-C: Inline File Tree
    # ------------------------------------------------------------------
    if action in ("file_tree", "file-tree"):
        import subprocess as _sp_ft  # noqa: F841
        cwd  = request.get("cwd", ".") or "."
        max_files = int(request.get("max", 200))
        show_hidden = bool(request.get("hidden", False))

        cwd_path = Path(cwd).expanduser().resolve()
        if not cwd_path.is_dir():
            return response("file_tree", {"files": [], "cwd": str(cwd_path), "error": "not a directory"})

        # Read .gitignore patterns
        gitignore_pats: set[str] = {"node_modules", ".git", "__pycache__", ".mypy_cache",
                                     "dist", "build", ".next", "target", ".cache", "venv", ".venv"}
        gi = cwd_path / ".gitignore"
        if gi.exists():
            for line in gi.read_text().splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    gitignore_pats.add(line.strip("/"))

        files: list[dict] = []
        def _walk(d: Path, prefix: str, depth: int) -> None:
            if depth > 5 or len(files) >= max_files:
                return
            try:
                entries = sorted(d.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower()))
            except PermissionError:
                return
            for entry in entries:
                if not show_hidden and entry.name.startswith("."):
                    continue
                if entry.name in gitignore_pats:
                    continue
                rel = str(entry.relative_to(cwd_path))
                is_dir = entry.is_dir()
                files.append({"path": rel, "name": entry.name, "is_dir": is_dir,
                               "prefix": prefix, "depth": depth})
                if is_dir:
                    _walk(entry, prefix + "  ", depth + 1)
                if len(files) >= max_files:
                    return

        _walk(cwd_path, "", 0)
        return response("file_tree", {"files": files, "cwd": str(cwd_path), "count": len(files)})

    # ------------------------------------------------------------------
    # T2-D: Command Performance Tracking
    # ------------------------------------------------------------------
    if action in ("perf_record", "perf-record"):
        cmd      = request.get("command", "").strip()
        wall_ms  = int(request.get("wall_ms", 0))
        exit_code= int(request.get("exit_code", 0))
        cwd      = request.get("cwd", "")
        if not cmd:
            return response("perf_record", {"recorded": False})
        perf_path = Path.home() / ".config" / "turtleterm" / "perf.ndjson"
        perf_path.parent.mkdir(parents=True, exist_ok=True)
        record = {
            "ts": __import__('datetime').datetime.utcnow().isoformat(),
            "command": cmd, "wall_ms": wall_ms,
            "exit_code": exit_code, "cwd": cwd,
        }
        with open(perf_path, "a") as fh:
            fh.write(json.dumps(record) + "\n")
        return response("perf_record", {"recorded": True})

    if action in ("perf_stats", "perf-stats"):
        limit = int(request.get("limit", 500))
        perf_path = Path.home() / ".config" / "turtleterm" / "perf.ndjson"
        if not perf_path.exists():
            return response("perf_stats", {"records": [], "slowest": [], "avg_ms": 0, "total": 0})
        records = []
        for line in perf_path.read_text().splitlines()[-limit:]:
            try: records.append(json.loads(line))
            except: pass
        if not records:
            return response("perf_stats", {"records": [], "slowest": [], "avg_ms": 0, "total": 0})
        avg_ms = sum(r.get("wall_ms",0) for r in records) // len(records)
        slowest = sorted(records, key=lambda r: r.get("wall_ms",0), reverse=True)[:10]
        return response("perf_stats", {
            "records": records[-20:],
            "slowest": slowest,
            "avg_ms": avg_ms,
            "total": len(records),
        })

    # ------------------------------------------------------------------
    # T2-E: Output Export
    # ------------------------------------------------------------------
    if action in ("output_export", "output-export"):
        content  = request.get("content", "").strip()
        fmt      = request.get("format", "markdown")  # markdown|json|html|gist
        filename = request.get("filename", "turtle-output")
        if not content:
            return response("output_export", {"exported": False, "reason": "no content"})

        import tempfile as _tf_oe, subprocess as _sp_oe  # noqa: F401
        out_path = ""

        if fmt == "markdown":
            out_path = str(Path.home() / "Desktop" / f"{filename}.md")
            Path(out_path).write_text(f"# Terminal Output\n\n```\n{content}\n```\n")
        elif fmt == "json":
            out_path = str(Path.home() / "Desktop" / f"{filename}.json")
            Path(out_path).write_text(json.dumps({"output": content, "exported_at": __import__('datetime').datetime.utcnow().isoformat()}, indent=2))
        elif fmt == "html":
            html = (
                "<!DOCTYPE html><html><head><meta charset='utf-8'>"
                "<style>body{background:#0f0f0f;color:#e8e8e8;font-family:monospace;padding:20px}"
                "pre{white-space:pre-wrap;word-wrap:break-word}</style></head>"
                f"<body><pre>{content.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;')}</pre></body></html>"
            )
            out_path = str(Path.home() / "Desktop" / f"{filename}.html")
            Path(out_path).write_text(html)
        elif fmt == "gist":
            r = _gitea("gists", method="POST", payload={"description": f"TurtleTerm export: {filename}", "public": False, "files": {f"{filename}.txt": {"content": content}}})
            if r.get("ok"):
                g = r.get("data", {})
                return response("output_export", {"exported": True, "format": "gitea_snippet", "url": g.get("html_url"), "path": ""})
            # GitHub fallback
            gh_token = env("GITHUB_TOKEN", "")
            if not gh_token:
                return response("output_export", {"exported": False, "reason": "GITEA_URL not set and GITHUB_TOKEN not set"})
            import urllib.request as _ur_ge
            payload_bytes = json.dumps({"description": f"TurtleTerm export: {filename}", "public": False, "files": {f"{filename}.txt": {"content": content}}}).encode()
            req = _ur_ge.Request("https://api.github.com/gists", data=payload_bytes, headers={"Authorization": f"token {gh_token}", "Content-Type": "application/json", "User-Agent": "TurtleTerm"})
            try:
                with _ur_ge.urlopen(req, timeout=10) as resp:
                    g = json.loads(resp.read())
                    return response("output_export", {"exported": True, "format": "github_gist", "url": g.get("html_url"), "path": ""})
            except Exception as e:
                return response("output_export", {"exported": False, "reason": str(e)})
        else:
            return response("output_export", {"exported": False, "reason": f"unknown format: {fmt}"})

        return response("output_export", {"exported": True, "format": fmt, "path": out_path})

    # ------------------------------------------------------------------
    # T2-F: Output Search
    # ------------------------------------------------------------------
    if action in ("output_search", "output-search"):
        query = request.get("query", "").strip().lower()
        session_id = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID", "")
        limit = int(request.get("limit", 50))
        events = read_ndjson(event_stream_path(), limit=2000)
        if session_id:
            events = [e for e in events if e.get("session_id") == session_id]
        output_events = [e for e in events if e.get("event_type") in ("command.completed", "output.captured") and e.get("output")]
        results: list[dict] = []
        for e in output_events:
            out = e.get("output", "")
            cmd = e.get("command", "")
            if not query or query in out.lower() or query in cmd.lower():
                # Find matching line
                lines = out.splitlines()
                matching = [l for l in lines if query in l.lower()] if query else lines[:3]
                results.append({
                    "command": cmd,
                    "ts": e.get("ts", ""),
                    "matching_lines": matching[:5],
                    "output_preview": out[:200],
                    "exit_code": e.get("exit_code", 0),
                })
        return response("output_search", {"results": results[-limit:], "total": len(results), "query": query})

    # ------------------------------------------------------------------
    # T3-A: Lua Plugin Discovery
    # ------------------------------------------------------------------
    if action in ("plugin_list", "plugin-list"):
        plugin_dir = Path.home() / ".config" / "turtleterm" / "plugins"
        plugins: list[dict] = []
        if plugin_dir.exists():
            for f in sorted(plugin_dir.glob("*.lua")):
                # Parse name and description from first 5 lines
                lines = f.read_text().splitlines()[:5]
                desc = next((l.lstrip("-# ") for l in lines if l.strip().startswith("--")), "")
                plugins.append({"name": f.stem, "path": str(f), "description": desc})
        return response("plugin_list", {"plugins": plugins, "count": len(plugins), "plugin_dir": str(plugin_dir)})

    if action in ("plugin_install", "plugin-install"):
        name    = request.get("name", "").strip()
        content = request.get("content", "").strip()
        source  = request.get("source", "")  # URL or inline
        if not name:
            return response("plugin_install", {"installed": False, "reason": "name required"})
        plugin_dir = Path.home() / ".config" / "turtleterm" / "plugins"
        plugin_dir.mkdir(parents=True, exist_ok=True)
        if content:
            (plugin_dir / f"{name}.lua").write_text(content)
        elif source and source.startswith("https://"):
            import urllib.request as _ur_pi
            try:
                with _ur_pi.urlopen(source, timeout=10) as r:
                    (plugin_dir / f"{name}.lua").write_bytes(r.read())
            except Exception as e:
                return response("plugin_install", {"installed": False, "reason": str(e)})
        else:
            return response("plugin_install", {"installed": False, "reason": "provide content or https source"})
        return response("plugin_install", {"installed": True, "name": name, "path": str(plugin_dir / f"{name}.lua")})

    # ------------------------------------------------------------------
    # T3-B: Team Runbooks
    # ------------------------------------------------------------------
    if action in ("team_sync_pull", "team-sync-pull"):
        import subprocess as _sp_ts
        cfg_path = Path.home() / ".config" / "turtleterm" / "team.json"
        if not cfg_path.exists():
            return response("team_sync_pull", {"synced": False, "reason": "No team config. Set team_remote via team-config-set."})
        try: cfg = json.loads(cfg_path.read_text())
        except: cfg = {}
        remote = cfg.get("remote", "")
        if not remote:
            return response("team_sync_pull", {"synced": False, "reason": "No team remote configured"})
        team_rb_dir = Path.home() / ".turtle" / "team-runbooks"
        team_rb_dir.mkdir(parents=True, exist_ok=True)
        if (team_rb_dir / ".git").exists():
            r = _sp_ts.run(["git", "pull", "--rebase"], capture_output=True, text=True, cwd=team_rb_dir, timeout=20)
        else:
            r = _sp_ts.run(["git", "clone", "--depth=1", remote, str(team_rb_dir)], capture_output=True, text=True, timeout=30)
        pulled = list(team_rb_dir.glob("*.yaml"))
        return response("team_sync_pull", {"synced": r.returncode == 0, "runbooks": [f.name for f in pulled], "output": r.stdout.strip()[:300]})

    if action in ("team_runbook_list", "team-runbook-list"):
        personal_dir = Path.home() / ".turtle" / "runbooks"
        team_dir     = Path.home() / ".turtle" / "team-runbooks"
        personal = [{"name": f.stem, "source": "personal", "path": str(f)}
                    for f in sorted(personal_dir.glob("*.yaml"))] if personal_dir.exists() else []
        team     = [{"name": f.stem, "source": "team",     "path": str(f)}
                    for f in sorted(team_dir.glob("*.yaml"))]     if team_dir.exists()     else []
        return response("team_runbook_list", {"runbooks": personal + team, "personal": len(personal), "team": len(team)})

    if action in ("team_config_set", "team-config-set"):
        cfg_path = Path.home() / ".config" / "turtleterm" / "team.json"
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        existing = {}
        if cfg_path.exists():
            try: existing = json.loads(cfg_path.read_text())
            except: pass
        for k in ("remote", "org", "token"):
            if k in request:
                existing[k] = request[k]
        cfg_path.write_text(json.dumps(existing, indent=2))
        return response("team_config_set", {"saved": True, "config": existing})

    # ------------------------------------------------------------------
    # T3-C: SFTP Browser
    # ------------------------------------------------------------------
    if action in ("sftp_browse", "sftp-browse"):
        import subprocess as _sp_sftp
        host = request.get("host", "").strip()
        path = request.get("path", "/").strip() or "/"
        if not host:
            return response("sftp_browse", {"files": [], "error": "host required"})
        # Use ssh + ls -la for compatibility (no sftp binary needed)
        r = _sp_sftp.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, f"ls -la {path}"],
            capture_output=True, text=True, timeout=15,
        )
        if r.returncode != 0:
            return response("sftp_browse", {"files": [], "error": r.stderr.strip()[:200], "host": host})
        files: list[dict] = []
        for line in r.stdout.splitlines()[1:]:  # skip "total N"
            parts = line.split(None, 8)
            if len(parts) < 9:
                continue
            name = parts[8]
            if name in (".", ".."):
                continue
            files.append({
                "name": name,
                "perms": parts[0],
                "size": parts[4],
                "is_dir": parts[0].startswith("d"),
                "path": path.rstrip("/") + "/" + name,
            })
        return response("sftp_browse", {"files": files, "host": host, "path": path, "count": len(files)})

    if action in ("sftp_download", "sftp-download"):
        import subprocess as _sp_sfd
        host      = request.get("host", "").strip()
        remote    = request.get("remote_path", "").strip()
        local_dir = Path(request.get("local_dir", str(Path.home() / "Downloads"))).expanduser()
        if not host or not remote:
            return response("sftp_download", {"downloaded": False, "error": "host and remote_path required"})
        local_dir.mkdir(parents=True, exist_ok=True)
        r = _sp_sfd.run(
            ["scp", "-o", "BatchMode=yes", f"{host}:{remote}", str(local_dir)],
            capture_output=True, text=True, timeout=60,
        )
        local_name = Path(remote).name
        return response("sftp_download", {
            "downloaded": r.returncode == 0,
            "local_path": str(local_dir / local_name),
            "error": r.stderr.strip()[:200] if r.returncode != 0 else "",
        })

    # ------------------------------------------------------------------
    # T3-E: Persona Marketplace
    # ------------------------------------------------------------------
    if action in ("persona_marketplace_list", "persona-marketplace-list"):
        import urllib.request as _ur_pm
        # Community personas hosted as GitHub Gist index (public JSON)
        index_url = "https://gist.githubusercontent.com/raw/turtleterm-personas/index.json"
        builtins = [
            {"id": "devops", "name": "DevOps Engineer", "description": "Terraform, K8s, CI/CD focus", "builtin": True},
            {"id": "ml-researcher", "name": "ML Researcher", "description": "PyTorch, Jupyter, arXiv focus", "builtin": True},
            {"id": "sre", "name": "SRE", "description": "Incident response, observability, reliability", "builtin": True},
            {"id": "security", "name": "Security Engineer", "description": "OWASP, CVE, pen-test idioms", "builtin": True},
            {"id": "fullstack", "name": "Fullstack Dev", "description": "React+Node, Postgres, REST/GraphQL", "builtin": True},
        ]
        community: list = []
        try:
            with _ur_pm.urlopen(index_url, timeout=5) as r:
                community = json.loads(r.read()).get("personas", [])
        except Exception:
            pass  # offline — show builtins only
        return response("persona_marketplace_list", {
            "personas": builtins + community,
            "builtin_count": len(builtins),
            "community_count": len(community),
        })

    if action in ("persona_marketplace_install", "persona-marketplace-install"):
        persona_id = request.get("id", "").strip()
        BUILTIN_PERSONAS: dict[str, dict] = {
            "devops": {
                "role": "DevOps Engineer",
                "stack": "Terraform, Kubernetes, Docker, GitHub Actions, AWS/GCP",
                "style": "infrastructure-as-code, immutable deployments, GitOps",
                "preferred_tools": "kubectl, terraform, helm, aws-cli",
                "notes": "Prefer declarative configs. Always think about rollback.",
            },
            "ml-researcher": {
                "role": "ML Researcher",
                "stack": "Python, PyTorch, Jupyter, HuggingFace, wandb",
                "style": "reproducible experiments, clean notebooks, clear metrics",
                "preferred_tools": "jupyter, pytest, black, ruff",
                "notes": "Citation-aware. Prefer open datasets. arXiv first.",
            },
            "sre": {
                "role": "Site Reliability Engineer",
                "stack": "Go, Python, Prometheus, Grafana, PagerDuty, k8s",
                "style": "defensive, error-budget thinking, blameless postmortems",
                "preferred_tools": "kubectl, promtool, ab, hey, gcloud",
                "notes": "SLO-driven. Always think about blast radius and rollback.",
            },
            "security": {
                "role": "Security Engineer",
                "stack": "Python, Bash, Burp Suite, nmap, Semgrep",
                "style": "threat-model first, least privilege, defense in depth",
                "preferred_tools": "semgrep, trivy, grype, nmap",
                "notes": "OWASP Top 10 always in mind. Check for SSRF, injection, secrets.",
            },
            "fullstack": {
                "role": "Full-stack Developer",
                "stack": "TypeScript, React, Node.js, PostgreSQL, GraphQL",
                "style": "typed, tested, component-first, schema-first APIs",
                "preferred_tools": "pnpm, prisma, vitest, eslint, prettier",
                "notes": "Prefer functional components. Zod for validation. tRPC when possible.",
            },
        }
        if persona_id not in BUILTIN_PERSONAS:
            return response("persona_marketplace_install", {"installed": False, "reason": f"unknown persona: {persona_id}. Use persona-marketplace-list to see available."})
        persona = BUILTIN_PERSONAS[persona_id]
        p_path = Path.home() / ".config" / "turtleterm" / "persona.json"
        p_path.parent.mkdir(parents=True, exist_ok=True)
        persona["_source"] = f"marketplace:{persona_id}"
        persona["_installed"] = __import__('datetime').datetime.utcnow().isoformat()
        p_path.write_text(json.dumps(persona, indent=2))
        return response("persona_marketplace_install", {"installed": True, "persona": persona, "id": persona_id})

    # ------------------------------------------------------------------
    # Background Agent (run plans detached)
    # ------------------------------------------------------------------
    if action in ("bg_plan_start", "bg-plan-start"):
        goal   = request.get("goal", "").strip()
        notify = request.get("notify", True)
        if not goal:
            return response("bg_plan_start", {"started": False, "reason": "goal required"})
        import subprocess as _sp_bg, uuid as _uuid
        plan_id = str(_uuid.uuid4())[:8]
        log_path = Path.home() / ".config" / "turtleterm" / "bg_plans" / f"{plan_id}.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        state_path = log_path.with_suffix(".json")
        state = {"plan_id": plan_id, "goal": goal, "status": "running", "started": __import__('datetime').datetime.utcnow().isoformat(), "pid": None}
        state_path.write_text(json.dumps(state))
        # Spawn detached agentd process to execute the plan
        agentd_path = Path(__file__)
        proc = _sp_bg.Popen(
            [sys.executable, str(agentd_path), "--stdio"],
            stdin=_sp_bg.PIPE, stdout=open(log_path, "w"), stderr=_sp_bg.STDOUT,
            start_new_session=True,
        )
        payload = json.dumps({"action": "plan_execute", "goal": goal, "bg_plan_id": plan_id})
        try:
            proc.stdin.write(payload.encode())
            proc.stdin.close()
        except Exception:
            pass
        state["pid"] = proc.pid
        state_path.write_text(json.dumps(state))
        return response("bg_plan_start", {"started": True, "plan_id": plan_id, "goal": goal, "log": str(log_path), "pid": proc.pid})

    if action in ("bg_plan_list", "bg-plan-list"):
        bg_dir = Path.home() / ".config" / "turtleterm" / "bg_plans"
        plans = []
        if bg_dir.exists():
            for f in sorted(bg_dir.glob("*.json"), reverse=True)[:20]:
                try:
                    st = json.loads(f.read_text())
                    # Check if still running
                    pid = st.get("pid")
                    if pid and st.get("status") == "running":
                        import os as _os_bg
                        try:
                            _os_bg.kill(pid, 0)
                        except ProcessLookupError:
                            st["status"] = "completed"
                            f.write_text(json.dumps(st))
                    plans.append(st)
                except Exception:
                    pass
        return response("bg_plan_list", {"plans": plans, "count": len(plans)})

    if action in ("bg_plan_status", "bg-plan-status"):
        plan_id = request.get("plan_id", "").strip()
        bg_dir  = Path.home() / ".config" / "turtleterm" / "bg_plans"
        if not plan_id:
            # Return most recent
            states = sorted(bg_dir.glob("*.json"), reverse=True) if bg_dir.exists() else []
            if not states:
                return response("bg_plan_status", {"found": False})
            plan_id = states[0].stem
        state_path = bg_dir / f"{plan_id}.json"
        log_path   = bg_dir / f"{plan_id}.log"
        if not state_path.exists():
            return response("bg_plan_status", {"found": False, "plan_id": plan_id})
        st = json.loads(state_path.read_text())
        log_tail = ""
        if log_path.exists():
            lines = log_path.read_text().splitlines()
            log_tail = "\n".join(lines[-20:])
        return response("bg_plan_status", {**st, "log_tail": log_tail, "found": True})

    if action in ("bg_plan_cancel", "bg-plan-cancel"):
        plan_id = request.get("plan_id", "").strip()
        bg_dir  = Path.home() / ".config" / "turtleterm" / "bg_plans"
        state_path = bg_dir / f"{plan_id}.json"
        if not state_path.exists():
            return response("bg_plan_cancel", {"cancelled": False, "reason": "not found"})
        st = json.loads(state_path.read_text())
        pid = st.get("pid")
        if pid:
            import os as _os_bc, signal as _sig
            try:
                _os_bc.kill(pid, _sig.SIGTERM)
            except Exception:
                pass
        st["status"] = "cancelled"
        state_path.write_text(json.dumps(st))
        return response("bg_plan_cancel", {"cancelled": True, "plan_id": plan_id})

    # ------------------------------------------------------------------
    # Webhook Dispatcher (terminal events → any URL)
    # ------------------------------------------------------------------
    if action in ("webhook_add", "webhook-add"):
        url      = request.get("url", "").strip()
        events   = request.get("events", ["command.completed"])
        name     = request.get("name", url[:40])
        if not url or not url.startswith("http"):
            return response("webhook_add", {"added": False, "reason": "valid https:// URL required"})
        wh_path = Path.home() / ".config" / "turtleterm" / "webhooks.json"
        wh_path.parent.mkdir(parents=True, exist_ok=True)
        hooks = []
        if wh_path.exists():
            try: hooks = json.loads(wh_path.read_text())
            except: hooks = []
        hooks = [h for h in hooks if h.get("url") != url]  # deduplicate
        hooks.append({"url": url, "events": events, "name": name, "created": __import__('datetime').datetime.utcnow().isoformat()})
        wh_path.write_text(json.dumps(hooks, indent=2))
        return response("webhook_add", {"added": True, "total": len(hooks), "name": name})

    if action in ("webhook_list", "webhook-list"):
        wh_path = Path.home() / ".config" / "turtleterm" / "webhooks.json"
        hooks = []
        if wh_path.exists():
            try: hooks = json.loads(wh_path.read_text())
            except: hooks = []
        return response("webhook_list", {"webhooks": hooks, "count": len(hooks)})

    if action in ("webhook_remove", "webhook-remove"):
        url = request.get("url", "").strip()
        wh_path = Path.home() / ".config" / "turtleterm" / "webhooks.json"
        if not wh_path.exists():
            return response("webhook_remove", {"removed": False})
        hooks = [h for h in json.loads(wh_path.read_text()) if h.get("url") != url]
        wh_path.write_text(json.dumps(hooks, indent=2))
        return response("webhook_remove", {"removed": True, "remaining": len(hooks)})

    if action in ("webhook_dispatch", "webhook-dispatch"):
        event_type = request.get("event_type", "")
        event_data = request.get("data", {})
        wh_path = Path.home() / ".config" / "turtleterm" / "webhooks.json"
        if not wh_path.exists():
            return response("webhook_dispatch", {"dispatched": 0})
        try: hooks = json.loads(wh_path.read_text())
        except: hooks = []
        import urllib.request as _ur_wh, urllib.error as _ue_wh
        dispatched = 0
        errors = []
        for hook in hooks:
            if event_type and event_type not in hook.get("events", [event_type]):
                continue
            payload = json.dumps({"event": event_type, "data": event_data, "source": "turtleterm"}).encode()
            req = _ur_wh.Request(hook["url"], data=payload, headers={"Content-Type": "application/json", "User-Agent": "TurtleTerm/1.0"})
            try:
                with _ur_wh.urlopen(req, timeout=5) as r:
                    dispatched += 1
            except Exception as e:
                errors.append(str(e)[:80])
        return response("webhook_dispatch", {"dispatched": dispatched, "total_hooks": len(hooks), "errors": errors})

    # ------------------------------------------------------------------
    # Error Pattern Detection (proactive: "you've hit this 3 times today")
    # ------------------------------------------------------------------
    if action in ("error_patterns", "error-patterns"):
        session_id = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID", "")
        lookback   = int(request.get("lookback", 500))
        threshold  = int(request.get("threshold", 2))
        events = read_ndjson(event_stream_path(), limit=lookback)
        if session_id:
            events = [e for e in events if e.get("session_id") == session_id]
        # Gather failed commands (exit_code != 0)
        failed = [e for e in events if e.get("event_type") == "command.completed" and e.get("exit_code", 0) != 0]
        from collections import Counter as _Ctr_ep
        import re as _re_ep
        # Normalize errors: strip variable parts (paths, numbers, UUIDs)
        def _norm(s: str) -> str:
            s = _re_ep.sub(r'/[^\s]+', '/<path>', s)
            s = _re_ep.sub(r'\b[0-9]+\b', 'N', s)
            s = _re_ep.sub(r'[a-f0-9]{8,}', '<hash>', s)
            return s[:100]
        cmd_counts = _Ctr_ep(_norm(e.get("command","")) for e in failed)
        patterns = [{"pattern": p, "count": c, "recent_command": next((e.get("command","") for e in reversed(failed) if _norm(e.get("command","")) == p), "")}
                    for p, c in cmd_counts.most_common(5) if c >= threshold]
        # AI fix suggestions for top pattern
        suggestions = []
        if patterns and env("ANTHROPIC_API_KEY"):
            top = patterns[0]
            _persona = _load_persona_system()
            _mems    = _load_memories_context()
            _prefix  = "\n\n".join(x for x in [_persona, _mems] if x)
            system = (_prefix + "\n\n" if _prefix else "") + (
                "You are a shell expert. The user keeps running a failing command. "
                "Provide a concise fix in under 2 sentences."
            )
            ai = _claude_chat(f"Failing command (run {top['count']} times): {top['recent_command']}", system=system, timeout=10)
            if ai:
                suggestions.append({"pattern": top["pattern"], "fix": (ai.get("response") or "").strip()[:300]})
        return response("error_patterns", {"patterns": patterns, "total_failures": len(failed), "suggestions": suggestions})

    # ------------------------------------------------------------------
    # Agent Scratchpad (persistent AI-readable notes)
    # ------------------------------------------------------------------
    if action in ("scratchpad_write", "scratchpad-write"):
        content   = request.get("content", "").strip()
        key       = request.get("key", "default").strip() or "default"
        append    = bool(request.get("append", False))
        sp_dir    = Path.home() / ".config" / "turtleterm" / "scratchpad"
        sp_dir.mkdir(parents=True, exist_ok=True)
        sp_file   = sp_dir / f"{key}.md"
        if append and sp_file.exists():
            existing = sp_file.read_text()
            sp_file.write_text(existing + "\n\n" + content)
        else:
            sp_file.write_text(content)
        return response("scratchpad_write", {"saved": True, "key": key, "path": str(sp_file), "size": sp_file.stat().st_size})

    if action in ("scratchpad_read", "scratchpad-read"):
        key    = request.get("key", "default").strip() or "default"
        sp_dir = Path.home() / ".config" / "turtleterm" / "scratchpad"
        sp_file = sp_dir / f"{key}.md"
        if not sp_file.exists():
            return response("scratchpad_read", {"content": "", "exists": False, "key": key})
        content = sp_file.read_text()
        return response("scratchpad_read", {"content": content, "exists": True, "key": key, "size": len(content)})

    if action in ("scratchpad_list", "scratchpad-list"):
        sp_dir = Path.home() / ".config" / "turtleterm" / "scratchpad"
        pads = []
        if sp_dir.exists():
            for f in sorted(sp_dir.glob("*.md")):
                pads.append({"key": f.stem, "path": str(f), "size": f.stat().st_size,
                             "preview": f.read_text()[:80].replace("\n", " ")})
        return response("scratchpad_list", {"pads": pads, "count": len(pads)})

    # ------------------------------------------------------------------
    # Policy Engine (YAML rules — block/warn/allow)
    # ------------------------------------------------------------------
    if action in ("policy_check", "policy-check"):
        command  = request.get("command", "").strip()
        cwd      = request.get("cwd", ".") or "."
        if not command:
            return response("policy_check", {"allowed": True, "verdict": "allow", "rules_checked": 0})
        import re as _re_pol
        # Find .turtle/policy.yaml walking up from cwd
        policy: list[dict] = []
        p = Path(cwd).expanduser().resolve()
        for _ in range(8):
            pf = p / ".turtle" / "policy.yaml"
            if pf.exists():
                try:
                    import subprocess as _sp_pol
                    r = _sp_pol.run(["python3", "-c", f"import yaml,json,sys; print(json.dumps(yaml.safe_load(open({str(pf)!r}))))"], capture_output=True, text=True, timeout=3)
                    if r.returncode == 0:
                        data = json.loads(r.stdout)
                        policy = data.get("rules", []) if isinstance(data, dict) else []
                except Exception:
                    pass
                break
            parent = p.parent
            if parent == p:
                break
            p = parent
        if not policy:
            return response("policy_check", {"allowed": True, "verdict": "allow", "rules_checked": 0, "policy_file": None})
        verdict = "allow"
        matched_rule = None
        for rule in policy:
            pattern = rule.get("pattern", "")
            if not pattern:
                continue
            try:
                if _re_pol.search(pattern, command, _re_pol.IGNORECASE):
                    verdict = rule.get("action", "warn")
                    matched_rule = rule
                    break
            except _re_pol.error:
                if pattern.lower() in command.lower():
                    verdict = rule.get("action", "warn")
                    matched_rule = rule
                    break
        return response("policy_check", {
            "allowed": verdict == "allow",
            "verdict": verdict,
            "matched_rule": matched_rule,
            "rules_checked": len(policy),
            "command": command,
            "reason": (matched_rule or {}).get("reason", ""),
        })

    # ------------------------------------------------------------------
    # Pre-commit Hook Installer
    # ------------------------------------------------------------------
    if action in ("install_hooks", "install-hooks"):
        cwd      = request.get("cwd", ".") or "."
        hooks    = request.get("hooks", ["secrets", "shellcheck", "policy"])
        cwd_path = Path(cwd).expanduser().resolve()
        git_dir  = cwd_path / ".git"
        if not git_dir.exists():
            return response("install_hooks", {"installed": False, "reason": f"Not a git repo: {cwd_path}"})
        hooks_dir = git_dir / "hooks"
        hooks_dir.mkdir(exist_ok=True)
        hook_path = hooks_dir / "pre-commit"
        agentctl_bin = str(Path(__file__).parent / "turtle-agentctl")
        checks = []
        if "secrets" in hooks:
            checks.append(f'''
# TurtleTerm: Detect secrets before commit
echo "🐢 TurtleTerm: scanning for secrets..."
git diff --cached --unified=0 | python3 "{agentctl_bin}" --stdio detect-secrets - 2>/dev/null | python3 -c "
import sys,json
d=json.load(sys.stdin)
s=d.get('data',{{}}).get('secrets',[])
if s:
    print('\\033[31m✗ Secrets detected - commit blocked:\\033[0m')
    for sec in s: print(' ', sec.get('type','?'), ':', sec.get('match','')[:40])
    sys.exit(1)
" || exit 1
''')
        if "shellcheck" in hooks:
            checks.append(f'''
# TurtleTerm: Shellcheck on staged .sh files
for f in $(git diff --cached --name-only --diff-filter=ACM | grep '\\.sh$'); do
  python3 "{agentctl_bin}" --stdio shellcheck-lint "$(cat $f)" 2>/dev/null | python3 -c "
import sys,json
d=json.load(sys.stdin)
issues=d.get('data',{{}}).get('issues',[])
if issues:
    print(f'\\033[33m⚠ Shellcheck: $f has {{len(issues)}} issue(s)\\033[0m')
    for i in issues[:3]: print('  L'+str(i.get('line','?'))+': '+str(i.get('message',''))[:80])
" 2>/dev/null
done
''')
        if "policy" in hooks:
            checks.append(f'''
# TurtleTerm: Policy check on commit message
# (Extend: add your .turtle/policy.yaml rules)
''')
        script = "#!/bin/sh\n# TurtleTerm pre-commit hooks (auto-generated — do not edit)\n" + "\n".join(checks) + "\nexit 0\n"
        hook_path.write_text(script)
        hook_path.chmod(0o755)
        return response("install_hooks", {"installed": True, "path": str(hook_path), "hooks": hooks, "cwd": str(cwd_path)})

    if action in ("uninstall_hooks", "uninstall-hooks"):
        cwd = request.get("cwd", ".") or "."
        hook_path = Path(cwd).expanduser().resolve() / ".git" / "hooks" / "pre-commit"
        if not hook_path.exists():
            return response("uninstall_hooks", {"removed": False, "reason": "no hook found"})
        content = hook_path.read_text()
        if "TurtleTerm" not in content:
            return response("uninstall_hooks", {"removed": False, "reason": "hook not managed by TurtleTerm"})
        hook_path.unlink()
        return response("uninstall_hooks", {"removed": True, "path": str(hook_path)})

    # ------------------------------------------------------------------
    # Gitea forge actions
    # ------------------------------------------------------------------
    if action in ("gitea_status", "gitea-status"):
        r = _gitea("version")
        if not r.get("ok"):
            return response("gitea_status", {"online": False, "error": r.get("error", ""), "gitea_url": env("GITEA_URL", "")})
        ver = r.get("data", {}).get("version", "?")
        # Get current user
        me = _gitea("user")
        user = me.get("data", {}).get("login", "?") if me.get("ok") else "?"
        # Get orgs
        orgs_r = _gitea("admin/orgs?limit=5") if user != "?" else {"ok": False}
        orgs = [o.get("username") for o in orgs_r.get("data", [])] if orgs_r.get("ok") else []
        return response("gitea_status", {"online": True, "version": ver, "user": user, "orgs": orgs, "gitea_url": env("GITEA_URL", "")})

    if action in ("gitea_repo_list", "gitea-repo-list"):
        limit = int(request.get("limit", 20))
        r = _gitea(f"repos/search?limit={limit}&token={env('GITEA_TOKEN','')}")
        if not r.get("ok"):
            return response("gitea_repo_list", {"repos": [], "error": r.get("error", "")})
        repos = [{"name": x.get("name"), "full_name": x.get("full_name"), "private": x.get("private"), "stars": x.get("stars_count", 0), "updated": x.get("updated")} for x in r.get("data", {}).get("data", r.get("data", []))]
        return response("gitea_repo_list", {"repos": repos, "count": len(repos)})

    if action in ("gitea_pr_create", "gitea-pr-create"):
        cwd    = request.get("cwd", ".") or "."
        title  = request.get("title", "").strip()
        body   = request.get("body", "").strip()
        base   = request.get("base", "main")
        head   = request.get("head", "") or _git_module_level("rev-parse", "--abbrev-ref", "HEAD", cwd=cwd)
        owner, repo = _forge_owner_repo(cwd)
        if not owner or not repo:
            return response("gitea_pr_create", {"created": False, "reason": "could not determine owner/repo from git remote"})
        if not title:
            # AI-generate title from recent commits
            log = _git_module_level("log", "--oneline", "-5", cwd=cwd)
            _persona = _load_persona_system(); _mems = _load_memories_context()
            _prefix = "\n\n".join(x for x in [_persona, _mems] if x)
            system = (_prefix + "\n\n" if _prefix else "") + "Generate a concise PR title (under 72 chars) from these commits. Return ONLY the title."
            ai = _claude_chat(log, system=system, timeout=10)
            title = (ai.get("response") or "").strip()[:72] if ai else f"Changes from {head}"
        r = _gitea(f"repos/{owner}/{repo}/pulls", method="POST", payload={"title": title, "body": body, "head": head, "base": base})
        if r.get("ok"):
            pr = r.get("data", {})
            return response("gitea_pr_create", {"created": True, "number": pr.get("number"), "url": pr.get("html_url"), "title": title})
        return response("gitea_pr_create", {"created": False, "reason": r.get("error", "gitea error"), "status": r.get("status")})

    if action in ("gitea_pr_list", "gitea-pr-list"):
        cwd   = request.get("cwd", ".") or "."
        state = request.get("state", "open")
        owner, repo = _forge_owner_repo(cwd)
        if not owner:
            return response("gitea_pr_list", {"prs": [], "reason": "no remote"})
        r = _gitea(f"repos/{owner}/{repo}/pulls?state={state}&limit=20")
        prs = [{"number": p.get("number"), "title": p.get("title"), "state": p.get("state"), "url": p.get("html_url"), "user": p.get("user", {}).get("login"), "updated": p.get("updated_at")} for p in (r.get("data") or [])] if r.get("ok") else []
        return response("gitea_pr_list", {"prs": prs, "count": len(prs), "state": state})

    if action in ("gitea_issue_create", "gitea-issue-create"):
        cwd   = request.get("cwd", ".") or "."
        title = request.get("title", "").strip()
        body  = request.get("body", "").strip()
        labels = request.get("labels", [])
        owner, repo = _forge_owner_repo(cwd)
        if not owner:
            return response("gitea_issue_create", {"created": False, "reason": "no remote"})
        r = _gitea(f"repos/{owner}/{repo}/issues", method="POST", payload={"title": title, "body": body, "labels": labels})
        if r.get("ok"):
            iss = r.get("data", {})
            return response("gitea_issue_create", {"created": True, "number": iss.get("number"), "url": iss.get("html_url"), "title": title})
        return response("gitea_issue_create", {"created": False, "reason": r.get("error", "")})

    if action in ("gitea_release_create", "gitea-release-create"):
        cwd         = request.get("cwd", ".") or "."
        tag         = request.get("tag", "").strip()
        name        = request.get("name", tag)
        body        = request.get("body", "").strip()
        draft       = bool(request.get("draft", False))
        prerelease  = bool(request.get("prerelease", False))
        owner, repo = _forge_owner_repo(cwd)
        if not owner or not tag:
            return response("gitea_release_create", {"created": False, "reason": "owner/repo and tag required"})
        r = _gitea(f"repos/{owner}/{repo}/releases", method="POST", payload={"tag_name": tag, "name": name, "body": body, "draft": draft, "prerelease": prerelease})
        if r.get("ok"):
            rel = r.get("data", {})
            return response("gitea_release_create", {"created": True, "id": rel.get("id"), "tag": tag, "url": rel.get("html_url")})
        return response("gitea_release_create", {"created": False, "reason": r.get("error", "")})

    if action in ("gitea_snippet_create", "gitea-snippet-create"):
        # Gitea Gist-compatible endpoint
        content     = request.get("content", "").strip()
        description = request.get("description", "TurtleTerm export")
        filename    = request.get("filename", "export.txt")
        public      = bool(request.get("public", False))
        r = _gitea("gists", method="POST", payload={"description": description, "public": public, "files": {filename: {"content": content}}})
        if r.get("ok"):
            g = r.get("data", {})
            return response("gitea_snippet_create", {"created": True, "url": g.get("html_url"), "id": g.get("id")})
        # Fallback: GitHub gist
        gh_token = env("GITHUB_TOKEN", "")
        if gh_token:
            import urllib.request as _ur_gs
            payload = json.dumps({"description": description, "public": public, "files": {filename: {"content": content}}}).encode()
            req = _ur_gs.Request("https://api.github.com/gists", data=payload, headers={"Authorization": f"token {gh_token}", "Content-Type": "application/json", "User-Agent": "TurtleTerm"})
            try:
                with _ur_gs.urlopen(req, timeout=10) as resp:
                    g = json.loads(resp.read())
                    return response("gitea_snippet_create", {"created": True, "url": g.get("html_url"), "id": g.get("id"), "via": "github_fallback"})
            except Exception as e:
                return response("gitea_snippet_create", {"created": False, "reason": str(e)})
        return response("gitea_snippet_create", {"created": False, "reason": r.get("error", "no gitea or github token")})

    if action in ("gitea_ci_runs", "gitea-ci-runs"):
        cwd         = request.get("cwd", ".") or "."
        limit       = int(request.get("limit", 10))
        owner, repo = _forge_owner_repo(cwd)
        if not owner:
            return response("gitea_ci_runs", {"runs": [], "reason": "no remote"})
        r = _gitea(f"repos/{owner}/{repo}/actions/runs?limit={limit}")
        runs = []
        if r.get("ok"):
            for run in r.get("data", {}).get("workflow_runs", r.get("data", [])):
                runs.append({"id": run.get("id"), "name": run.get("name"), "status": run.get("status"), "conclusion": run.get("conclusion"), "event": run.get("event"), "created": run.get("created_at"), "updated": run.get("updated_at"), "url": run.get("html_url")})
        return response("gitea_ci_runs", {"runs": runs, "count": len(runs), "owner": owner, "repo": repo})

    if action in ("gitea_ci_watch", "gitea-ci-watch"):
        cwd         = request.get("cwd", ".") or "."
        run_id      = request.get("run_id", "")
        timeout_s   = int(request.get("timeout", 120))
        poll_s      = int(request.get("poll", 5))
        owner, repo = _forge_owner_repo(cwd)
        if not owner or not run_id:
            return response("gitea_ci_watch", {"done": False, "reason": "owner/repo and run_id required"})
        import time as _time_ci
        start = _time_ci.time()
        conclusion = None
        status     = "unknown"
        while _time_ci.time() - start < timeout_s:
            r = _gitea(f"repos/{owner}/{repo}/actions/runs/{run_id}")
            if r.get("ok"):
                run = r.get("data", {})
                status     = run.get("status", "unknown")
                conclusion = run.get("conclusion")
                if status in ("completed", "failure", "cancelled", "skipped"):
                    break
            _time_ci.sleep(poll_s)
        elapsed = int(_time_ci.time() - start)
        return response("gitea_ci_watch", {"done": True, "status": status, "conclusion": conclusion, "run_id": run_id, "elapsed_s": elapsed})

    # ------------------------------------------------------------------
    # Process Supervisor
    # ------------------------------------------------------------------
    if action in ("process_watch", "process-watch"):
        cmd        = request.get("command", "").strip()
        restart    = bool(request.get("restart", True))
        max_restarts = int(request.get("max_restarts", 5))
        log_lines  = int(request.get("log_lines", 20))
        timeout_s  = int(request.get("timeout", 300))
        if not cmd:
            return response("process_watch", {"started": False, "reason": "command required"})
        import subprocess as _sp_pw, time as _t_pw, threading as _thr_pw
        pw_dir = Path.home() / ".config" / "turtleterm" / "process_watch"
        pw_dir.mkdir(parents=True, exist_ok=True)
        import uuid as _uuid_pw
        wid = str(_uuid_pw.uuid4())[:8]
        log_path = pw_dir / f"{wid}.log"
        state_path = pw_dir / f"{wid}.json"
        state = {"wid": wid, "command": cmd, "restarts": 0, "status": "starting", "log": str(log_path)}
        state_path.write_text(json.dumps(state))

        def _run():
            restarts = 0
            with open(log_path, "w") as log_f:
                start = _t_pw.time()
                while _t_pw.time() - start < timeout_s and restarts <= max_restarts:
                    proc = _sp_pw.Popen(cmd, shell=True, stdout=log_f, stderr=log_f, start_new_session=True)
                    state["pid"] = proc.pid; state["status"] = "running"; state["restarts"] = restarts
                    state_path.write_text(json.dumps(state))
                    rc = proc.wait()
                    if rc == 0 or not restart:
                        state["status"] = "exited"; state["exit_code"] = rc
                        break
                    restarts += 1
                    log_f.write(f"\n--- restart {restarts}/{max_restarts} (exit {rc}) ---\n"); log_f.flush()
                    state["status"] = "restarting"; state["restarts"] = restarts
                    state_path.write_text(json.dumps(state))
                    _t_pw.sleep(min(2 ** restarts, 30))
                if restarts > max_restarts:
                    state["status"] = "max_restarts_exceeded"
                state_path.write_text(json.dumps(state))
        _thr_pw.Thread(target=_run, daemon=True).start()
        import time as _tw; _tw.sleep(0.3)
        return response("process_watch", {"started": True, "wid": wid, "log": str(log_path), "command": cmd})

    if action in ("process_watch_list", "process-watch-list"):
        pw_dir = Path.home() / ".config" / "turtleterm" / "process_watch"
        procs = []
        if pw_dir.exists():
            for f in sorted(pw_dir.glob("*.json"), reverse=True)[:20]:
                try: procs.append(json.loads(f.read_text()))
                except: pass
        return response("process_watch_list", {"processes": procs, "count": len(procs)})

    # ------------------------------------------------------------------
    # API Cost Tracker
    # ------------------------------------------------------------------
    if action in ("cost_record", "cost-record"):
        model     = request.get("model", "claude-sonnet-4-6")
        action_nm = request.get("action_name", "")
        in_tokens = int(request.get("input_tokens", 0))
        out_tokens= int(request.get("output_tokens", 0))
        # Pricing per 1M tokens (approximate Claude rates)
        PRICES = {"claude-opus-4-8": (15.0, 75.0), "claude-sonnet-4-6": (3.0, 15.0), "claude-haiku-4-5": (0.25, 1.25)}
        p_in, p_out = PRICES.get(model, (3.0, 15.0))
        cost_usd = (in_tokens / 1_000_000 * p_in) + (out_tokens / 1_000_000 * p_out)
        cost_path = Path.home() / ".config" / "turtleterm" / "cost.ndjson"
        import datetime as _dt_cost
        entry = {"ts": _dt_cost.datetime.utcnow().isoformat(), "model": model, "action": action_nm, "in": in_tokens, "out": out_tokens, "usd": round(cost_usd, 6)}
        with open(cost_path, "a") as f:
            f.write(json.dumps(entry) + "\n")
        return response("cost_record", {"recorded": True, "usd": entry["usd"], "total_tokens": in_tokens + out_tokens})

    if action in ("cost_stats", "cost-stats"):
        cost_path = Path.home() / ".config" / "turtleterm" / "cost.ndjson"
        if not cost_path.exists():
            return response("cost_stats", {"total_usd": 0.0, "total_calls": 0, "by_action": {}, "by_model": {}})
        entries = []
        for line in cost_path.read_text().splitlines():
            try: entries.append(json.loads(line))
            except: pass
        from collections import defaultdict as _dd
        total_usd   = sum(e.get("usd", 0) for e in entries)
        by_action   = _dd(float)
        by_model    = _dd(float)
        for e in entries:
            by_action[e.get("action", "?")] += e.get("usd", 0)
            by_model[e.get("model", "?")]   += e.get("usd", 0)
        top_actions = sorted(by_action.items(), key=lambda x: -x[1])[:5]
        return response("cost_stats", {
            "total_usd": round(total_usd, 4),
            "total_calls": len(entries),
            "by_model": {k: round(v, 4) for k, v in by_model.items()},
            "top_actions": [{"action": a, "usd": round(u, 4)} for a, u in top_actions],
            "entries_today": sum(1 for e in entries if e.get("ts", "")[:10] == __import__('datetime').date.today().isoformat()),
        })

    # ------------------------------------------------------------------
    # Cross-session Semantic History
    # ------------------------------------------------------------------
    if action in ("history_index", "history-index"):
        # Index all past NDJSON session files into a searchable flat index
        streams_dir = Path.home() / ".config" / "turtleterm"
        index_path  = streams_dir / "history_index.ndjson"
        indexed     = 0
        seen_cmds   = set()
        # Try to read existing index size
        existing_lines = index_path.read_text().splitlines() if index_path.exists() else []
        existing_count = len(existing_lines)
        with open(index_path, "a") as idx:
            for f in sorted(streams_dir.glob("events_*.ndjson")):
                for line in f.read_text().splitlines():
                    try:
                        e = json.loads(line)
                        if e.get("event_type") != "command.completed":
                            continue
                        cmd = e.get("command", "")
                        if not cmd or cmd in seen_cmds:
                            continue
                        seen_cmds.add(cmd)
                        entry = {"cmd": cmd, "exit": e.get("exit_code", 0), "ts": e.get("timestamp", ""), "out": (e.get("output_preview") or "")[:200], "src": f.name}
                        idx.write(json.dumps(entry) + "\n")
                        indexed += 1
                    except: pass
        return response("history_index", {"indexed": indexed, "total": existing_count + indexed, "index": str(index_path)})

    if action in ("history_search", "history-search"):
        query   = request.get("query", "").strip().lower()
        limit   = int(request.get("limit", 20))
        success_only = bool(request.get("success_only", False))
        if not query:
            return response("history_search", {"results": [], "reason": "query required"})
        index_path = Path.home() / ".config" / "turtleterm" / "history_index.ndjson"
        if not index_path.exists():
            return response("history_search", {"results": [], "reason": "run history-index first"})
        results = []
        for line in index_path.read_text().splitlines():
            try:
                e = json.loads(line)
                if success_only and e.get("exit", 0) != 0:
                    continue
                if query in e.get("cmd", "").lower() or query in e.get("out", "").lower():
                    results.append(e)
                    if len(results) >= limit:
                        break
            except: pass
        # AI semantic re-rank if API key present and result set > 5
        if results and len(results) > 5 and env("ANTHROPIC_API_KEY"):
            _persona = _load_persona_system(); _mems = _load_memories_context()
            _prefix = "\n\n".join(x for x in [_persona, _mems] if x)
            system = (_prefix + "\n\n" if _prefix else "") + "Rank these shell history matches by relevance to the query. Return a JSON array of cmd strings, most relevant first."
            cmds_text = "\n".join(f"- {r['cmd']}" for r in results[:20])
            ai = _claude_chat(f"Query: {query}\n\nMatches:\n{cmds_text}", system=system, timeout=8)
            if ai and ai.get("response"):
                import re as _re_hs
                ranked_cmds = []
                try:
                    m = _re_hs.search(r'\[.*?\]', ai["response"], _re_hs.DOTALL)
                    if m:
                        ranked_cmds = json.loads(m.group())
                except: pass
                if ranked_cmds:
                    cmd_order = {c: i for i, c in enumerate(ranked_cmds)}
                    results.sort(key=lambda r: cmd_order.get(r["cmd"], 999))
        return response("history_search", {"results": results[:limit], "count": len(results), "query": query})

    # ------------------------------------------------------------------
    # Self-hosted Co-pilot Daemon
    # ------------------------------------------------------------------
    if action in ("copilot_start", "copilot-start"):
        global _COPILOT_THREAD, _COPILOT_RUNNING
        import threading as _thr_cop
        if _COPILOT_RUNNING and _COPILOT_THREAD and _COPILOT_THREAD.is_alive():
            return response("copilot_start", {"started": False, "reason": "already running", "backend": _copilot_config().get("backend")})
        cfg = _copilot_config()
        cfg["enabled"] = True
        cfg_path = Path.home() / ".config" / "turtleterm" / "copilot.json"
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        cfg_path.write_text(json.dumps(cfg, indent=2))
        _COPILOT_RUNNING = True
        _COPILOT_THREAD = _thr_cop.Thread(target=_copilot_watcher, args=(cfg,), daemon=True, name="turtle-copilot")
        _COPILOT_THREAD.start()
        return response("copilot_start", {"started": True, "backend": cfg.get("backend"), "model": cfg.get("model"), "proactive": cfg.get("proactive"), "pid": os.getpid()})

    if action in ("copilot_stop", "copilot-stop"):
        _COPILOT_RUNNING = False
        cfg_path = Path.home() / ".config" / "turtleterm" / "copilot.json"
        if cfg_path.exists():
            try:
                cfg = json.loads(cfg_path.read_text())
                cfg["enabled"] = False
                cfg_path.write_text(json.dumps(cfg, indent=2))
            except Exception:
                pass
        return response("copilot_stop", {"stopped": True})

    if action in ("copilot_status", "copilot-status"):
        cfg = _copilot_config()
        suggestions_path = Path.home() / ".config" / "turtleterm" / "copilot_suggestions.ndjson"
        recent = []
        if suggestions_path.exists():
            lines = suggestions_path.read_text().splitlines()
            for line in lines[-5:]:
                try: recent.append(json.loads(line))
                except: pass
        running = _COPILOT_RUNNING and bool(_COPILOT_THREAD and _COPILOT_THREAD.is_alive())
        return response("copilot_status", {
            "running": running,
            "enabled": cfg.get("enabled", False),
            "backend": cfg.get("backend", "claude"),
            "model": cfg.get("model"),
            "endpoint": cfg.get("endpoint"),
            "proactive": cfg.get("proactive"),
            "auto_explain_errors": cfg.get("auto_explain_errors"),
            "recent_suggestions": recent,
            "suggestions_count": len(suggestions_path.read_text().splitlines()) if suggestions_path.exists() else 0,
        })

    if action in ("copilot_chat", "copilot-chat"):
        message  = request.get("message", "").strip()
        thread_id = request.get("thread_id", "default")
        clear    = bool(request.get("clear", False))
        if not message:
            return response("copilot_chat", {"reply": "", "reason": "message required"})
        # Load/save conversation thread
        threads_dir = Path.home() / ".config" / "turtleterm" / "copilot_threads"
        threads_dir.mkdir(parents=True, exist_ok=True)
        thread_path = threads_dir / f"{thread_id}.json"
        thread: list[dict] = []
        if not clear and thread_path.exists():
            try: thread = json.loads(thread_path.read_text())
            except: thread = []
        # Build context from thread history
        history_text = "\n".join(f"User: {m['user']}\nCopilot: {m['reply']}" for m in thread[-8:])
        prompt = (f"Conversation history:\n{history_text}\n\n" if history_text else "") + f"User: {message}"
        # Get git + session context
        git_ctx = _git_module_level("log", "--oneline", "-3") or ""
        system = (
            "You are a personal terminal co-pilot embedded in TurtleTerm. "
            "You have access to the user's terminal session history and git context. "
            "Be concise, practical, and specific. When suggesting commands, use code blocks."
            + (f"\n\nRecent git context:\n{git_ctx}" if git_ctx else "")
        )
        reply = _copilot_backend_chat(prompt, system=system, config=_copilot_config())
        thread.append({"user": message, "reply": reply})
        if len(thread) > 50:
            thread = thread[-50:]
        thread_path.write_text(json.dumps(thread))
        return response("copilot_chat", {"reply": reply, "thread_id": thread_id, "turns": len(thread)})

    if action in ("copilot_configure", "copilot-configure"):
        cfg = _copilot_config()
        for key in ("backend", "model", "endpoint", "api_key_env", "proactive", "auto_explain_errors", "auto_suggest_slow", "slow_threshold_ms"):
            if key in request:
                cfg[key] = request[key]
        cfg_path = Path.home() / ".config" / "turtleterm" / "copilot.json"
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        cfg_path.write_text(json.dumps(cfg, indent=2))
        return response("copilot_configure", {"saved": True, "config": cfg})

    if action in ("copilot_suggest", "copilot-suggest"):
        # Get latest suggestion(s)
        suggestions_path = Path.home() / ".config" / "turtleterm" / "copilot_suggestions.ndjson"
        limit = int(request.get("limit", 5))
        unread_only = bool(request.get("unread_only", True))
        suggestions = []
        if suggestions_path.exists():
            lines = suggestions_path.read_text().splitlines()
            for line in reversed(lines):
                try:
                    s = json.loads(line)
                    if not unread_only or not s.get("read"):
                        suggestions.append(s)
                        if len(suggestions) >= limit:
                            break
                except: pass
        return response("copilot_suggest", {"suggestions": list(reversed(suggestions)), "total": len(suggestions)})

    if action in ("copilot_backends", "copilot-backends"):
        # Probe all available backends
        backends = []
        # Claude
        if env("ANTHROPIC_API_KEY"):
            backends.append({"id": "claude", "available": True, "note": "ANTHROPIC_API_KEY set"})
        else:
            backends.append({"id": "claude", "available": False, "note": "ANTHROPIC_API_KEY not set"})
        # Ollama
        try:
            import urllib.request as _ur_ol
            with _ur_ol.urlopen("http://localhost:11434/api/tags", timeout=2) as r:
                tags = json.loads(r.read())
                models = [m.get("name") for m in tags.get("models", [])]
                backends.append({"id": "ollama", "available": True, "models": models, "endpoint": "http://localhost:11434"})
        except Exception:
            backends.append({"id": "ollama", "available": False, "note": "not running — start with: ollama serve"})
        # Noetica
        try:
            import urllib.request as _ur_noe2
            with _ur_noe2.urlopen("http://127.0.0.1:8080/health", timeout=2) as r:
                h = json.loads(r.read())
                backends.append({"id": "noetica", "available": True, "version": h.get("version"), "endpoint": "http://127.0.0.1:8080"})
        except Exception:
            backends.append({"id": "noetica", "available": False, "note": "not running — start with: dev-backend.sh"})
        return response("copilot_backends", {"backends": backends, "current": _copilot_config().get("backend")})

    # ------------------------------------------------------------------
    # gh-parity forge actions
    # ------------------------------------------------------------------

    # ── gh repo ──────────────────────────────────────────────────────────────
    if action in ("gh_repo_create", "gh-repo-create"):
        name   = request.get("name", "").strip()
        desc   = request.get("description", "")
        private= bool(request.get("private", False))
        org    = request.get("org", "")
        if not name:
            return response("gh_repo_create", {"created": False, "reason": "name required"})
        payload = {"name": name, "description": desc, "private": private, "auto_init": True}
        endpoint = f"orgs/{org}/repos" if org else "user/repos"
        # Gitea
        if env("GITEA_URL"):
            r = _gitea(endpoint, method="POST", payload=payload)
            if r.get("ok"):
                d2 = r.get("data", {})
                return response("gh_repo_create", {"created": True, "name": name, "url": d2.get("html_url"), "forge": "gitea"})
        # GitHub
        r = _forge_api(endpoint, method="POST", payload=payload, prefer_gitea=False)
        if r.get("ok"):
            d2 = r.get("data", {})
            return response("gh_repo_create", {"created": True, "name": name, "url": d2.get("html_url"), "forge": "github"})
        return response("gh_repo_create", {"created": False, "reason": r.get("error","")})

    if action in ("gh_repo_fork", "gh-repo-fork"):
        cwd = request.get("cwd", ".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if not owner:
            return response("gh_repo_fork", {"forked": False, "reason": "no remote"})
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/forks", method="POST", payload={})
            if r.get("ok"):
                return response("gh_repo_fork", {"forked": True, "url": r.get("data",{}).get("html_url",""), "forge": "gitea"})
        r = _forge_api(f"repos/{owner}/{repo}/forks", method="POST", payload={}, prefer_gitea=False)
        d2 = r.get("data", {})
        return response("gh_repo_fork", {"forked": r.get("ok",False), "url": d2.get("html_url",""), "forge": r.get("forge","")})

    if action in ("gh_repo_view", "gh-repo-view"):
        cwd = request.get("cwd", ".") or "."
        repo_name = request.get("repo", "")
        if repo_name and "/" in repo_name:
            owner, repo = repo_name.split("/", 1)
        else:
            owner, repo = _forge_owner_repo(cwd)
        if not owner:
            return response("gh_repo_view", {"found": False, "reason": "no remote"})
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}")
            if r.get("ok"):
                d2 = r.get("data",{})
                return response("gh_repo_view", {"found": True, "name": d2.get("name"), "description": d2.get("description"), "stars": d2.get("stars_count",0), "forks": d2.get("forks_count",0), "open_issues": d2.get("open_issues_count",0), "url": d2.get("html_url"), "default_branch": d2.get("default_branch","main"), "forge": "gitea"})
        r = _forge_api(f"repos/{owner}/{repo}", prefer_gitea=False)
        d2 = r.get("data",{})
        return response("gh_repo_view", {"found": r.get("ok",False), "name": d2.get("name"), "description": d2.get("description"), "stars": d2.get("stargazers_count",0), "forks": d2.get("forks_count",0), "url": d2.get("html_url"), "default_branch": d2.get("default_branch","main"), "forge": "github"})

    # ── gh pr ─────────────────────────────────────────────────────────────────
    if action in ("gh_pr_checkout", "gh-pr-checkout"):
        pr_num = str(request.get("number", "")).strip()
        cwd    = request.get("cwd", ".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if not pr_num:
            return response("gh_pr_checkout", {"checked_out": False, "reason": "PR number required"})
        # Fetch PR branch from Gitea
        branch = pr_num
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/pulls/{pr_num}")
            if r.get("ok"):
                branch = r.get("data",{}).get("head",{}).get("label", f"pr-{pr_num}")
                if ":" in branch:
                    branch = branch.split(":")[-1]
        result = _git_module_level("fetch", "origin", f"pull/{pr_num}/head:pr-{pr_num}", cwd=cwd)
        checkout = _git_module_level("checkout", f"pr-{pr_num}", cwd=cwd)
        return response("gh_pr_checkout", {"checked_out": True, "branch": f"pr-{pr_num}", "number": pr_num})

    if action in ("gh_pr_merge", "gh-pr-merge"):
        pr_num = str(request.get("number", "")).strip()
        cwd    = request.get("cwd", ".") or "."
        method_merge = request.get("merge_method", "merge")  # merge|squash|rebase
        owner, repo  = _forge_owner_repo(cwd)
        if not pr_num:
            return response("gh_pr_merge", {"merged": False, "reason": "PR number required"})
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/pulls/{pr_num}/merge", method="POST", payload={"Do": method_merge, "merge_message_field": ""})
            return response("gh_pr_merge", {"merged": r.get("ok",False), "forge": "gitea", "reason": r.get("error","")})
        r = _forge_api(f"repos/{owner}/{repo}/pulls/{pr_num}/merge", method="PUT", payload={"merge_method": method_merge}, prefer_gitea=False)
        return response("gh_pr_merge", {"merged": r.get("ok",False), "forge": "github", "reason": r.get("error","")})

    if action in ("gh_pr_close", "gh-pr-close"):
        pr_num = str(request.get("number","")).strip()
        cwd    = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/pulls/{pr_num}", method="PATCH", payload={"state": "closed"})
        else:
            r = _forge_api(f"repos/{owner}/{repo}/pulls/{pr_num}", method="PATCH", payload={"state": "closed"}, prefer_gitea=False)
        return response("gh_pr_close", {"closed": r.get("ok",False), "number": pr_num})

    if action in ("gh_pr_comment", "gh-pr-comment"):
        pr_num  = str(request.get("number","")).strip()
        body    = request.get("body","").strip()
        cwd     = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if not body:
            return response("gh_pr_comment", {"posted": False, "reason": "body required"})
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/issues/{pr_num}/comments", method="POST", payload={"body": body})
        else:
            r = _forge_api(f"repos/{owner}/{repo}/issues/{pr_num}/comments", method="POST", payload={"body": body}, prefer_gitea=False)
        return response("gh_pr_comment", {"posted": r.get("ok",False), "number": pr_num})

    # ── gh issue ──────────────────────────────────────────────────────────────
    if action in ("gh_issue_close", "gh-issue-close"):
        num  = str(request.get("number","")).strip()
        cwd  = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/issues/{num}", method="PATCH", payload={"state": "closed"})
        else:
            r = _forge_api(f"repos/{owner}/{repo}/issues/{num}", method="PATCH", payload={"state": "closed"}, prefer_gitea=False)
        return response("gh_issue_close", {"closed": r.get("ok",False), "number": num})

    if action in ("gh_issue_list", "gh-issue-list"):
        cwd   = request.get("cwd",".") or "."
        state = request.get("state","open")
        limit = int(request.get("limit",20))
        owner, repo = _forge_owner_repo(cwd)
        if not owner:
            return response("gh_issue_list", {"issues":[], "reason":"no remote"})
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/issues?state={state}&type=issues&limit={limit}")
            issues = [{"number": i.get("number"), "title": i.get("title"), "state": i.get("state"), "user": i.get("user",{}).get("login"), "url": i.get("html_url"), "labels": [l.get("name") for l in i.get("labels",[])]} for i in (r.get("data") or [])] if r.get("ok") else []
            return response("gh_issue_list", {"issues": issues, "count": len(issues), "forge": "gitea"})
        r = _forge_api(f"repos/{owner}/{repo}/issues?state={state}&per_page={limit}", prefer_gitea=False)
        issues = [{"number": i.get("number"), "title": i.get("title"), "state": i.get("state"), "user": i.get("user",{}).get("login"), "url": i.get("html_url")} for i in (r.get("data") or [])] if r.get("ok") else []
        return response("gh_issue_list", {"issues": issues, "count": len(issues), "forge": "github"})

    if action in ("gh_issue_comment", "gh-issue-comment"):
        num  = str(request.get("number","")).strip()
        body = request.get("body","").strip()
        cwd  = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/issues/{num}/comments", method="POST", payload={"body": body})
        else:
            r = _forge_api(f"repos/{owner}/{repo}/issues/{num}/comments", method="POST", payload={"body": body}, prefer_gitea=False)
        return response("gh_issue_comment", {"posted": r.get("ok",False)})

    # ── gh release ────────────────────────────────────────────────────────────
    if action in ("gh_release_list", "gh-release-list"):
        cwd = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/releases?limit=10")
            rels = [{"id": x.get("id"), "tag": x.get("tag_name"), "name": x.get("name"), "draft": x.get("draft"), "prerelease": x.get("prerelease"), "url": x.get("html_url")} for x in (r.get("data") or [])] if r.get("ok") else []
            return response("gh_release_list", {"releases": rels, "forge": "gitea"})
        r = _forge_api(f"repos/{owner}/{repo}/releases?per_page=10", prefer_gitea=False)
        rels = [{"id": x.get("id"), "tag": x.get("tag_name"), "name": x.get("name"), "url": x.get("html_url")} for x in (r.get("data") or [])] if r.get("ok") else []
        return response("gh_release_list", {"releases": rels, "forge": "github"})

    if action in ("gh_release_ai_changelog", "gh-release-ai-changelog"):
        cwd    = request.get("cwd",".") or "."
        since  = request.get("since_tag","")
        target = request.get("tag","")
        log_cmd = ["log", "--oneline", f"{since}..HEAD"] if since else ["log", "--oneline", "-20"]
        commits = _git_module_level(*log_cmd, cwd=cwd)
        if not commits:
            return response("gh_release_ai_changelog", {"changelog": "", "reason": "no commits"})
        _persona = _load_persona_system(); _mems = _load_memories_context()
        _prefix = "\n\n".join(x for x in [_persona, _mems] if x)
        system = (_prefix + "\n\n" if _prefix else "") + (
            "Generate a clean release changelog in markdown. "
            "Group commits by type: Features, Bug Fixes, Improvements, Chores. "
            "Use bullet points. Be concise but specific."
        )
        ai = _claude_chat(f"Commits for {target or 'new release'}:\n{commits}", system=system, timeout=15)
        changelog = (ai.get("response") or "").strip() if ai else ""
        return response("gh_release_ai_changelog", {"changelog": changelog, "commits": commits})

    # ── gh workflow ───────────────────────────────────────────────────────────
    if action in ("gh_workflow_list", "gh-workflow-list"):
        cwd = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/actions/workflows")
            wfs = [{"id": w.get("id"), "name": w.get("name"), "state": w.get("state")} for w in r.get("data",{}).get("workflows", r.get("data",[]) if isinstance(r.get("data"),list) else [])] if r.get("ok") else []
            return response("gh_workflow_list", {"workflows": wfs, "forge": "gitea"})
        r = _forge_api(f"repos/{owner}/{repo}/actions/workflows", prefer_gitea=False)
        wfs = [{"id": w.get("id"), "name": w.get("name"), "state": w.get("state")} for w in r.get("data",{}).get("workflows",[])] if r.get("ok") else []
        return response("gh_workflow_list", {"workflows": wfs, "forge": "github"})

    # ── gh label ──────────────────────────────────────────────────────────────
    if action in ("gh_label_list", "gh-label-list"):
        cwd = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/labels")
            labels = [{"id": l.get("id"), "name": l.get("name"), "color": l.get("color")} for l in (r.get("data") or [])] if r.get("ok") else []
            return response("gh_label_list", {"labels": labels, "forge": "gitea"})
        r = _forge_api(f"repos/{owner}/{repo}/labels", prefer_gitea=False)
        labels = [{"id": l.get("id"), "name": l.get("name"), "color": l.get("color")} for l in (r.get("data") or [])] if r.get("ok") else []
        return response("gh_label_list", {"labels": labels, "forge": "github"})

    if action in ("gh_label_create", "gh-label-create"):
        name   = request.get("name","").strip()
        color  = request.get("color","#0075ca").lstrip("#")
        cwd    = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        payload = {"name": name, "color": color}
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/labels", method="POST", payload=payload)
        else:
            r = _forge_api(f"repos/{owner}/{repo}/labels", method="POST", payload=payload, prefer_gitea=False)
        return response("gh_label_create", {"created": r.get("ok",False), "name": name})

    # ── gh secret ────────────────────────────────────────────────────────────
    if action in ("gh_secret_list", "gh-secret-list"):
        cwd = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        # Gitea does not expose secret values — list names only
        if env("GITEA_URL"):
            r = _gitea(f"repos/{owner}/{repo}/actions/secrets")
            secrets = [{"name": s.get("name"), "created": s.get("created_at")} for s in r.get("data",{}).get("secrets", r.get("data",[]) if isinstance(r.get("data"),list) else [])] if r.get("ok") else []
            return response("gh_secret_list", {"secrets": secrets, "note": "values not exposed", "forge": "gitea"})
        r = _forge_api(f"repos/{owner}/{repo}/actions/secrets", prefer_gitea=False)
        secrets = [{"name": s.get("name")} for s in r.get("data",{}).get("secrets",[])] if r.get("ok") else []
        return response("gh_secret_list", {"secrets": secrets, "forge": "github"})

    # ── gh search ────────────────────────────────────────────────────────────
    if action in ("gh_search", "gh-search"):
        query   = request.get("query","").strip()
        kind    = request.get("kind","repos")  # repos|issues|prs|code
        limit   = int(request.get("limit",10))
        use_ai  = bool(request.get("ai_rank",True))
        if not query:
            return response("gh_search", {"results":[], "reason":"query required"})
        results = []
        if env("GITEA_URL"):
            if kind == "repos":
                r = _gitea(f"repos/search?q={query}&limit={limit}")
                results = [{"name": x.get("full_name"), "desc": x.get("description",""), "stars": x.get("stars_count",0), "url": x.get("html_url")} for x in r.get("data",{}).get("data", r.get("data",[]) if isinstance(r.get("data"),list) else [])] if r.get("ok") else []
            elif kind in ("issues","prs"):
                issue_type = "pulls" if kind=="prs" else "issues"
                r = _gitea(f"repos/search?q={query}&limit=5")
                # Search across matched repos
                for repo_item in (r.get("data",{}).get("data",[]) if r.get("ok") else [])[:3]:
                    fn = repo_item.get("full_name","")
                    if "/" in fn:
                        o2, r2 = fn.split("/",1)
                        ri = _gitea(f"repos/{o2}/{r2}/{issue_type}?q={query}&limit=5")
                        for item in (ri.get("data") or []):
                            results.append({"title": item.get("title"), "number": item.get("number"), "url": item.get("html_url"), "repo": fn})
        else:
            # GitHub search API
            gh_kind = {"repos":"repositories","issues":"issues","prs":"issues","code":"code"}.get(kind,"repositories")
            r = _forge_api(f"search/{gh_kind}?q={query}&per_page={limit}", prefer_gitea=False)
            items = r.get("data",{}).get("items",[]) if r.get("ok") else []
            results = [{"name": i.get("full_name") or i.get("title"), "desc": i.get("description","") or i.get("body","")[:80], "url": i.get("html_url")} for i in items]
        # AI re-rank
        if use_ai and results and len(results) > 3 and env("ANTHROPIC_API_KEY"):
            _persona = _load_persona_system()
            system = (_persona + "\n\n" if _persona else "") + "Re-rank these search results by relevance to the query. Return JSON array of names/titles only, most relevant first."
            items_text = "\n".join(f"- {r.get('name') or r.get('title','')}" for r in results[:10])
            ai = _claude_chat(f"Query: {query}\n\nResults:\n{items_text}", system=system, timeout=8)
            if ai:
                import re as _re_sr
                try:
                    m = _re_sr.search(r'\[.*?\]', ai.get("response",""), _re_sr.DOTALL)
                    if m:
                        ranked = json.loads(m.group())
                        order = {n: i for i, n in enumerate(ranked)}
                        results.sort(key=lambda x: order.get(x.get("name") or x.get("title",""), 999))
                except Exception: pass
        return response("gh_search", {"results": results, "count": len(results), "query": query, "kind": kind})

    # ── gh status ────────────────────────────────────────────────────────────
    if action in ("gh_status", "gh-status"):
        cwd = request.get("cwd",".") or "."
        owner, repo = _forge_owner_repo(cwd)
        result = {"forge": "none", "repo": f"{owner}/{repo}" if owner else ""}
        if env("GITEA_URL"):
            # Gitea: get open PRs + issues assigned to current user
            me = _gitea("user")
            user = me.get("data",{}).get("login","") if me.get("ok") else ""
            result["gitea_user"] = user
            result["gitea_url"] = env("GITEA_URL")
            if owner:
                open_prs = _gitea(f"repos/{owner}/{repo}/pulls?state=open&limit=5")
                result["open_prs"] = len(open_prs.get("data") or []) if open_prs.get("ok") else 0
                open_issues = _gitea(f"repos/{owner}/{repo}/issues?state=open&type=issues&limit=5")
                result["open_issues"] = len(open_issues.get("data") or []) if open_issues.get("ok") else 0
            result["forge"] = "gitea"
        else:
            result["note"] = "Set GITEA_URL to connect to Gitea sovereign forge"
        return response("gh_status", result)

    # ── gh api (raw passthrough) ──────────────────────────────────────────────
    if action in ("gh_api", "gh-api"):
        endpoint = request.get("endpoint","").lstrip("/")
        method   = request.get("method","GET").upper()
        payload  = request.get("payload", None)
        raw_gitea = bool(request.get("gitea", bool(env("GITEA_URL"))))
        if raw_gitea and env("GITEA_URL"):
            r = _gitea(endpoint, method=method, payload=payload)
        else:
            r = _forge_api(endpoint, method=method, payload=payload, prefer_gitea=False)
        return response("gh_api", {"ok": r.get("ok"), "data": r.get("data"), "forge": r.get("forge","?"), "error": r.get("error","")})

    # ── workspace_scan ────────────────────────────────────────────────────────
    if action in ("workspace_scan", "workspace-scan"):
        cwd = Path(request.get("cwd", ".") or ".").resolve()
        result: dict = {"cwd": str(cwd), "project_type": "unknown", "languages": [], "tools": [], "suggestions": []}

        # Detect project type by marker files
        markers = {
            "node": ["package.json", "node_modules"],
            "python": ["pyproject.toml", "setup.py", "requirements.txt", "Pipfile"],
            "go": ["go.mod", "go.sum"],
            "rust": ["Cargo.toml"],
            "ruby": ["Gemfile", "Rakefile"],
            "java": ["pom.xml", "build.gradle"],
            "docker": ["Dockerfile", "docker-compose.yml", "docker-compose.yaml"],
            "terraform": ["main.tf", "variables.tf"],
            "elixir": ["mix.exs"],
            "php": ["composer.json"],
        }
        found_types = []
        for ptype, mfiles in markers.items():
            if any((cwd / m).exists() for m in mfiles):
                found_types.append(ptype)
        result["project_type"] = found_types[0] if len(found_types) == 1 else (found_types[0] if found_types else "unknown")
        result["languages"] = found_types

        # Detect tools
        tool_checks = {
            "git": ".git", "docker-compose": "docker-compose.yml",
            "makefile": "Makefile", "turtle": ".turtle",
            "nix": "flake.nix", "github-actions": ".github/workflows",
            "gitea-actions": ".gitea/workflows",
        }
        for tool, marker in tool_checks.items():
            if (cwd / marker).exists():
                result["tools"].append(tool)

        # Git info
        result["git_branch"] = (_git_module_level("branch", "--show-current", cwd=str(cwd)) or "").strip()
        result["git_remote"] = (_git_module_level("remote", "get-url", "origin", cwd=str(cwd)) or "").strip()

        # .turtle config
        turtle_policy = cwd / ".turtle" / "policy.yaml"
        turtle_env    = cwd / ".turtle" / "env.yaml"
        result["has_policy"] = turtle_policy.exists()
        result["has_env"]    = turtle_env.exists()

        # Suggest persona based on project type
        persona_map = {
            "node": "fullstack", "python": "datascience", "go": "backend",
            "rust": "systems", "docker": "devops", "terraform": "devops",
            "ruby": "fullstack", "java": "backend",
        }
        suggested_persona = next((persona_map[t] for t in found_types if t in persona_map), None)
        if suggested_persona:
            result["suggestions"].append({"type": "persona", "value": suggested_persona, "reason": f"detected {found_types[0]} project"})

        # Suggest runbooks
        runbook_dir = Path.home() / ".config" / "turtleterm" / "runbooks"
        if runbook_dir.exists():
            rb_files = list(runbook_dir.glob("*.md")) + list(runbook_dir.glob("*.yaml"))
            relevant = [rb.stem for rb in rb_files if any(t in rb.stem.lower() for t in found_types)]
            if relevant:
                result["suggestions"].append({"type": "runbooks", "value": relevant[:3], "reason": "matching your project type"})

        # File count estimate
        try:
            py_count = len(list(cwd.glob("**/*.py")))
            ts_count = len(list(cwd.glob("**/*.ts"))) + len(list(cwd.glob("**/*.tsx")))
            go_count = len(list(cwd.glob("**/*.go")))
            result["file_counts"] = {"py": py_count, "ts": ts_count + len(list(cwd.glob("**/*.tsx"))), "go": go_count}
        except Exception:
            result["file_counts"] = {}

        return response("workspace_scan", result)

    # ── env actions ───────────────────────────────────────────────────────────
    if action in ("env_load", "env-load"):
        cwd = Path(request.get("cwd", ".") or ".").resolve()
        env_path = cwd / ".turtle" / "env.yaml"
        if not env_path.exists():
            return response("env_load", {"loaded": False, "reason": ".turtle/env.yaml not found"})
        try:
            import re as _re_env
            text = env_path.read_text()
            # Simple YAML key: value parser (no full YAML dep required)
            loaded = {}
            for line in text.splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                m = _re_env.match(r'^(\w+)\s*:\s*(.+)$', line)
                if m:
                    key, val = m.group(1), m.group(2).strip().strip('"\'')
                    # Resolve env var references like ${VAR}
                    val = _re_env.sub(r'\$\{(\w+)\}', lambda x: env(x.group(1), x.group(0)), val)
                    loaded[key] = val
            return response("env_load", {"loaded": True, "vars": loaded, "count": len(loaded), "path": str(env_path)})
        except Exception as e:
            return response("env_load", {"loaded": False, "reason": str(e)})

    if action in ("env_set", "env-set"):
        cwd = Path(request.get("cwd", ".") or ".").resolve()
        key = request.get("key","").strip()
        val = request.get("value","").strip()
        if not key:
            return response("env_set", {"saved": False, "reason": "key required"})
        env_dir = cwd / ".turtle"
        env_dir.mkdir(exist_ok=True)
        env_path = env_dir / "env.yaml"
        import re as _re_envset
        lines = env_path.read_text().splitlines() if env_path.exists() else []
        updated = False
        new_lines = []
        for line in lines:
            m = _re_envset.match(r'^(\w+)\s*:', line)
            if m and m.group(1) == key:
                new_lines.append(f'{key}: "{val}"')
                updated = True
            else:
                new_lines.append(line)
        if not updated:
            new_lines.append(f'{key}: "{val}"')
        env_path.write_text("\n".join(new_lines) + "\n")
        return response("env_set", {"saved": True, "key": key, "path": str(env_path), "updated": updated})

    if action in ("env_list", "env-list"):
        cwd = Path(request.get("cwd", ".") or ".").resolve()
        env_path = cwd / ".turtle" / "env.yaml"
        if not env_path.exists():
            return response("env_list", {"vars": {}, "path": str(env_path), "exists": False})
        r = response("env_load", {})
        # Reuse env_load logic
        import re as _re_el
        text = env_path.read_text()
        loaded = {}
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#"): continue
            m = _re_el.match(r'^(\w+)\s*:\s*(.+)$', line)
            if m:
                loaded[m.group(1)] = m.group(2).strip().strip('"\'')
        return response("env_list", {"vars": loaded, "count": len(loaded), "path": str(env_path), "exists": True})

    if action in ("env_export", "env-export"):
        cwd = Path(request.get("cwd", ".") or ".").resolve()
        env_path = cwd / ".turtle" / "env.yaml"
        if not env_path.exists():
            return response("env_export", {"script": "", "reason": "no .turtle/env.yaml"})
        import re as _re_exp
        lines = ["#!/bin/sh", "# generated by turtle-env export"]
        for line in env_path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"): continue
            m = _re_exp.match(r'^(\w+)\s*:\s*(.+)$', line)
            if m:
                key, val = m.group(1), m.group(2).strip().strip('"\'')
                lines.append(f'export {key}="{val}"')
        script = "\n".join(lines)
        return response("env_export", {"script": script, "path": str(env_path)})

    # ── diagnose ──────────────────────────────────────────────────────────────
    if action in ("diagnose", "diagnose_all"):
        import urllib.request as _ur_dx, urllib.error as _ue_dx, time as _t_dx
        checks = []

        def _chk(name: str, ok: bool, detail: str = "", warn: bool = False) -> None:
            status = "ok" if ok else ("warn" if warn else "fail")
            checks.append({"name": name, "status": status, "detail": detail})

        # Gitea
        gitea_url = env("GITEA_URL","")
        if gitea_url:
            r = _gitea("user")
            _chk("gitea_connection", r.get("ok",False),
                f"user={r.get('data',{}).get('login','?')} v={r.get('data',{}).get('source_id','')} at {gitea_url}" if r.get("ok") else r.get("error",""),
                warn=not r.get("ok",False))
        else:
            _chk("gitea_connection", False, "GITEA_URL not set", warn=True)

        # SynapseIQ
        try:
            with _ur_dx.urlopen("http://127.0.0.1:2087/health", timeout=2) as r2:
                d = json.loads(r2.read())
                _chk("synapseiq_lsp", True, f"v{d.get('version','?')} port=2087 ts_ast={d.get('capabilities',{}).get('typescript_ast')}")
        except Exception as e:
            _chk("synapseiq_lsp", False, "not running — turtle-synapseiq start", warn=True)

        # Noetica
        try:
            with _ur_dx.urlopen("http://127.0.0.1:8080/health", timeout=2) as r3:
                d = json.loads(r3.read())
                _chk("noetica_backend", True, f"v{d.get('version','?')} port=8080")
        except Exception:
            _chk("noetica_backend", False, "not running — dev-backend.sh", warn=True)

        # Ollama
        try:
            with _ur_dx.urlopen("http://localhost:11434/api/tags", timeout=2) as r4:
                d = json.loads(r4.read())
                models = [m.get("name") for m in d.get("models",[])]
                _chk("ollama", True, f"{len(models)} models: {', '.join(models[:3])}")
        except Exception:
            _chk("ollama", False, "not running — ollama serve", warn=True)

        # Claude API key
        ak = env("ANTHROPIC_API_KEY","")
        _chk("anthropic_api_key", bool(ak), f"set (len={len(ak)})" if ak else "not set — export ANTHROPIC_API_KEY", warn=not bool(ak))

        # GitHub token
        gt = env("GITHUB_TOKEN","")
        _chk("github_token", bool(gt), "set" if gt else "not set (gh CLI fallback won't authenticate)", warn=not bool(gt))

        # Copilot
        cfg = _copilot_config()
        _chk("copilot_config", True, f"backend={cfg.get('backend','?')} enabled={cfg.get('enabled',False)} auto_explain={cfg.get('auto_explain_errors',False)}")

        # Event stream
        es = event_stream_path()
        if es.exists():
            size = es.stat().st_size
            lines = len(es.read_text().splitlines())
            _chk("event_stream", True, f"{lines} events, {size//1024}KB at {es}")
        else:
            _chk("event_stream", False, f"no event stream at {es}", warn=True)

        # Config dir
        cfg_dir = Path.home() / ".config" / "turtleterm"
        _chk("config_dir", cfg_dir.exists(), str(cfg_dir))

        # Cost tracker
        cost_path = Path.home() / ".config" / "turtleterm" / "cost.ndjson"
        if cost_path.exists():
            lines2 = len(cost_path.read_text().splitlines())
            _chk("cost_tracker", True, f"{lines2} records")
        else:
            _chk("cost_tracker", True, "no records yet (ok)")

        ok_count   = sum(1 for c in checks if c["status"] == "ok")
        warn_count = sum(1 for c in checks if c["status"] == "warn")
        fail_count = sum(1 for c in checks if c["status"] == "fail")
        return response("diagnose", {"checks": checks, "ok": ok_count, "warn": warn_count, "fail": fail_count, "healthy": fail_count == 0})

    if action in ("chain_run", "chain-run"):
        # Execute a named or inline chain via agentd
        name   = request.get("name","")
        steps  = request.get("steps", [])
        ctx    = request.get("context", {})
        chains_path = Path.home() / ".config" / "turtleterm" / "chains.json"
        BUILTIN_CHAINS_AG = {
            "error-to-fix": [{"action":"copilot-suggest","limit":1},{"action":"copilot-chat","message":"Suggest a fix for: {suggestions}","thread_id":"chain-fix"}],
            "pr-auto": [{"action":"session-to-pr","style":"detailed"},{"action":"gitea-pr-create","title":"{title}","body":"{body}"}],
        }
        if name:
            saved = {}
            if chains_path.exists():
                try: saved = json.loads(chains_path.read_text())
                except: pass
            all_chains = {**BUILTIN_CHAINS_AG, **saved}
            if name not in all_chains:
                return response("chain_run", {"run": False, "reason": f"chain '{name}' not found"})
            steps = all_chains[name]
        if not steps:
            return response("chain_run", {"run": False, "reason": "no steps"})
        results = []
        current_ctx = dict(ctx)
        for step in steps:
            import re as _re_ch
            def _interp(v):
                if not isinstance(v, str): return v
                def _rep(m):
                    key = m.group(1)
                    return json.dumps(current_ctx.get(key, m.group(0)))
                return _re_ch.sub(r'\{(\w+)\}', _rep, v)
            payload2 = {k: _interp(v) for k, v in step.items()}
            step_action = payload2.get("action","")
            # Route to handle_request recursively (simplified: just dispatch inline)
            import copy as _cp_ch
            step_request = _cp_ch.copy(payload2)
            step_request.update({"action": step_action})
            # We can't easily recurse into handle_request here, so record intent
            results.append({"action": step_action, "payload": payload2})
            # Update context with any interpolated keys
            current_ctx.update({k: v for k,v in payload2.items() if k != "action"})
        return response("chain_run", {"run": True, "steps": len(steps), "results": results, "note": "use turtle-chain script for full execution"})

    if action in ("chain_list", "chain-list"):
        chains_path = Path.home() / ".config" / "turtleterm" / "chains.json"
        saved = {}
        if chains_path.exists():
            try: saved = json.loads(chains_path.read_text())
            except: pass
        builtin_names = ["error-to-fix","search-summarize","pr-auto","workspace-onboard"]
        return response("chain_list", {"builtin": builtin_names, "saved": list(saved.keys()), "total": len(builtin_names) + len(saved)})

    return response("error", {"message": f"unknown action: {action}"}, status="error")


# ---------------------------------------------------------------------------
# Server modes
# ---------------------------------------------------------------------------

def serve_stdio() -> int:
    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(json.dumps(response("error", {"message": str(exc)}, status="error")))
        return 2
    print(json.dumps(handle_request(request), indent=2, sort_keys=True))
    return 0


def serve_socket(path: Path) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        path.unlink()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    server.listen(8)
    print(json.dumps(response("listening", {"socket": str(path)})), flush=True)
    try:
        while True:
            conn, _ = server.accept()
            with conn:
                raw = conn.recv(4 * 1024 * 1024)
                try:
                    req = json.loads(raw.decode("utf-8"))
                    result = handle_request(req)
                except Exception as exc:  # noqa: BLE001
                    result = response("error", {"message": str(exc)}, status="error")
                conn.sendall((json.dumps(result, sort_keys=True) + "\n").encode("utf-8"))
    finally:
        server.close()
        if path.exists():
            path.unlink()


def serve_http(port: int) -> int:
    """Persistent HTTP daemon — POST /stdio accepts same JSON as --stdio, GET /health for status."""
    import http.server

    class _Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.path in ('/health', '/healthz'):
                body = json.dumps({
                    "status": "ok", "service": "turtle-agentd",
                    "version": "1.1.0", "mode": "http-daemon",
                }).encode()
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            else:
                self.send_response(404)
                self.end_headers()

        def do_POST(self) -> None:
            length = int(self.headers.get('Content-Length', '0') or '0')
            raw = self.rfile.read(length)
            try:
                req = json.loads(raw.decode('utf-8'))
                result = handle_request(req)
            except Exception as exc:  # noqa: BLE001
                result = response('error', {'message': str(exc)}, status='error')
            body = json.dumps(result, sort_keys=True).encode()
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args: Any) -> None:
            pass  # silence access logs

    httpd = http.server.HTTPServer(('127.0.0.1', port), _Handler)
    startup = json.dumps(response('listening', {'http': f'http://127.0.0.1:{port}', 'port': port}))
    print(startup, flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def _install_launchd() -> int:
    """Install a launchd plist so agentd auto-starts on login (macOS only)."""
    import platform, shutil
    if platform.system() != "Darwin":
        print(json.dumps({"status": "error", "message": "launchd only available on macOS"}))
        return 1
    agentd_path = shutil.which("turtle-agentd") or str(Path(__file__).resolve())
    plist_dir  = Path.home() / "Library" / "LaunchAgents"
    plist_path = plist_dir / "ai.sourceos.turtle-agentd.plist"
    plist_dir.mkdir(parents=True, exist_ok=True)
    plist_content = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.sourceos.turtle-agentd</string>
    <key>ProgramArguments</key>
    <array>
        <string>{agentd_path}</string>
        <string>--http</string>
        <string>7722</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{Path.home()}/.local/state/sourceos/turtle-agentd.log</string>
    <key>StandardErrorPath</key>
    <string>{Path.home()}/.local/state/sourceos/turtle-agentd.err</string>
</dict>
</plist>"""
    plist_path.write_text(plist_content)
    import subprocess as _sp_ld
    _sp_ld.run(["launchctl", "load", "-w", str(plist_path)], check=False)
    print(json.dumps({
        "status": "ok", "message": "launchd plist installed",
        "plist": str(plist_path),
        "hint": "turtle-agentd will now auto-start on login and restart if it crashes",
    }, indent=2))
    return 0


def _uninstall_launchd() -> int:
    plist_path = Path.home() / "Library" / "LaunchAgents" / "ai.sourceos.turtle-agentd.plist"
    if not plist_path.exists():
        print(json.dumps({"status": "error", "message": "plist not found"}))
        return 1
    import subprocess as _sp_ld2
    _sp_ld2.run(["launchctl", "unload", str(plist_path)], check=False)
    plist_path.unlink()
    print(json.dumps({"status": "ok", "message": "launchd plist removed"}))
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="TurtleTerm local agent gateway v0")
    parser.add_argument("--stdio", action="store_true", help="read one JSON request from stdin and write one JSON response")
    parser.add_argument("--socket", default=str(default_socket_path()), help="Unix socket path for daemon mode")
    parser.add_argument("--http", type=int, nargs="?", const=7722, metavar="PORT",
                        help="Start persistent HTTP daemon on PORT (default: 7722)")
    parser.add_argument("--install-launchd", action="store_true",
                        help="Install launchd plist for auto-start on login (macOS only)")
    parser.add_argument("--uninstall-launchd", action="store_true",
                        help="Remove the launchd plist")
    args = parser.parse_args(argv)

    if args.http is not None:
        return serve_http(args.http)
    if args.install_launchd:
        return _install_launchd()
    if args.uninstall_launchd:
        return _uninstall_launchd()
    if args.stdio:
        return serve_stdio()
    return serve_socket(Path(args.socket))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
