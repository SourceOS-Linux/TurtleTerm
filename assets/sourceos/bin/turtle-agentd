        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        pending_dir.mkdir(parents=True, exist_ok=True)
        (pending_dir / "pending_command").write_text(exec_cmd)
        (pending_dir / "pending_command.json").write_text(json.dumps({
