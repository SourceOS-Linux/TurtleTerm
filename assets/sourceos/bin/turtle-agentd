#!/usr/bin/env python3
"""TurtleTerm local agent gateway v0.4.0.

Conservative local JSON gateway for TurtleTerm. Supports:
- stdio (one request / one response)
- Unix socket daemon mode
- Shell-hook event ingestion + receipt writing
- Git enrichment and execution domain detection
- Secret redaction in receipts
- Noetica cognition loop wire (POST /api/chat)
- Policy Fabric evaluation (POST /v1/operations/action-decision)
- SynapseIQ LSP status check
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
import uuid
from pathlib import Path
from typing import Any
from urllib import error as urlerror
from urllib import request as urlrequest


SCHEMA = "sourceos.turtle.agentd.response.v0"

# W1-B: Per-session AI conversation memory (caps at 20 turns per session)
_SESSION_MEMORY: dict[str, list[dict[str, Any]]] = {}
_SESSION_MEMORY_MAX_TURNS = 20

# Patterns that should never appear in receipts or logs.
_SECRET_PATTERNS: list[re.Pattern[str]] = [
    re.compile(r"(sk-ant-[A-Za-z0-9\-_]{20,})", re.IGNORECASE),
    re.compile(r"(sk-[A-Za-z0-9]{20,})", re.IGNORECASE),
    re.compile(r"(ghp_[A-Za-z0-9]{36,})", re.IGNORECASE),
    re.compile(r"(ghs_[A-Za-z0-9]{36,})", re.IGNORECASE),
    re.compile(r"(AKIA[0-9A-Z]{16})", re.IGNORECASE),
    re.compile(r"(-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----.*?-----END[^-]*-----)", re.DOTALL),
    re.compile(r'(?:password|passwd|secret|token|api[_-]?key)\s*[=:]\s*(["\']?)([^\s"\']{8,})\1', re.IGNORECASE),
]


# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def env(name: str, fallback: str = "") -> str:
    value = os.environ.get(name)
    return value if value else fallback


def runtime_dir() -> Path:
    return Path(env("XDG_RUNTIME_DIR", f"/tmp/sourceos-runtime-{os.getuid()}")) / "sourceos" / "turtle-term"


def default_socket_path() -> Path:
    return Path(env("TURTLE_AGENTD_SOCKET", str(runtime_dir() / "agentd.sock")))


def event_stream_path() -> Path:
    return Path(env("SOURCEOS_TERMINAL_EVENTS", str(runtime_dir().parent / "terminal" / "events.ndjson")))


def plan_events_path() -> Path:
    return Path.home() / ".local" / "state" / "sourceos" / "terminal" / "plan-events.ndjson"


def _emit_plan_event(event_type: str, **kwargs: Any) -> None:
    """Append a plan lifecycle event to plan-events.ndjson for real-time view."""
    path = plan_events_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    event = {"type": event_type, "ts": utc_now(), **kwargs}
    try:
        with path.open("a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError:
        pass


def receipts_root() -> Path:
    return Path(env("SOURCEOS_TERMINAL_RECEIPTS", str(Path.home() / ".local" / "state" / "sourceos" / "terminal" / "receipts")))


def read_ndjson(path: Path, limit: int = 100) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    rows: list[dict[str, Any]] = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]:
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return rows


def redact_secrets(text: str) -> str:
    """Replace known secret patterns with [REDACTED]."""
    for pattern in _SECRET_PATTERNS:
        text = pattern.sub("[REDACTED]", text)
    return text


def compute_sha256(data: str | bytes) -> str:
    if isinstance(data, str):
        data = data.encode("utf-8", errors="replace")
    return "sha256:" + hashlib.sha256(data).hexdigest()


def git_info(cwd: str | None = None) -> dict[str, str | None]:
    """Return {repo_root, git_branch} for cwd, or nulls if not a git repo."""
    kwargs: dict[str, Any] = {
        "text": True,
        "stdout": subprocess.PIPE,
        "stderr": subprocess.DEVNULL,
        "timeout": 3,
    }
    if cwd:
        kwargs["cwd"] = cwd
    try:
        root = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=False,
            **kwargs,
        ).stdout.strip() or None
        branch = subprocess.run(
            ["git", "branch", "--show-current"],
            check=False,
            **kwargs,
        ).stdout.strip() or None
        return {"repo_root": root, "git_branch": branch}
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return {"repo_root": None, "git_branch": None}


def detect_execution_domain() -> str:
    """Infer execution domain from environment and filesystem markers."""
    explicit = os.environ.get("SOURCEOS_EXECUTION_DOMAIN")
    if explicit:
        return explicit
    if os.environ.get("DISTROBOX_HOST_HOME"):
        return "distrobox"
    if os.environ.get("TOOLBOX_PATH"):
        return "toolbox"
    if os.environ.get("SSH_CLIENT") or os.environ.get("SSH_TTY"):
        return "ssh"
    if Path("/.dockerenv").exists():
        return "container"
    if os.environ.get("CONTAINER_ID") or os.environ.get("container"):
        return "container"
    if Path("/run/secrets/kubernetes.io").exists():
        return "container"
    return "host"


# ---------------------------------------------------------------------------
# Event stream + receipt writers
# ---------------------------------------------------------------------------

def append_event(event: dict[str, Any]) -> None:
    """Append a single event to the NDJSON event stream."""
    path = event_stream_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(event, sort_keys=True) + "\n")


def write_receipt(event: dict[str, Any]) -> str:
    """Write a command receipt JSON file. Returns the receipt path."""
    session_id = event.get("session_id", "unknown")
    event_id = event.get("event_id", f"evt_{uuid.uuid4().hex}")
    root = receipts_root() / session_id
    root.mkdir(parents=True, exist_ok=True)
    receipt_path = root / f"{event_id}.json"

    receipt = {
        "schema": "sourceos.terminal.receipt.v0",
        "receipt_id": f"receipt_{uuid.uuid4().hex}",
        "session_id": session_id,
        "workspace_id": event.get("workspace_id", env("SOURCEOS_WORKSPACE", "default")),
        "event_id": event_id,
        "actor_id": event.get("actor_id", "human:local-user"),
        "requested_by": event.get("actor_id", "human:local-user"),
        "approved_by": "policy:auto-local",
        "policy_bundle_id": event.get("policy_bundle_id", "unbound"),
        "execution_domain": event.get("execution_domain", detect_execution_domain()),
        "cwd": event.get("cwd", os.getcwd()),
        "repo_root": event.get("repo_root"),
        "git_branch": event.get("git_branch"),
        "host": event.get("host", os.uname().nodename),
        "user": event.get("user", os.environ.get("USER", "unknown")),
        "container_id": event.get("container_id"),
        "command": redact_secrets(event.get("command", "")),
        "command_argv": event.get("command_argv"),
        "exit_status": event.get("exit_status"),
        "started_at": event.get("started_at"),
        "completed_at": event.get("completed_at"),
        "stdout_digest": event.get("stdout_digest", "sha256:uncaptured"),
        "stderr_digest": event.get("stderr_digest", "sha256:uncaptured"),
        "policy_decision_id": event.get("policy_decision_id"),
        "artifacts": event.get("artifact_paths", []),
        "replay": {
            "kind": "terminal-event-pointer",
            "uri": f"sourceos-terminal://{session_id}/events/{event_id}",
        },
    }

    receipt_path.write_text(json.dumps(receipt, indent=2, sort_keys=True), encoding="utf-8")
    return str(receipt_path)


# ---------------------------------------------------------------------------
# Noetica wire
# ---------------------------------------------------------------------------

def noetica_url() -> str:
    return env("SOURCEOS_NOETICA_URL", "http://localhost:8080")


def _noetica_request(method: str, path: str, payload: dict[str, Any] | None = None, timeout: int = 3) -> dict[str, Any] | None:
    url = noetica_url().rstrip("/") + path
    try:
        body = json.dumps(payload).encode("utf-8") if payload is not None else None
        req = urlrequest.Request(
            url,
            data=body,
            method=method,
            headers={"Content-Type": "application/json", "Accept": "application/json"},
        )
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return {"raw": raw[:500]}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def noetica_post(path: str, payload: dict[str, Any], timeout: int = 3) -> dict[str, Any] | None:
    return _noetica_request("POST", path, payload, timeout=timeout)


def noetica_get(path: str, timeout: int = 3) -> dict[str, Any] | None:
    return _noetica_request("GET", path, timeout=timeout)


# ---------------------------------------------------------------------------
# Local policy rule engine
# ---------------------------------------------------------------------------

_LOCAL_POLICY_RULES: list[dict[str, str]] = [
    {"pattern": r"rm\s+-rf\s+/\s*$", "decision": "deny", "reason": "Recursive deletion of filesystem root is destructive."},
    {"pattern": r"rm\s+-rf\s+/\b", "decision": "deny", "reason": "Recursive deletion from root path is destructive."},
    {"pattern": r"rm\s+-rf\s+~\s*$", "decision": "deny", "reason": "Recursive deletion of home directory is destructive."},
    {"pattern": r"rm\s+-rf\s+~/", "decision": "deny", "reason": "Recursive deletion within home directory requires review."},
    {"pattern": r"git\s+push\s+--force", "decision": "warn", "reason": "Force push rewrites remote history."},
    {"pattern": r"curl\b.*\|\s*sh", "decision": "deny", "reason": "Piping curl to shell executes untrusted remote code."},
    {"pattern": r"curl\b.*\|\s*bash", "decision": "deny", "reason": "Piping curl to bash executes untrusted remote code."},
    {"pattern": r"sudo\s+rm\s+-rf", "decision": "deny", "reason": "Privileged recursive deletion is destructive."},
    {"pattern": r"kill\s+-9\s+1\b", "decision": "deny", "reason": "Killing PID 1 crashes the system."},
    {"pattern": r"DROP\s+TABLE", "decision": "warn", "reason": "DROP TABLE permanently destroys database table data."},
    {"pattern": r":\(\)\s*\{.*:\|:.*\}", "decision": "deny", "reason": "Fork bomb detected."},
    {"pattern": r"chmod\s+-R\s+777\s+/", "decision": "deny", "reason": "Recursive 777 on root removes all access controls."},
]

_COMPILED_LOCAL_RULES: list[tuple[re.Pattern[str], str, str, str]] = [
    (re.compile(rule["pattern"], re.IGNORECASE | re.DOTALL), rule["decision"], rule["reason"], rule["pattern"])
    for rule in _LOCAL_POLICY_RULES
]


def _local_policy_check(command: str) -> tuple[str, str, str | None]:
    """Check command against local policy rules. Returns (decision, reason, matched_pattern)."""
    warn_hit: tuple[str, str, str] | None = None
    for compiled, decision, reason, pattern in _COMPILED_LOCAL_RULES:
        if compiled.search(command):
            if decision == "deny":
                return "deny", reason, pattern
            if decision == "warn" and warn_hit is None:
                warn_hit = (decision, reason, pattern)
    if warn_hit:
        return warn_hit[0], warn_hit[1], warn_hit[2]
    return "allow", "No local policy rules matched.", None


# ---------------------------------------------------------------------------
# Policy Fabric wire (Track D)
# ---------------------------------------------------------------------------

def policy_fabric_url() -> str:
    return env("SOURCEOS_POLICY_FABRIC_URL", "http://localhost:8081")


def policy_evaluate(
    action_type: str,
    command: str,
    execution_domain: str = "host",
    actor_id: str = "human:local-user",
    risk_level: str | None = None,
) -> dict[str, Any] | None:
    """POST an execution request to Policy Fabric. Returns decision or None if unreachable.
    Short-circuits with a local deny result if the built-in rule engine rejects the command."""
    # Check local rules first — deny short-circuits without hitting Policy Fabric.
    local_decision, local_reason, local_pattern = _local_policy_check(command)
    if local_decision == "deny":
        return {
            "decision": {
                "outcome": "deny",
                "reason": f"[local-policy] {local_reason}",
                "matched_rule": local_pattern,
            },
            "decision_id": None,
            "source": "local-policy",
        }

    if risk_level is None:
        # host is high-risk, isolated domains are lower
        risk_level = "high" if execution_domain == "host" else "medium"

    recommendation = {
        "recommendation_id": f"urn:srcos:turtle:rec:{uuid.uuid4().hex}",
        "action": {"type": action_type, "command": command},
        "risk_level": risk_level,
        "requested_outcome": "allow",
        "subject": {"actor_id": actor_id, "execution_domain": execution_domain},
        "policy_refs": ["policy://sourceos/terminal/v1"],
        "requires_change_window": False,
    }
    result = _noetica_request(
        "POST",
        "/v1/operations/action-decision",
        {"recommendation": recommendation, "mode": env("TURTLE_POLICY_MODE", "report_only")},
        timeout=4,
    )
    # If policy fabric isn't on the Noetica URL, try the dedicated policy URL.
    if result is None:
        try:
            url = policy_fabric_url().rstrip("/") + "/v1/operations/action-decision"
            body = json.dumps({"recommendation": recommendation, "mode": env("TURTLE_POLICY_MODE", "report_only")}).encode()
            req = urlrequest.Request(url, data=body, method="POST",
                                     headers={"Content-Type": "application/json", "Accept": "application/json"})
            with urlrequest.urlopen(req, timeout=4) as resp:
                result = json.loads(resp.read().decode("utf-8", errors="replace"))
        except (urlerror.URLError, OSError, TimeoutError, json.JSONDecodeError):
            return None
    return result


def _policy_outcome_to_decision(pf_result: dict[str, Any] | None, action: str, command: str) -> tuple[str, str, str | None]:
    """Map a Policy Fabric result to (decision, reason, decision_id)."""
    if pf_result is None:
        return "ask", "Policy Fabric unreachable; defaulting to manual review.", None
    outcome = pf_result.get("decision", {}).get("outcome", "manual_review")
    reason = pf_result.get("decision", {}).get("reason", "no reason provided")
    decision_id = pf_result.get("decision_id")
    if outcome == "allow":
        return "allow", reason, decision_id
    if outcome == "deny":
        return "deny", reason, decision_id
    return "ask", reason, decision_id


def agent_machine_url() -> str:
    return env("SOURCEOS_AGENT_MACHINE_URL", "http://localhost:9000")


def bearbrowser_a2a_url() -> str:
    return env("BEARBROWSER_A2A_URL", "http://localhost:3031")


def _http_get(url: str, timeout: int = 3) -> dict[str, Any] | None:
    try:
        req = urlrequest.Request(url, headers={"Accept": "application/json"})
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return {"raw": raw[:500]}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def _http_post(url: str, payload: dict[str, Any], timeout: int = 5) -> dict[str, Any] | None:
    try:
        body = json.dumps(payload).encode("utf-8")
        req = urlrequest.Request(
            url,
            data=body,
            method="POST",
            headers={"Content-Type": "application/json", "Accept": "application/json"},
        )
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                return {"raw": raw[:500]}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def noetica_chat(text: str, session_id: str | None = None, context: dict[str, Any] | None = None) -> dict[str, Any] | None:
    """POST a message to Noetica /api/chat in sourceos mode."""
    payload: dict[str, Any] = {
        "mode": "sourceos",
        "session_id": session_id or env("SOURCEOS_TERMINAL_SESSION_ID") or str(uuid.uuid4()),
        "messages": [{"role": "user", "content": text}],
    }
    if context:
        ctx_text = json.dumps(context, sort_keys=True)
        payload["system_prompt"] = f"Terminal context: {ctx_text}"
    return noetica_post("/api/chat", payload, timeout=5)


def _claude_chat(text: str, system: str | None = None, model: str | None = None, timeout: int = 15, messages: list[dict[str, Any]] | None = None) -> dict[str, Any] | None:
    """Call Anthropic Messages API directly. Returns None if ANTHROPIC_API_KEY is unset or call fails."""
    api_key = env("ANTHROPIC_API_KEY")
    if not api_key:
        return None
    base = env("ANTHROPIC_API_URL", "https://api.anthropic.com")
    model = model or env("TURTLE_CLAUDE_MODEL", "claude-haiku-4-5-20251001")
    if messages:
        # Multi-turn: append current user message to history
        full_messages = messages + [{"role": "user", "content": text}]
    else:
        full_messages = [{"role": "user", "content": text}]
    payload: dict[str, Any] = {
        "model": model,
        "max_tokens": 1024,
        "messages": full_messages,
    }
    if system:
        payload["system"] = system
    try:
        body = json.dumps(payload).encode("utf-8")
        req = urlrequest.Request(
            base.rstrip("/") + "/v1/messages",
            data=body,
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Accept": "application/json",
                "x-api-key": api_key,
                "anthropic-version": "2023-06-01",
            },
        )
        with urlrequest.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                data = json.loads(raw)
                blocks = [b.get("text", "") for b in data.get("content", []) if b.get("type") == "text"]
                return {"response": "\n".join(blocks), "model": data.get("model"), "source": "claude"}
            except json.JSONDecodeError:
                return {"raw": raw[:500], "source": "claude"}
    except (urlerror.URLError, OSError, TimeoutError):
        return None


def _session_memory_append(session_id: str, role: str, content: str) -> None:
    """Append a message to session memory, evicting oldest if over cap."""
    mem = _SESSION_MEMORY.setdefault(session_id, [])
    mem.append({"role": role, "content": content[:2000]})
    while len(mem) > _SESSION_MEMORY_MAX_TURNS * 2:  # *2 for user+assistant pairs
        mem.pop(0)


def _session_memory_get(session_id: str) -> list[dict[str, Any]]:
    """Return conversation history for a session (for multi-turn AI calls)."""
    return list(_SESSION_MEMORY.get(session_id, []))


def _load_memories_context() -> str:
    mem_path = Path.home() / ".config" / "turtleterm" / "memories.json"
    if not mem_path.exists():
        return ""
    try:
        mems = json.loads(mem_path.read_text())
    except Exception:
        return ""
    if not mems:
        return ""
    recent = mems[-5:]
    lines = ["[TurtleTerm user memories — inject as context:]"]
    for m in recent:
        lines.append(f"  {m.get('key','?')}: {m.get('value','')}")
    return "\n".join(lines)


def _load_persona_system() -> str:
    p_path = Path.home() / ".config" / "turtleterm" / "persona.json"
    if not p_path.exists():
        return ""
    try:
        p = json.loads(p_path.read_text())
    except Exception:
        return ""
    if not p:
        return ""
    parts = []
    if p.get("role"):       parts.append(f"Role: {p['role']}")
    if p.get("stack"):      parts.append(f"Stack: {p['stack']}")
    if p.get("style"):      parts.append(f"Coding style: {p['style']}")
    if p.get("preferred_tools"): parts.append(f"Preferred tools: {p['preferred_tools']}")
    if p.get("notes"):      parts.append(f"Notes: {p['notes']}")
    if not parts:
        return ""
    return "[User persona]\n" + "\n".join(parts)


def smart_chat(
    text: str,
    system: str | None = None,
    session_id: str | None = None,
    context: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    """Claude API when ANTHROPIC_API_KEY is set, else Noetica, else None."""
    result = _claude_chat(text, system=system)
    if result is not None:
        return result
    return noetica_chat(text, session_id=session_id, context=context)


# ---------------------------------------------------------------------------
# Session context helpers
# ---------------------------------------------------------------------------

def _get_session_context(n: int = 10) -> str:
    """Return the last n command.completed events as a formatted string (max 2000 chars)."""
    events = read_ndjson(event_stream_path(), limit=500)
    completed = [e for e in events if e.get("event_type") == "command.completed"]
    recent = completed[-n:]
    if not recent:
        return ""
    lines: list[str] = ["Recent commands:"]
    for idx, evt in enumerate(recent):
        cmd = (evt.get("command") or "").replace("\n", " ")
        if len(cmd) > 80:
            cmd = cmd[:77] + "..."
        exit_status = evt.get("exit_status")
        exit_str = f"exit {exit_status}" if exit_status is not None else "exit ?"
        lines.append(f"  [{idx}] $ {cmd} → {exit_str}")
    result = "\n".join(lines)
    if len(result) > 2000:
        result = result[:1997] + "..."
    return result


# ---------------------------------------------------------------------------
# Shared response / decision helpers
# ---------------------------------------------------------------------------

def decision_stub(action: str, reason: str, decision: str = "ask") -> dict[str, Any]:
    return {
        "id": f"urn:srcos:exec-decision:{uuid.uuid4().hex}",
        "type": "ExecutionDecision",
        "specVersion": "2.0.0",
        "decision": decision,
        "reason": reason,
        "issuedAt": utc_now(),
        "action": action,
    }


def response(kind: str, data: dict[str, Any] | list[Any] | None = None, *, status: str = "ok") -> dict[str, Any]:
    return {
        "schema": SCHEMA,
        "status": status,
        "kind": kind,
        "capturedAt": utc_now(),
        "data": data if data is not None else {},
    }


