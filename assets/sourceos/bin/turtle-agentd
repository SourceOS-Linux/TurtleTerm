        },
        {
            "surface_id": "agent-machine/local-agentpod",
            "label": "Agent Machine Local AgentPod",
            "kind": "agentpod",
            "workspace_id": workspace,
            "cwd": cwd,
            "execution_domain": "agent-machine",
            "policy_profile": "activation-required",
            "agent_allowed": False,
            "receipt_required": True,
            "provider": "agent-machine",
        },
    ]


def surface_by_id(surface_id: str | None) -> dict[str, Any] | None:
    for surface in default_surfaces():
        if surface["surface_id"] == surface_id:
            return surface
    return None


# ---------------------------------------------------------------------------
# Project type detection + adaptive planning helpers
# ---------------------------------------------------------------------------

def _detect_project_type(cwd: str) -> str:
    """Detect project type and active environment managers from directory contents."""
    checks = [
        ("package.json", "Node.js/npm"), ("pyproject.toml", "Python"),
        ("setup.py", "Python"), ("Cargo.toml", "Rust"), ("go.mod", "Go"),
        ("Gemfile", "Ruby"), ("pom.xml", "Java/Maven"), ("Makefile", "Make"),
        ("build.gradle", "Java/Gradle"), ("CMakeLists.txt", "C++/CMake"),
        ("Dockerfile", "Docker"), ("docker-compose.yml", "Docker Compose"),
        ("terraform.tf", "Terraform"), (".terraform", "Terraform"),
    ]
    env_managers = []
    p = Path(cwd)
    project_type = ""
    for fname, label in checks:
        if (p / fname).exists():
            project_type = label
            break

    # Detect active version/env managers
    if (p / ".nvmrc").exists() or (p / ".node-version").exists():
        env_managers.append("nvm")
    if (p / ".mise.toml").exists() or (p / ".tool-versions").exists():
        env_managers.append("mise")
    if (p / ".python-version").exists():
        env_managers.append("pyenv")
    if (p / ".envrc").exists():
        env_managers.append("direnv")
    if (p / "Pipfile").exists():
        env_managers.append("pipenv")
    if (p / "poetry.lock").exists():
        env_managers.append("poetry")
    # Monorepo detection
    if (p / "pnpm-workspace.yaml").exists() or (p / "lerna.json").exists():
        env_managers.append("monorepo")

    parts = [project_type] if project_type else []
    if env_managers:
        parts.append("+" + "+".join(env_managers))
    return " ".join(parts)


def _adaptive_plan_step(goal: str, step_idx: int, step: dict[str, Any], step_output: str) -> dict[str, Any]:
    """Ask AI to verify/adapt a plan step given the previous step's output. Returns possibly-updated step."""
    import re as _re2
    system_prompt = (
        "You are a shell command planner. A multi-step plan is executing. "
        "Review the previous step's output and decide if the next planned command should be adapted. "
        "Output ONLY valid JSON: "
        '{"command":"...","description":"...","adapted":true,"reason":"..."}\n'
        "Set adapted=false if the original command is still correct."
    )
    user_prompt = (
        f"Plan goal: {goal}\n"
        f"Step {step_idx + 1}: {step.get('description', '')}\n"
        f"Planned command: {step.get('command', '')}\n\n"
        f"Previous step output:\n```\n{step_output[-2000:]}\n```"
    )
    ai_resp = _claude_chat(user_prompt, system=system_prompt, timeout=12)
    if not ai_resp:
        return step
    raw = ai_resp.get("response") or ""
    m = _re2.search(r'\{.*\}', raw, _re2.DOTALL)
    if not m:
        return step
    try:
        result = json.loads(m.group(0))
        if result.get("command") and result.get("adapted"):
            return {**step, "command": result["command"],
                    "description": result.get("reason", step.get("description", ""))}
    except json.JSONDecodeError:
        pass
    return step


# ---------------------------------------------------------------------------
# Request handler
# ---------------------------------------------------------------------------

def handle_request(request: dict[str, Any]) -> dict[str, Any]:  # noqa: C901
    action = request.get("action")

    # ------------------------------------------------------------------
    # Core
    # ------------------------------------------------------------------
    if action == "ping":
        noetica_reachable = noetica_get("/api/status", timeout=1) is not None
        return response("pong", {
            "service": "turtle-agentd",
            "version": "0.2.0",
            "noetica_url": noetica_url(),
            "noetica_reachable": noetica_reachable,
        })

    if action == "sessions":
        events = read_ndjson(event_stream_path(), limit=500)
        sessions: dict[str, dict[str, Any]] = {}
        for event in events:
            session_id = event.get("session_id")
            if not session_id:
                continue
            sessions.setdefault(session_id, {}).update({
                "session_id": session_id,
                "workspace_id": event.get("workspace_id"),
                "frontend": event.get("frontend"),
                "execution_domain": event.get("execution_domain"),
                "git_branch": event.get("git_branch"),
                "repo_root": event.get("repo_root"),
                "last_event_type": event.get("event_type", event.get("schema")),
            })
        return response("sessions", {"sessions": list(sessions.values()), "event_stream": str(event_stream_path())})

    if action == "surfaces":
        return response("surfaces", {"surfaces": default_surfaces()})

    if action == "inspect_surface":
        surface_id = request.get("surface_id")
        surface = surface_by_id(surface_id)
        if not surface:
            return response("error", {"message": f"unknown surface: {surface_id}", "known_surfaces": [s["surface_id"] for s in default_surfaces()]}, status="error")
        return response("surface_inspection", {"surface": surface, "decision": decision_stub("surface.inspect", "Surface inspection is review-only.", "allow")})

    if action == "request_surface_execution":
        surface_id = request.get("surface_id")
        command = request.get("command")
        surface = surface_by_id(surface_id)
        if not surface:
            return response("error", {"message": f"unknown surface: {surface_id}"}, status="error")
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        actor_id = request.get("actor_id", "human:local-user")
        domain = surface.get("execution_domain", "host")
        pf_result = policy_evaluate("surface.execute_command", command, domain, actor_id)
        pf_decision, pf_reason, pf_decision_id = _policy_outcome_to_decision(pf_result, "surface.execute_command", command)
        return response("surface_execution_request", {
            "surface": surface,
            "command": command,
            "executionAllowed": pf_decision == "allow",
            "policy_decision": pf_decision,
            "policy_decision_id": pf_decision_id,
            "decision": {
                "id": f"urn:srcos:exec-decision:{uuid.uuid4().hex}",
                "type": "ExecutionDecision",
                "specVersion": "2.0.0",
                "decision": pf_decision,
                "reason": pf_reason,
                "issuedAt": utc_now(),
                "action": "surface.execute_command",
                "policyDecisionId": pf_decision_id,
            },
        })

    if action == "inspect":
        session_id = request.get("session_id")
        events = [row for row in read_ndjson(event_stream_path(), limit=500) if not session_id or row.get("session_id") == session_id]
        return response("inspection", {"session_id": session_id, "events": events[-50:]})

    if action == "summarize":
        session_id = request.get("session_id")
        events = [row for row in read_ndjson(event_stream_path(), limit=500) if not session_id or row.get("session_id") == session_id]
        completed = [row for row in events if row.get("event_type") == "command.completed"]
        failures = [row for row in completed if row.get("exit_status") not in (0, None)]
        summary = {
            "session_id": session_id,
            "event_count": len(events),
            "completed_commands": len(completed),
            "failed_commands": len(failures),
            "last_command": completed[-1].get("command") if completed else None,
            "last_exit_status": completed[-1].get("exit_status") if completed else None,
            "last_git_branch": completed[-1].get("git_branch") if completed else None,
        }
        return response("summary", summary)

    if action == "propose_command":
        command = request.get("command")
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        return response("command_proposal", {
            "command": command,
            "requiresDecision": True,
            "decision": decision_stub("terminal.propose_command", "Command proposal recorded; execution still requires policy."),
        })

    if action == "request_execution":
        command = request.get("command")
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        domain = detect_execution_domain()
        actor_id = request.get("actor_id", "human:local-user")
        pf_result = policy_evaluate("terminal.execute_command", command, domain, actor_id)
        pf_decision, pf_reason, pf_decision_id = _policy_outcome_to_decision(pf_result, "terminal.execute_command", command)
        execution_allowed = pf_decision == "allow"
        return response("execution_request", {
            "command": command,
            "executionAllowed": execution_allowed,
            "policy_decision": pf_decision,
            "policy_decision_id": pf_decision_id,
            "policy_result": pf_result,
            "decision": {
                "id": f"urn:srcos:exec-decision:{uuid.uuid4().hex}",
                "type": "ExecutionDecision",
                "specVersion": "2.0.0",
                "decision": pf_decision,
                "reason": pf_reason,
                "issuedAt": utc_now(),
                "action": "terminal.execute_command",
                "policyDecisionId": pf_decision_id,
            },
        })

    if action == "policy_status":
        pf_result = None
        reachable = False
        try:
            url = policy_fabric_url().rstrip("/") + "/healthz"
            req = urlrequest.Request(url, method="GET")
            with urlrequest.urlopen(req, timeout=3) as resp:
                pf_result = json.loads(resp.read().decode("utf-8", errors="replace"))
                reachable = True
        except (urlerror.URLError, OSError, TimeoutError, json.JSONDecodeError):
            pass
        return response("policy_status", {
            "url": policy_fabric_url(),
            "reachable": reachable,
            "mode": env("TURTLE_POLICY_MODE", "report_only"),
            "status": pf_result,
        })

    # ------------------------------------------------------------------
    # Track A: shell event ingestion + receipt writing
    # ------------------------------------------------------------------
    if action == "ingest_event":
        event = request.get("event", {})
        if not event:
            return response("error", {"message": "event is required"}, status="error")

        # Ensure event has required fields.
        now = utc_now()
        event.setdefault("event_id", f"evt_{uuid.uuid4().hex}")
        event.setdefault("schema", "sourceos.terminal.event.v0")
        event.setdefault("session_id", env("SOURCEOS_TERMINAL_SESSION_ID", f"term-{uuid.uuid4().hex}"))
        event.setdefault("workspace_id", env("SOURCEOS_WORKSPACE", "default"))
        event.setdefault("actor_id", "human:local-user")
        event.setdefault("frontend", env("SOURCEOS_TERMINAL_FRONTEND", "turtle-term"))
        event.setdefault("host", os.uname().nodename)
        event.setdefault("user", os.environ.get("USER", "unknown"))
        event.setdefault("capturedAt", now)

        # Enrich: execution domain.
        if not event.get("execution_domain"):
            event["execution_domain"] = detect_execution_domain()

        # Enrich: git metadata.
        if not event.get("repo_root"):
            git = git_info(event.get("cwd"))
            event.setdefault("repo_root", git["repo_root"])
            event.setdefault("git_branch", git["git_branch"])

        # Redact secrets from command string before persisting.
        if event.get("command"):
            event["command"] = redact_secrets(event["command"])

        receipt_path: str | None = None
        append_event(event)

        # Write receipt for completed commands.
        if event.get("event_type") == "command.completed":
            receipt_path = write_receipt(event)

        return response("event_ingested", {
            "event_id": event["event_id"],
            "session_id": event["session_id"],
            "event_type": event.get("event_type"),
            "receipt_path": receipt_path,
        })

    # ------------------------------------------------------------------
    # Track B: Noetica cognition wire
    # ------------------------------------------------------------------
    if action == "noetica_status":
        noetica_resp = noetica_get("/api/status", timeout=3)
        reachable = noetica_resp is not None
        return response("noetica_status", {
            "url": noetica_url(),
            "reachable": reachable,
            "status": noetica_resp,
        })

    if action == "noetica_query":
        text = request.get("text", "")
        if not text:
            return response("error", {"message": "text is required"}, status="error")
        session_id = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID")
        context = request.get("context")
        noetica_resp = noetica_chat(text, session_id=session_id, context=context)
        return response("noetica_query_result", {
            "text": text,
            "noetica_response": noetica_resp,
            "reachable": noetica_resp is not None,
        })

    if action == "superconscious_observe":
        observation = request.get("observation", {})
        trace_ref = f"urn:srcos:turtle:superconscious-observation:{uuid.uuid4().hex}"

        # Wire to Noetica: translate observation into a chat message.
        obs_text = observation.get("text") or json.dumps(observation, sort_keys=True)
        noetica_resp = noetica_chat(
            f"[terminal-observation] {obs_text}",
            session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
            context={"source": "turtleterm", "type": "observation"},
        )

        return response("superconscious_observation", {
            "status": "recorded",
            "observation": observation,
            "traceRef": trace_ref,
            "noetica_response": noetica_resp,
            "decision": decision_stub("superconscious.observe", "Observation handoff is review-only; no shell authority granted.", "allow"),
        })

    if action == "superconscious_propose":
        prompt = request.get("prompt", "")

        noetica_resp = noetica_chat(
            f"[terminal-proposal-request] {prompt}",
            session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
            context={"source": "turtleterm", "type": "proposal_request"},
        )

        return response("superconscious_proposal", {
            "status": "proposed" if noetica_resp else "deferred",
            "prompt": prompt,
            "noetica_response": noetica_resp,
            "decision": decision_stub("superconscious.propose", "Superconscious proposal routed to Noetica cognition loop.", "defer"),
        })

    # ------------------------------------------------------------------
    # Agent Machine
    # ------------------------------------------------------------------
    if action == "agent_machine_surfaces":
        return response("agent_machine_surfaces", {"surfaces": [s for s in default_surfaces() if s["provider"] == "agent-machine"]})

    if action == "agent_machine_probe":
        base = agent_machine_url()
        result = _http_get(base.rstrip("/") + "/health", timeout=3)
        if result is None:
            result = _http_get(base.rstrip("/") + "/api/probe", timeout=3)
        reachable = result is not None
        return response("agent_machine_probe", {
            "agent_machine_url": base,
            "reachable": reachable,
            "probe_response": result,
            "decision": decision_stub(
                "agent-machine.probe",
                f"Agent Machine {'reachable' if reachable else 'unreachable'} at {base}.",
                "allow" if reachable else "defer",
            ),
        })

    # ------------------------------------------------------------------
    # CloudFog
    # ------------------------------------------------------------------
    if action == "cloudfog_surfaces":
        return response("cloudfog_surfaces", {"surfaces": [s for s in default_surfaces() if s["provider"] == "cloudfog-shell"]})

    if action == "cloudfog_inspect":
        surface_id = request.get("surface_id", "cloudfog/local-devshell")
        surface = surface_by_id(surface_id)
        if not surface or surface.get("provider") != "cloudfog-shell":
            return response("error", {"message": f"unknown cloudfog surface: {surface_id}"}, status="error")
        return response("cloudfog_surface_inspection", {"surface": surface, "decision": decision_stub("cloudfog.inspect", "CloudFog surface inspection is review-only.", "allow")})

    # ------------------------------------------------------------------
    # Receipts + AgentPlane
    # ------------------------------------------------------------------
    if action == "receipts":
        session_id = request.get("session_id")
        root = receipts_root()
        paths: list[str] = []
        if session_id:
            paths = sorted(str(p) for p in (root / session_id).glob("*.json")) if (root / session_id).exists() else []
        else:
            paths = sorted(str(p) for p in root.glob("*/*.json")) if root.exists() else []
        return response("receipts", {"session_id": session_id, "receipts": paths[-100:]})

    if action == "promote_agentplane_bundle":
        return response("agentplane_promotion_request", {
            "status": "deferred",
            "decision": decision_stub("agentplane.bundle.create", "AgentPlane bundle promotion is specified but not implemented in turtle-agentd v0.", "defer"),
        })

    # ------------------------------------------------------------------
    # AI-powered terminal intelligence
    # ------------------------------------------------------------------

    if action == "explain_selection":
        text = request.get("text", "").strip()
        if not text:
            return response("error", {"message": "text is required"}, status="error")
        context = request.get("context") or {}
        cwd = context.get("cwd") or os.getcwd()
        git = git_info(cwd)
        system_prompt = (
            "You are a terminal intelligence assistant. Explain what the following terminal output "
            "or selected text means, in 2-4 concise sentences. Identify errors, key data, or "
            "actionable next steps if relevant. Be direct and technical. "
            "At the end of your response, if a fix or corrected command is applicable, add a line: FIX: <the corrected command>"
        )
        ctx_suffix = ""
        if git.get("git_branch"):
            ctx_suffix = f"\n\nContext: git branch `{git['git_branch']}`, cwd `{cwd}`"
        session_ctx = _get_session_context()
        if session_ctx:
            ctx_suffix += f"\n\n{session_ctx}"
        user_prompt = f"Selected text:\n```\n{text}\n```{ctx_suffix}"
        ai_resp = smart_chat(
            user_prompt,
            system=system_prompt,
            session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
            context=context,
        )
        explanation = None
        if ai_resp:
            explanation = (
                ai_resp.get("response")
                or ai_resp.get("message")
                or ai_resp.get("content")
                or ai_resp.get("raw")
            )
        # Extract fix command if AI provided one
        fix_command = ""
        if explanation:
            import re as _re_fix
            fix_match = _re_fix.search(r'^FIX:\s*(.+)$', explanation, _re_fix.MULTILINE)
            if fix_match:
                fix_command = fix_match.group(1).strip()
                # Remove the FIX line from the explanation
                explanation = _re_fix.sub(r'\nFIX:.*$', '', explanation, flags=_re_fix.MULTILINE).strip()
        sid = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID", "default")
        _session_memory_append(sid, "user", f"Explain this terminal output:\n{text[:500]}")
        if explanation:
            _session_memory_append(sid, "assistant", explanation[:500])
        source = (ai_resp or {}).get("source", "unknown") if ai_resp else "none"
        return response("explain_selection", {
            "text": text[:200],
            "explanation": explanation or "(no AI backend reachable — set ANTHROPIC_API_KEY or start Noetica on :8080)",
            "fix_command": fix_command,
            "source": source,
            "ai_response": ai_resp,
        })

    if action == "nl_to_shell":
        text = request.get("text", "").strip()
        if not text:
            return response("error", {"message": "text is required"}, status="error")
        context = request.get("context") or {}
        cwd = context.get("cwd") or os.getcwd()
        git = git_info(cwd)
        shell = context.get("shell") or os.environ.get("SHELL", "zsh").split("/")[-1]
        proj_type = _detect_project_type(cwd)
        proj_ctx = f" in a {proj_type} project" if proj_type else ""
        system_prompt = (
            f"You are a {shell} shell command generator{proj_ctx}. "
            f"Current working directory: {cwd}. "
            f"The user describes what they want to do. "
            f"Output ONLY a single {shell} command, no explanation, no markdown fences, no commentary. "
            "If the task requires multiple steps, chain them with && or use a subshell. "
            "Never output multiple lines unless using a heredoc."
        )
        ctx_suffix = ""
        if git.get("git_branch"):
            ctx_suffix = f"\n\nContext: git branch `{git['git_branch']}`, cwd `{cwd}`"
        session_ctx = _get_session_context()
        if session_ctx:
            ctx_suffix += f"\n\n{session_ctx}"
        user_prompt = f"Request: {text}{ctx_suffix}"
        sid = request.get("session_id") or env("SOURCEOS_TERMINAL_SESSION_ID", "default")
        hist = _session_memory_get(sid)
        ai_resp = _claude_chat(user_prompt, system=system_prompt, messages=hist if hist else None)
        if ai_resp is None:
            ai_resp = smart_chat(
                user_prompt,
                system=system_prompt,
                session_id=env("SOURCEOS_TERMINAL_SESSION_ID"),
                context=context,
            )
        if ai_resp:
            _session_memory_append(sid, "user", text[:300])
            _session_memory_append(sid, "assistant", (ai_resp.get("response") or "")[:300])
        command = None
        if ai_resp:
            raw = (
                ai_resp.get("response")
                or ai_resp.get("message")
                or ai_resp.get("content")
                or ai_resp.get("raw")
                or ""
            )
            command = raw.strip().strip("`").strip()
            # Remove leading shell name prefix if model echoed it
            for prefix in (f"{shell}: ", f"$ ", f"% "):
                if command.startswith(prefix):
                    command = command[len(prefix):]
        source = (ai_resp or {}).get("source", "unknown") if ai_resp else "none"
        return response("nl_to_shell", {
            "request": text,
            "command": command or "",
            "source": source,
            "ai_response": ai_resp,
            "reachable": ai_resp is not None,
        })

    if action == "terminal_execute_with_confirmation":
        command = request.get("command", "").strip()
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        description = request.get("description", "")
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        pending_dir.mkdir(parents=True, exist_ok=True)
        pending_file = pending_dir / "pending_command"
        tmp_file = pending_dir / "pending_command.tmp"
        tmp_file.write_text(command, encoding="utf-8")
        tmp_file.rename(pending_file)
        meta = {
            "command": command,
            "description": description,
            "requested_at": utc_now(),
            "source": "mcp",
        }
        meta_file = pending_dir / "pending_command.json"
        meta_tmp = pending_dir / "pending_command.json.tmp"
        meta_tmp.write_text(json.dumps(meta, indent=2, sort_keys=True), encoding="utf-8")
        meta_tmp.rename(meta_file)
        return response("execution_pending", {
            "command": command,
            "status": "pending_confirmation",
            "note": "Command written to pending_command file. The terminal will display it for human review and execution.",
        })

    if action == "atlas_context":
        cwd = request.get("cwd") or os.getcwd()
        # Walk up from cwd looking for .atlas/ directory
        atlas_dir: Path | None = None
        p = Path(cwd)
        for _ in range(8):
            candidate = p / ".atlas"
            if candidate.is_dir():
                atlas_dir = candidate
                break
            if p.parent == p:
                break
            p = p.parent
        if atlas_dir is None:
            return response("atlas_context", {
                "found": False,
                "atlas_dir": None,
                "entries": [],
                "note": "No .atlas/ directory found in cwd or parent directories.",
            })
        entries: list[dict[str, Any]] = []
        for md_file in sorted(atlas_dir.rglob("*.md"))[:20]:
            try:
                content = md_file.read_text(encoding="utf-8", errors="replace")[:2000]
                entries.append({"path": str(md_file.relative_to(atlas_dir)), "content": content})
            except OSError:
                continue
        return response("atlas_context", {
            "found": True,
            "atlas_dir": str(atlas_dir),
            "entries": entries,
            "entry_count": len(entries),
        })

    if action == "atlas_acp_register":
        atlas_url = env("ATLAS_ACP_URL", "http://localhost:3000/acp/")
        registration = {
            "agent": {
                "id": "turtleterm",
                "name": "TurtleTerm",
                "description": "TurtleTerm terminal intelligence agent (SourceOS)",
                "version": "0.2.0",
                "capabilities": ["terminal", "shell", "explain_selection", "nl_to_shell"],
                "endpoint": env("TURTLETERM_ACP_ENDPOINT", ""),
            }
        }
        result = _http_post(atlas_url.rstrip("/") + "/register", registration, timeout=5)
        reachable = result is not None
        return response("atlas_acp_register", {
            "atlas_url": atlas_url,
            "reachable": reachable,
            "registration": registration["agent"],
            "atlas_response": result,
            "status": "registered" if reachable else "atlas_unreachable",
        })

    # ------------------------------------------------------------------
    # Local policy rule engine
    # ------------------------------------------------------------------

    if action == "policy_evaluate_local":
        command = request.get("command", "").strip()
        if not command:
            return response("error", {"message": "command is required"}, status="error")
        local_decision, local_reason, local_matched = _local_policy_check(command)
        return response("policy_local", {
            "command": command,
            "decision": local_decision,
            "reason": local_reason,
            "matched_rule": local_matched,
        })

    # ------------------------------------------------------------------
    # BearBrowser A2A handoff
    # ------------------------------------------------------------------
    if action == "bearbrowser_handoff":
        task_description = request.get("task", "")
        if not task_description:
            return response("error", {"message": "bearbrowser_handoff requires 'task' field"}, status="error")
        base = bearbrowser_a2a_url()
        session_id = env("SOURCEOS_TERMINAL_SESSION_ID") or str(uuid.uuid4())
        handoff_id = str(uuid.uuid4())
        payload = {
            "task": {
                "id": f"urn:srcos:bearbrowser:task:{handoff_id}",
                "description": task_description,
                "skill": "browser.handoff",
                "context": {
                    "source": "turtleterm",
                    "session_id": session_id,
                    "workspace": env("SOURCEOS_WORKSPACE", "default"),
                    "execution_domain": detect_execution_domain(),
                    "actor_id": env("SOURCEOS_ACTOR_ID", "human:local-user"),
                    "policy_bundle_id": env("SOURCEOS_POLICY_BUNDLE_ID", "policy:default"),
                    "handoff_id": handoff_id,
                },
            }
        }
        result = _http_post(base.rstrip("/") + "/a2a/tasks", payload, timeout=8)
        reachable = result is not None
        status_label = "submitted" if reachable else "queued_offline"
        receipt = write_receipt({
            "schema": "sourceos.terminal.event.v0",
            "event_type": "bearbrowser.handoff",
            "session_id": session_id,
            "task": task_description,
            "handoff_id": handoff_id,
            "bearbrowser_url": base,
            "reachable": reachable,
            "status": status_label,
            "capturedAt": utc_now(),
        })
        return response("bearbrowser_handoff", {
            "handoff_id": handoff_id,
            "task": task_description,
            "bearbrowser_url": base,
            "reachable": reachable,
            "status": status_label,
            "bearbrowser_response": result,
            "receipt": receipt,
            "decision": decision_stub(
                "bearbrowser.handoff",
                f"BearBrowser A2A handoff {'submitted' if reachable else 'queued (BearBrowser unreachable)'}.",
                "allow" if reachable else "defer",
            ),
        })

    # ------------------------------------------------------------------
    # Agent planner loop — multi-step command planning with confirmation
    # ------------------------------------------------------------------
    if action == "plan_execute":
        import re as _re
        goal = request.get("goal", "").strip()
        if not goal:
            return response("error", {"message": "goal is required"}, status="error")

        system_prompt = (
            "You are a shell command planner for a terminal intelligence system. "
            "Given a user goal, generate a step-by-step plan as JSON. "
            "Output ONLY valid JSON with this exact schema (no markdown, no prose):\n"
            '{"goal":"...","steps":[{"description":"...","command":"...","reversible":true}]}\n'
            "Rules: each step is ONE shell command; max 8 steps; prefer safe, reversible commands; "
            "mark reversible=false only for delete/overwrite operations."
        )
        session_ctx = _get_session_context()
        user_msg = f"Goal: {goal}"
        if session_ctx:
            user_msg += f"\n\n{session_ctx}"

        ai_resp = _claude_chat(user_msg, system=system_prompt, timeout=20)
        if ai_resp is None:
            ai_resp = smart_chat(user_msg, system=system_prompt)
        if ai_resp is None:
            return response("error", {"message": "AI backend unavailable — set ANTHROPIC_API_KEY or start Noetica"}, status="error")

        raw = (ai_resp.get("response") or ai_resp.get("message") or ai_resp.get("raw") or "")
        json_match = _re.search(r'\{.*\}', raw, _re.DOTALL)
        steps: list[dict[str, Any]] = []
        parsed_goal = goal
        if json_match:
            try:
                plan = json.loads(json_match.group(0))
                steps = plan.get("steps", [])
                parsed_goal = plan.get("goal", goal)
            except json.JSONDecodeError:
                pass
        if not steps:
            return response("error", {"message": "AI did not return a valid plan", "raw": raw[:500]}, status="error")

        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        pending_dir.mkdir(parents=True, exist_ok=True)
        plan_data: dict[str, Any] = {
            "goal": parsed_goal,
            "steps": steps,
            "current_step": 0,
            "created_at": utc_now(),
            "source": "plan_execute",
        }
        (pending_dir / "current_plan.json").write_text(json.dumps(plan_data, indent=2))
        _emit_plan_event("plan_created", goal=parsed_goal, step_count=len(steps), current_step=0)

        first_cmd = steps[0].get("command", "") if steps else ""
        if first_cmd:
            tmp = pending_dir / "pending_command.tmp"
            tmp.write_text(first_cmd)
            tmp.rename(pending_dir / "pending_command")
            meta: dict[str, Any] = {
                "command": first_cmd,
                "description": steps[0].get("description", ""),
                "requested_at": utc_now(),
                "source": "plan",
                "plan_step": 0,
                "plan_total": len(steps),
                "goal": parsed_goal,
            }
            mtmp = pending_dir / "pending_command.json.tmp"
            mtmp.write_text(json.dumps(meta, indent=2))
            mtmp.rename(pending_dir / "pending_command.json")

        return response("plan_execute", {
            "goal": parsed_goal,
            "step_count": len(steps),
            "steps": steps,
            "current_step": 0,
            "status": "first_step_ready",
            "note": "Step 1 written to terminal prompt. Run it, then call plan_next to advance.",
        })

    if action == "plan_next":
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        plan_file = pending_dir / "current_plan.json"
        if not plan_file.exists():
            return response("error", {"message": "no active plan — call plan_execute first"}, status="error")
        try:
            plan_data = json.loads(plan_file.read_text())
        except (json.JSONDecodeError, OSError):
            return response("error", {"message": "could not read current plan"}, status="error")
        steps = plan_data.get("steps", [])
        next_idx = plan_data.get("current_step", 0) + 1
        if next_idx >= len(steps):
            plan_file.unlink(missing_ok=True)
            _emit_plan_event("plan_complete", goal=plan_data.get("goal"), total_steps=len(steps))
            return response("plan_complete", {
                "goal": plan_data.get("goal"),
                "total_steps": len(steps),
                "status": "all_steps_complete",
            })
        plan_data["current_step"] = next_idx
        plan_file.write_text(json.dumps(plan_data, indent=2))
        _emit_plan_event("step_started",
            goal=plan_data.get("goal"), step=next_idx,
            total=len(steps), command=steps[next_idx].get("command", ""),
            description=steps[next_idx].get("description", ""))
        # Read step output captured by Lua auto-advance (enables adaptive planning)
        step_output_file = pending_dir / "step_output.txt"
        step_output = ""
        if step_output_file.exists():
            try:
                step_output = step_output_file.read_text(encoding="utf-8", errors="replace")[:2000]
                step_output_file.unlink(missing_ok=True)
            except OSError:
                pass
        # Adapt next step based on previous output (only when ANTHROPIC_API_KEY is set)
        if step_output and env("ANTHROPIC_API_KEY"):
            steps[next_idx] = _adaptive_plan_step(
                plan_data.get("goal", ""), next_idx, steps[next_idx], step_output
            )
            plan_file.write_text(json.dumps(plan_data, indent=2))
        next_cmd = steps[next_idx].get("command", "")
        if next_cmd:
            tmp = pending_dir / "pending_command.tmp"
            tmp.write_text(next_cmd)
            tmp.rename(pending_dir / "pending_command")
            meta = {
                "command": next_cmd,
                "description": steps[next_idx].get("description", ""),
                "requested_at": utc_now(),
                "source": "plan",
                "plan_step": next_idx,
                "plan_total": len(steps),
                "goal": plan_data.get("goal"),
            }
            mtmp = pending_dir / "pending_command.json.tmp"
            mtmp.write_text(json.dumps(meta, indent=2))
            mtmp.rename(pending_dir / "pending_command.json")
        return response("plan_next", {
            "goal": plan_data.get("goal"),
            "step": next_idx,
            "step_count": len(steps),
            "command": next_cmd,
            "description": steps[next_idx].get("description", ""),
            "status": "step_ready",
            "remaining": len(steps) - next_idx - 1,
        })

    if action == "plan_status":
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        plan_file = pending_dir / "current_plan.json"
        if not plan_file.exists():
            return response("plan_status", {"active": False})
        try:
            plan_data = json.loads(plan_file.read_text())
            return response("plan_status", {
                "active": True,
                "goal": plan_data.get("goal"),
                "current_step": plan_data.get("current_step", 0),
                "step_count": len(plan_data.get("steps", [])),
                "steps": plan_data.get("steps", []),
            })
        except (json.JSONDecodeError, OSError):
            return response("plan_status", {"active": False})

    if action == "plan_abort":
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        plan_file = pending_dir / "current_plan.json"
        goal = None
        try:
            goal = json.loads(plan_file.read_text()).get("goal")
        except (OSError, json.JSONDecodeError):
            pass
        plan_file.unlink(missing_ok=True)
        (pending_dir / "pending_command").unlink(missing_ok=True)
        (pending_dir / "pending_command.json").unlink(missing_ok=True)
        _emit_plan_event("plan_aborted", goal=goal)
        return response("plan_abort", {"status": "aborted"})

    if action in ("events_since", "terminal_events_since"):
        since_ts = float(request.get("since", 0))
        sid_filter = request.get("session_id") or None
        type_filter: list[str] | None = request.get("event_types") or None
        events = read_ndjson(event_stream_path(), limit=500)
        matching = []
        for ev in events:
            ts = ev.get("ts") or ev.get("timestamp") or 0
            if ts <= since_ts:
                continue
            if sid_filter and ev.get("session_id") != sid_filter:
                continue
            if type_filter and ev.get("event_type") not in type_filter:
                continue
            matching.append(ev)
        last_ts = matching[-1].get("ts", 0) if matching else since_ts
        return response("events_since", {"events": matching[-100:], "count": len(matching), "latest_ts": last_ts})

    if action in ("wait_for_command", "terminal_wait_for_command"):
        timeout_s = min(float(request.get("timeout", 30.0)), 120.0)
        sid_filter = request.get("session_id") or None
        import time as _time_wfc
        deadline = _time_wfc.monotonic() + timeout_s
        last_seen_ts: float = request.get("since", 0.0)
        while _time_wfc.monotonic() < deadline:
            events = read_ndjson(event_stream_path(), limit=200)
            completed = [
                e for e in events
                if e.get("event_type") == "command.completed"
                and (e.get("ts") or 0) > last_seen_ts
                and (not sid_filter or e.get("session_id") == sid_filter)
            ]
            if completed:
                ev = completed[-1]
                return response("wait_for_command", {
                    "event": ev,
                    "exit_code": ev.get("exit_code"),
                    "command": ev.get("command"),
                    "session_id": ev.get("session_id"),
                    "timed_out": False,
                })
            _time_wfc.sleep(0.5)
        return response("wait_for_command", {"timed_out": True, "timeout_s": timeout_s})

    if action == "bookmark_add":
        cmd = request.get("command", "").strip()
        if not cmd:
            return response("error", {"message": "command required"}, status="error")
        bfile = Path.home() / ".config" / "turtleterm" / "bookmarks.json"
        bfile.parent.mkdir(parents=True, exist_ok=True)
        bookmarks: list[dict[str, Any]] = []
        if bfile.exists():
            try:
                bookmarks = json.loads(bfile.read_text())
            except (json.JSONDecodeError, OSError):
                pass
        if any(b.get("cmd") == cmd for b in bookmarks):
            return response("bookmark_add", {"cmd": cmd, "already_exists": True})
        import time as _time_bm
        bookmarks.append({"cmd": cmd, "added": int(_time_bm.time()), "note": request.get("note", "")})
        bfile.write_text(json.dumps(bookmarks, indent=2))
        return response("bookmark_add", {"cmd": cmd, "total": len(bookmarks)})

    if action == "bookmark_list":
        bfile = Path.home() / ".config" / "turtleterm" / "bookmarks.json"
        bookmarks = []
        if bfile.exists():
            try:
                bookmarks = json.loads(bfile.read_text())
            except (json.JSONDecodeError, OSError):
                pass
        return response("bookmark_list", {"bookmarks": bookmarks, "count": len(bookmarks)})

    if action == "bookmark_remove":
        cmd = request.get("command", "").strip()
        bfile = Path.home() / ".config" / "turtleterm" / "bookmarks.json"
        bookmarks = []
        if bfile.exists():
            try:
                bookmarks = json.loads(bfile.read_text())
            except (json.JSONDecodeError, OSError):
                pass
        original_len = len(bookmarks)
        bookmarks = [b for b in bookmarks if b.get("cmd") != cmd]
        bfile.write_text(json.dumps(bookmarks, indent=2))
        return response("bookmark_remove", {"removed": original_len - len(bookmarks), "remaining": len(bookmarks)})

    if action in ("semantic_history", "semantic-history"):
        query = request.get("query", "").strip()
        commands: list[str] = request.get("commands", [])
        limit = min(int(request.get("limit", 30)), 50)
        if not commands:
            return response("semantic_history", {"ranked": [], "query": query})
        if not query:
            return response("semantic_history", {"ranked": commands[:limit], "query": query})
        # Ask AI to rank
        cmd_block = "\n".join(f"{i+1}. {c}" for i, c in enumerate(commands[:50]))
        system = (
            "You are a shell history ranking assistant. "
            "Given a user query and a numbered list of shell commands, "
            "return ONLY a JSON array of the 20 most relevant commands in ranked order. "
            "No explanation, no markdown, just the JSON array of strings."
        )
        user_text = f"Query: {query}\n\nCommands:\n{cmd_block}"
        ai_resp = _claude_chat(user_text, system=system, timeout=10)
        ranked = commands[:limit]
        if ai_resp:
            import re as _re_hist
            raw = ai_resp.get("response") or ""
            m = _re_hist.search(r'\[.*\]', raw, _re_hist.DOTALL)
            if m:
                try:
                    ranked = json.loads(m.group(0))[:limit]
                except json.JSONDecodeError:
                    pass
        return response("semantic_history", {"ranked": ranked, "query": query})

    if action in ("runbook_list", "runbook-list"):
        search_dirs = [
            Path(request.get("dir", ".")) / ".turtle" / "runbooks",
            Path.home() / ".config" / "turtleterm" / "runbooks",
        ]
        runbooks = []
        for d in search_dirs:
            if d.exists():
                for f in sorted(d.glob("*.yaml")) + sorted(d.glob("*.yml")):
                    try:
                        import importlib.util as _ilu  # noqa: F401
                        # Try yaml, fall back to simple parse
                        try:
                            import yaml as _yaml
                            data = _yaml.safe_load(f.read_text())
                        except ImportError:
                            data = {"name": f.stem, "description": "", "steps": []}
                        runbooks.append({
                            "name": data.get("name", f.stem),
                            "description": data.get("description", ""),
                            "steps": len(data.get("steps", [])),
                            "file": str(f),
                        })
                    except Exception:  # noqa: BLE001
                        runbooks.append({"name": f.stem, "file": str(f), "steps": 0})
        return response("runbook_list", {"runbooks": runbooks, "count": len(runbooks)})

    if action in ("runbook_show", "runbook-show"):
        name = request.get("name", "").strip()
        search_dirs = [
            Path(request.get("dir", ".")) / ".turtle" / "runbooks",
            Path.home() / ".config" / "turtleterm" / "runbooks",
        ]
        for d in search_dirs:
            for ext in (".yaml", ".yml"):
                f = d / (name + ext)
                if f.exists():
                    try:
                        try:
                            import yaml as _yaml2
                            data = _yaml2.safe_load(f.read_text())
                        except ImportError:
                            return response("runbook_show", {"raw": f.read_text()})
                        return response("runbook_show", {"runbook": data})
                    except Exception:  # noqa: BLE001
                        pass
        return response("error", {"message": f"runbook not found: {name}"}, status="error")

    if action in ("runbook_run", "runbook-run"):
        name = request.get("name", "").strip()
        search_dirs = [
            Path(request.get("dir", ".")) / ".turtle" / "runbooks",
            Path.home() / ".config" / "turtleterm" / "runbooks",
        ]
        rb_data: dict[str, Any] | None = None
        for d in search_dirs:
            for ext in (".yaml", ".yml"):
                f = d / (name + ext)
                if f.exists():
                    try:
                        try:
                            import yaml as _yaml3
                            rb_data = _yaml3.safe_load(f.read_text())
                        except ImportError:
                            return response("error", {"message": "PyYAML not installed: pip install pyyaml"}, status="error")
                        break
                    except Exception:  # noqa: BLE001
                        pass
            if rb_data:
                break
        if not rb_data:
            return response("error", {"message": f"runbook not found: {name}"}, status="error")
        # Delegate to plan_execute with runbook steps
        steps = rb_data.get("steps", [])
        goal  = rb_data.get("description", name)
        plan_request = {
            "action": "plan_execute",
            "goal": goal,
            "steps": [{"command": s.get("cmd", s) if isinstance(s, dict) else str(s),
                        "description": s.get("desc", "") if isinstance(s, dict) else ""} for s in steps],
        }
        return handle_request(plan_request)

    return response("error", {"message": f"unknown action: {action}"}, status="error")


# ---------------------------------------------------------------------------
# Server modes
# ---------------------------------------------------------------------------

def serve_stdio() -> int:
    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(json.dumps(response("error", {"message": str(exc)}, status="error")))
        return 2
    print(json.dumps(handle_request(request), indent=2, sort_keys=True))
    return 0


def serve_socket(path: Path) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        path.unlink()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    server.listen(8)
    print(json.dumps(response("listening", {"socket": str(path)})), flush=True)
    try:
        while True:
            conn, _ = server.accept()
            with conn:
                raw = conn.recv(4 * 1024 * 1024)
                try:
                    req = json.loads(raw.decode("utf-8"))
                    result = handle_request(req)
                except Exception as exc:  # noqa: BLE001
                    result = response("error", {"message": str(exc)}, status="error")
                conn.sendall((json.dumps(result, sort_keys=True) + "\n").encode("utf-8"))
    finally:
        server.close()
        if path.exists():
            path.unlink()


def serve_http(port: int) -> int:
    """Persistent HTTP daemon — POST /stdio accepts same JSON as --stdio, GET /health for status."""
    import http.server

    class _Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.path in ('/health', '/healthz'):
                body = json.dumps({
                    "status": "ok", "service": "turtle-agentd",
                    "version": "0.2.0", "mode": "http-daemon",
                }).encode()
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            else:
                self.send_response(404)
                self.end_headers()

        def do_POST(self) -> None:
            length = int(self.headers.get('Content-Length', '0') or '0')
            raw = self.rfile.read(length)
            try:
                req = json.loads(raw.decode('utf-8'))
                result = handle_request(req)
            except Exception as exc:  # noqa: BLE001
                result = response('error', {'message': str(exc)}, status='error')
            body = json.dumps(result, sort_keys=True).encode()
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args: Any) -> None:
            pass  # silence access logs

    httpd = http.server.HTTPServer(('127.0.0.1', port), _Handler)
    startup = json.dumps(response('listening', {'http': f'http://127.0.0.1:{port}', 'port': port}))
    print(startup, flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def _install_launchd() -> int:
    """Install a launchd plist so agentd auto-starts on login (macOS only)."""
    import platform, shutil
    if platform.system() != "Darwin":
        print(json.dumps({"status": "error", "message": "launchd only available on macOS"}))
        return 1
    agentd_path = shutil.which("turtle-agentd") or str(Path(__file__).resolve())
    plist_dir  = Path.home() / "Library" / "LaunchAgents"
    plist_path = plist_dir / "ai.sourceos.turtle-agentd.plist"
    plist_dir.mkdir(parents=True, exist_ok=True)
    plist_content = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.sourceos.turtle-agentd</string>
    <key>ProgramArguments</key>
    <array>
        <string>{agentd_path}</string>
        <string>--http</string>
        <string>7722</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{Path.home()}/.local/state/sourceos/turtle-agentd.log</string>
    <key>StandardErrorPath</key>
    <string>{Path.home()}/.local/state/sourceos/turtle-agentd.err</string>
</dict>
</plist>"""
    plist_path.write_text(plist_content)
    import subprocess as _sp_ld
    _sp_ld.run(["launchctl", "load", "-w", str(plist_path)], check=False)
    print(json.dumps({
        "status": "ok", "message": "launchd plist installed",
        "plist": str(plist_path),
        "hint": "turtle-agentd will now auto-start on login and restart if it crashes",
    }, indent=2))
    return 0


def _uninstall_launchd() -> int:
    plist_path = Path.home() / "Library" / "LaunchAgents" / "ai.sourceos.turtle-agentd.plist"
    if not plist_path.exists():
        print(json.dumps({"status": "error", "message": "plist not found"}))
        return 1
    import subprocess as _sp_ld2
    _sp_ld2.run(["launchctl", "unload", str(plist_path)], check=False)
    plist_path.unlink()
    print(json.dumps({"status": "ok", "message": "launchd plist removed"}))
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="TurtleTerm local agent gateway v0")
    parser.add_argument("--stdio", action="store_true", help="read one JSON request from stdin and write one JSON response")
    parser.add_argument("--socket", default=str(default_socket_path()), help="Unix socket path for daemon mode")
    parser.add_argument("--http", type=int, nargs="?", const=7722, metavar="PORT",
                        help="Start persistent HTTP daemon on PORT (default: 7722)")
    parser.add_argument("--install-launchd", action="store_true",
                        help="Install launchd plist for auto-start on login (macOS only)")
    parser.add_argument("--uninstall-launchd", action="store_true",
                        help="Remove the launchd plist")
    args = parser.parse_args(argv)

    if args.http is not None:
        return serve_http(args.http)
    if args.install_launchd:
        return _install_launchd()
    if args.uninstall_launchd:
        return _uninstall_launchd()
    if args.stdio:
        return serve_stdio()
    return serve_socket(Path(args.socket))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
