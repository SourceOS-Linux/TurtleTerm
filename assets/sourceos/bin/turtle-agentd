        except Exception as e:  # noqa: BLE001
            return response("docker_list", {"containers": [], "error": str(e)})

    if action in ("docker_exec", "docker-exec"):
        container = request.get("container", "").strip()
        cmd_to_run = request.get("command", "bash")
        if not container:
            return response("error", {"message": "container required"}, status="error")
        # Write the exec command to pending queue so it appears in terminal
