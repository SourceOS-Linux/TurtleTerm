        if str(port) != "22":
            parts.extend(["-p", str(port)])
        if identity:
            parts.extend(["-i", identity])
        parts.append(host)
        ssh_cmd = " ".join(parts)
        pending_dir = Path.home() / ".local" / "state" / "sourceos" / "terminal"
        pending_dir.mkdir(parents=True, exist_ok=True)
        (pending_dir / "pending_command").write_text(ssh_cmd)
        (pending_dir / "pending_command.json").write_text(json.dumps({
            "source": "ssh_connect",
            "description": f"SSH to {host}",
        }))
