#!/usr/bin/env python3
"""TurtleTerm SynapseIQ LSP bridge.

Manages the SynapseIQ language intelligence server — starts, stops, and reports status.
The server provides diagnostics, symbols, hover, and completions at http://127.0.0.1:2087.

Usage:
  turtle-synapseiq start     Start the LSP server in the background
  turtle-synapseiq stop      Stop the running server
  turtle-synapseiq status    Check if the server is running and reachable
  turtle-synapseiq restart   Stop then start
  turtle-synapseiq install              Locate and validate the server script
  turtle-synapseiq install-launchagent  Install + load macOS LaunchAgent (auto-start at login)
  turtle-synapseiq uninstall-launchagent  Unload + remove the LaunchAgent
"""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
from pathlib import Path
from urllib import error as urlerror
from urllib import request as urlrequest


PORT = int(os.environ.get("SYNAPSEIQ_LSP_PORT", "2087"))
PID_FILE = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))) / "sourceos" / "synapseiq-lsp.pid"


def find_server_script() -> Path | None:
    candidates = [
        os.environ.get("SOURCEOS_SYNAPSEIQ_SERVER", ""),
        str(Path(__file__).parent.parent.parent.parent.parent / "synapseiq" / "packages" / "lsp" / "src" / "server.js"),
        str(Path.home() / "dev" / "synapseiq" / "packages" / "lsp" / "src" / "server.js"),
        "/opt/homebrew/share/turtleterm/synapseiq/server.js",
        "/usr/local/share/turtleterm/synapseiq/server.js",
        str(Path.home() / ".local" / "share" / "turtleterm" / "synapseiq" / "server.js"),
    ]
    for c in candidates:
        if c and Path(c).exists():
            return Path(c)
    return None


def health_check() -> dict | None:
    try:
        with urlrequest.urlopen(f"http://127.0.0.1:{PORT}/health", timeout=2) as r:
            return json.loads(r.read().decode())
    except (urlerror.URLError, OSError):
        return None


def read_pid() -> int | None:
    try:
        return int(PID_FILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        return None


def cmd_start() -> int:
    h = health_check()
    if h:
        print(f"synapseiq-lsp already running on :{PORT} (v{h.get('version', '?')})")
        return 0

    script = find_server_script()
    if not script:
        print("ERROR: server.js not found. Set SOURCEOS_SYNAPSEIQ_SERVER or clone synapseiq repo to ~/dev/synapseiq", file=sys.stderr)
        return 1

    env = {**os.environ, "SYNAPSEIQ_LSP_PORT": str(PORT)}
    proc = subprocess.Popen(
        ["node", str(script)],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    PID_FILE.parent.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(proc.pid))

    # Wait for it to be reachable
    import time
    for _ in range(10):
        time.sleep(0.3)
        if health_check():
            print(f"synapseiq-lsp started (pid {proc.pid}) → http://127.0.0.1:{PORT}")
            return 0

    print(f"synapseiq-lsp started (pid {proc.pid}) but health check timed out — check logs", file=sys.stderr)
    return 1


def cmd_stop() -> int:
    pid = read_pid()
    if not pid:
        print("synapseiq-lsp not running (no pid file)")
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
        PID_FILE.unlink(missing_ok=True)
        print(f"stopped pid {pid}")
        return 0
    except ProcessLookupError:
        PID_FILE.unlink(missing_ok=True)
        print(f"pid {pid} was not running; cleared stale pid file")
        return 0
    except PermissionError as e:
        print(f"could not stop pid {pid}: {e}", file=sys.stderr)
        return 1


def cmd_status() -> int:
    h = health_check()
    pid = read_pid()
    if h:
        print(json.dumps({"status": "running", "pid": pid, "port": PORT, **h}, indent=2))
        return 0
    else:
        print(json.dumps({"status": "stopped", "pid": pid, "port": PORT}))
        return 1


def cmd_install() -> int:
    script = find_server_script()
    if script:
        print(f"found: {script}")
        return 0
    print("not found — set SOURCEOS_SYNAPSEIQ_SERVER or clone synapseiq to ~/dev/synapseiq", file=sys.stderr)
    return 1


def _find_plist_template() -> Path | None:
    """Locate the LaunchAgent plist template bundled with TurtleTerm."""
    candidates = [
        # Relative to this script: bin/ -> sourceos/ -> macos/
        Path(__file__).parent.parent / "macos" / "com.sourceos.synapseiq-lsp.plist",
        # Dev layout: assets/sourceos/macos/
        Path(__file__).parent.parent.parent.parent / "assets" / "sourceos" / "macos" / "com.sourceos.synapseiq-lsp.plist",
        # Installed prefix locations
        Path("/opt/homebrew/share/turtleterm/macos/com.sourceos.synapseiq-lsp.plist"),
        Path("/usr/local/share/turtleterm/macos/com.sourceos.synapseiq-lsp.plist"),
        Path.home() / ".local" / "share" / "turtleterm" / "macos" / "com.sourceos.synapseiq-lsp.plist",
    ]
    for c in candidates:
        if c.exists():
            return c
    return None


def cmd_install_launchagent() -> int:
    """Install and load the SynapseIQ LSP LaunchAgent for the current user."""
    script = find_server_script()
    if not script:
        print(
            "ERROR: server.js not found. Set SOURCEOS_SYNAPSEIQ_SERVER or clone synapseiq to ~/dev/synapseiq",
            file=sys.stderr,
        )
        return 1

    template = _find_plist_template()
    if not template:
        print(
            "ERROR: plist template not found. Expected at assets/sourceos/macos/com.sourceos.synapseiq-lsp.plist",
            file=sys.stderr,
        )
        return 1

    log_dir = Path.home() / "Library" / "Logs" / "sourceos"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = str(log_dir / "synapseiq-lsp.log")
    err_path = str(log_dir / "synapseiq-lsp.err.log")

    plist_content = template.read_text()
    plist_content = plist_content.replace("SYNAPSEIQ_SERVER_PATH", str(script))
    plist_content = plist_content.replace("SYNAPSEIQ_LOG_PATH", log_path)
    plist_content = plist_content.replace("SYNAPSEIQ_ERR_PATH", err_path)

    dest = Path.home() / "Library" / "LaunchAgents" / "com.sourceos.synapseiq-lsp.plist"
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(plist_content)
    print(f"wrote: {dest}")

    result = subprocess.run(
        ["launchctl", "load", str(dest)],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        print(f"loaded: com.sourceos.synapseiq-lsp (port {PORT})")
        print(f"logs:   {log_path}")
        print(f"errors: {err_path}")
        return 0
    else:
        print(f"launchctl load failed: {result.stderr.strip()}", file=sys.stderr)
        return 1


def cmd_uninstall_launchagent() -> int:
    """Unload and remove the SynapseIQ LSP LaunchAgent."""
    dest = Path.home() / "Library" / "LaunchAgents" / "com.sourceos.synapseiq-lsp.plist"
    if dest.exists():
        result = subprocess.run(
            ["launchctl", "unload", str(dest)],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            # Not fatal — may already be unloaded
            print(f"launchctl unload: {result.stderr.strip()}", file=sys.stderr)
        dest.unlink()
        print(f"removed: {dest}")
    else:
        print(f"not installed: {dest}")
    return 0


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "start":
        return cmd_start()
    elif cmd == "stop":
        return cmd_stop()
    elif cmd == "restart":
        cmd_stop()
        return cmd_start()
    elif cmd == "status":
        return cmd_status()
    elif cmd == "install":
        return cmd_install()
    elif cmd == "install-launchagent":
        return cmd_install_launchagent()
    elif cmd == "uninstall-launchagent":
        return cmd_uninstall_launchagent()
    else:
        print(__doc__)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
