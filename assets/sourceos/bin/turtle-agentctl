            "policy-check":          ["command", "cwd"],
            "install_hooks":         ["cwd"],
            "install-hooks":         ["cwd"],
            "uninstall_hooks":       ["cwd"],
            "uninstall-hooks":       ["cwd"],
            "dashboard":             [],
            "gitea-pr-create":       ["title"],
            "gitea-issue-create":    ["title"],
            "gitea-release-create":  ["tag"],
            "gitea-ci-watch":        ["run_id"],
            "process-watch":         ["command"],
            "history-search":        ["query"],
            "scratchpad-write":      ["content", "key"],
            "scratchpad-read":       ["key"],
        }
        field_names = _pos_map.get(raw_action, ["text"])
        for idx, val in enumerate(pos_args):
            if idx < len(field_names):
                payload[field_names[idx]] = val
            else:
                # append to last known field as space-joined
                payload[field_names[-1]] = payload.get(field_names[-1], "") + " " + val

        # Special: add cwd for actions that benefit from it
        if raw_action in ("git-context", "git_context", "file-tree", "file_tree",
                          "inline-diff", "inline_diff", "env-inspect", "env_inspect",
                          "session-to-pr", "session_to_pr") and "cwd" not in payload:
            payload["cwd"] = os.getcwd()

        request = payload
    else:
        parser.print_help(sys.stderr)
        return 2

    return print_json(send_request(request, args.stdio))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
