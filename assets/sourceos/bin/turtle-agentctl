        request = {"action": "agent_machine_surfaces"}
    elif args.command == "agent-machine-probe":
        request = {"action": "agent_machine_probe"}
    elif args.command == "cloudfog-surfaces":
        request = {"action": "cloudfog_surfaces"}
    elif args.command == "cloudfog-inspect":
        request = {"action": "cloudfog_inspect", "surface_id": args.surface_id}
    elif args.command == "ingest-event":
        import sys as _sys
        raw = _sys.stdin.read() if args.event_json == "-" else args.event_json
        try:
            event = json.loads(raw)
        except json.JSONDecodeError as exc:
            print(json.dumps({"status": "error", "message": str(exc)}))
            return 2
        request = {"action": "ingest_event", "event": event}
    elif args.command == "noetica-status":
        request = {"action": "noetica_status"}
    elif args.command == "noetica-query":
        request = {"action": "noetica_query", "text": join_remainder(args.text)}
    elif args.command == "policy-status":
        request = {"action": "policy_status"}
    elif args.command == "bearbrowser-handoff":
        task = join_remainder(args.task)
        if not task:
            print(json.dumps({"status": "error", "message": "bearbrowser-handoff requires a task description"}))
            return 2
        request = {"action": "bearbrowser_handoff", "task": task}
    elif args.command == "explain-selection":
        raw = join_remainder(args.text)
        if raw == "-":
            raw = sys.stdin.read()
