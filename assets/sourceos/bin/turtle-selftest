def test_mcp_plan_tools() -> None:
    mcp = Path(__file__).parent.parent / 'mcp' / 'turtle-mcp-server'
    if not mcp.exists():
        skip('mcp plan tools', 'turtle-mcp-server not found')
        return
    content = mcp.read_text()
    for tool in ('plan_create', 'plan_status', 'plan_advance', 'plan_abort', 'workspace_list',
                 'terminal_execute_with_confirmation',
                 'language_hover', 'language_definition', 'language_references', 'language_format'):
        if tool in content:
            ok(f'mcp tool: {tool}')
        else:
            fail(f'mcp tool: {tool}', f'not found in turtle-mcp-server')

    for tool in ('terminal_events_since', 'terminal_wait_for_command',
                 'bookmark_add', 'bookmark_list', 'bookmark_remove',
                 'runbook_list', 'runbook_run', 'runbook_show',
                 'detect_secrets', 'pre_exec_risk', 'shellcheck_lint',
                 'inline_diff', 'env_inspect', 'docker_list', 'docker_exec',
                 'ssh_profiles', 'ssh_connect'):
        if tool in content:
            ok(f'mcp tool: {tool}')
        else:
            fail(f'mcp tool: {tool}', f'not found in turtle-mcp-server')

    if '1.1.0' in content or '1.0.0' in content or '0.9.0' in content or '0.8.0' in content or '0.7.0' in content or '0.6.0' in content or '0.5.0' in content:
        ok('mcp version current')
    else:
        fail('mcp version current', 'version not updated')

    if '_synapseiq' in content:
        ok('mcp _synapseiq helper')
    else:
        fail('mcp _synapseiq helper', 'not found')


def test_neovim_plugin() -> None:
    nvim_paths = [
        Path(__file__).parent.parent / 'neovim' / 'plugin' / 'turtle.vim',
        Path('/opt/homebrew/share/turtle-term/neovim/plugin/turtle.vim'),
    ]
    found = next((p for p in nvim_paths if p.exists()), None)
    if not found:
        skip('neovim plugin', 'turtle.vim not found')
        return
    content = found.read_text()
    checks = [
        ('auto-start LSP on FileType',    'TurtleSynapseIQLSP'),
        ('lsp.start call',                'lsp.start('),
        ('K → hover binding',             'lsp.buf.hover'),
        ('gd → definition binding',       'lsp.buf.definition'),
        ('C-k → signature help',          'lsp.buf.signature_help'),
        ('CursorHold diagnostics float',  'CursorHold'),
        ('plan commands',                 'TurtlePlan'),
        ('explain command',               'TurtleExplain'),
    ]
    checks += [
        ('Leader-f format binding',  'lsp.buf.format'),
        ('inlay hints enable',       'inlay_hint'),
    ]
    import re as _re
    for name, needle in checks:
        if needle in content:
            ok(f'nvim: {name}')
        else:
            fail(f'nvim: {name}', f'"{needle}" not in turtle.vim')


def test_completions() -> None:
    """B5 — agentctl completion files."""
    shell_dir = Path(__file__).parent.parent / 'shell'
    for fname, needle in [
        ('turtle-agentctl-completions.zsh',  '_turtle_agentctl'),
        ('turtle-agentctl-completions.bash', '_turtle_agentctl_completions'),
        ('turtle-agentctl-completions.fish', 'turtle-agentctl'),
    ]:
        p = shell_dir / fname
        if p.exists():
            content = p.read_text()
            if needle in content:
                ok(f'completion: {fname}', f'{needle} defined')
            else:
                fail(f'completion: {fname}', f'{needle} not found in file')
        else:
            fail(f'completion: {fname}', f'file not found at {p}')


def test_language_binary() -> None:
    lang = Path(__file__).parent / 'turtle-language'
    if lang.exists():
        r = subprocess.run([sys.executable, str(lang), 'synapseiq-status'], capture_output=True, text=True, timeout=5)
        ok('turtle-language binary', 'synapseiq-status exit=' + str(r.returncode))
    else:
        skip('turtle-language binary', 'not found')


def test_lua_config() -> None:
    lua = Path(__file__).parent.parent / 'turtleterm.lua'
    if not lua.exists():
        lua = Path('/opt/homebrew/share/turtle-term/turtleterm.lua')
    if lua.exists():
        content = lua.read_text()
        checks = [
            ('CMD+P command palette',        'turtle_command_palette()'),
            ('CMD+SHIFT+E block explain',    'turtle_block_explain_last()'),
            ('CTRL+SHIFT+M planner bind',    'turtle_plan()'),
            ('CMD+SHIFT+N plan-next (fixed)','CMD|SHIFT.*plan_next'),
            ('CTRL+SHIFT+I theme picker',    'turtle_theme_picker()'),
            ('BearBrowser open-uri routing', "open-uri"),
            ('AI sidebar',                   'turtle_ai_sidebar'),
            ('history search',               'turtle_history_search'),
            ('OSC 133 prompt jump',          'ScrollToPrompt'),
            ('SynapseIQ auto-start',         'turtle-synapseiq start'),
            ('right-click context menu',     'turtle_block_context_menu'),
            ('workspace save CMD+SHIFT+S',   'turtle_workspace_save'),
            ('workspace restore CMD+SHIFT+O','turtle_workspace_restore'),
            ('plan step right-status badge', 'plan_badge'),
            ('workspace startup offer',      '_ws_restore_name'),
            ('CMD+SHIFT+S save bind',        'turtle_workspace_save.*CMD|SHIFT.*s|key.*s.*CMD.SHIFT'),
            ('CMD+SHIFT+O restore bind',     'turtle_workspace_restore.*CMD|SHIFT.*o|key.*o.*CMD.SHIFT'),
            ('plan auto-advance on exit 0',  '_turtle_plan_waiting'),
            ('plan fail toast',              'Step failed.*exit'),
            ('persistent theme read',        'theme.txt'),
            ('output zone capture B3',       'step_output.txt'),
            ('tab title restore B6',         'set_title.*tab_data.title|tab_data.title.*set_title'),
        ]
        import re as _re
        for name, needle in checks:
            hit = (_re.search(needle, content) is not None) if ('.*' in needle or '[' in needle) else (needle in content)
            if hit:
                ok(f'lua: {name}')
            else:
                fail(f'lua: {name}', f'"{needle}" not found in turtleterm.lua')
    else:
        skip('lua config checks', 'turtleterm.lua not found')


def test_update_notifier() -> None:
    """W2-F — Check for newer TurtleTerm version via GitHub API."""
    import urllib.request as _ur
    import urllib.error as _ue
    try:
        with _ur.urlopen(
            "https://api.github.com/repos/SourceOS-Linux/TurtleTerm/releases/latest",
            timeout=4,
        ) as resp:
            data = json.loads(resp.read())
            tag = data.get("tag_name", "")
            # strip prefix like 'turtle-term-v' or 'v'
            latest = tag.lstrip("v")
            for prefix in ("turtle-term-v", "turtle-term-"):
                if latest.startswith(prefix):
                    latest = latest[len(prefix):]
            current = "0.5.0"
            def _ver(v: str) -> tuple:
                try: return tuple(int(x) for x in v.split("."))
                except ValueError: return (0,)
            if latest and _ver(latest) > _ver(current):
                skip("update notifier", f"upstream release {latest} available (dev is ahead to {current})")
            else:
                ok("update notifier", f"dev v{current} ≥ latest release v{latest}")
    except (_ue.URLError, OSError):
        skip("update notifier", "GitHub API not reachable (offline or rate-limited)")


def test_runbook_script() -> None:
    """W1-C — turtle-runbook script exists and responds to help."""
    import subprocess as _sp
    rb = Path(__file__).parent / "turtle-runbook"
    if not rb.exists():
        fail("turtle-runbook script", f"not found at {rb}")
        return
    ok("turtle-runbook script", str(rb))
    r = _sp.run([sys.executable, str(rb), "--help"], capture_output=True, text=True, timeout=5)
    if "list" in r.stdout and "run" in r.stdout:
        ok("turtle-runbook --help", "list/run/show/create documented")
    else:
        fail("turtle-runbook --help", f"unexpected output: {r.stdout[:100]}")


def test_agentd_new_actions() -> None:
    """W1-B/C/D/F — Test new agentd actions added in supremacy sprint."""
    # Bookmark round-trip
    r = agentd({"action": "bookmark_add", "command": "__selftest_bookmark__"})
    if r and r.get("status") == "ok":
        ok("agentd bookmark_add")
    else:
        fail("agentd bookmark_add", str(r))

    r = agentd({"action": "bookmark_list"})
    if r and r.get("status") == "ok":
        bmarks = r.get("data", {}).get("bookmarks", [])
        if any(b.get("cmd") == "__selftest_bookmark__" for b in bmarks):
            ok("agentd bookmark_list", f"{len(bmarks)} bookmarks")
        else:
            fail("agentd bookmark_list", "selftest bookmark not found")
    else:
        fail("agentd bookmark_list", str(r))

    r = agentd({"action": "bookmark_remove", "command": "__selftest_bookmark__"})
    if r and r.get("status") == "ok":
        ok("agentd bookmark_remove", f"removed={r.get('data',{}).get('removed',0)}")
    else:
        fail("agentd bookmark_remove", str(r))

    # Semantic history (no API key — should return graceful fallback)
    r = agentd({"action": "semantic_history", "query": "list files", "commands": ["ls -la", "find . -name '*.py'", "git status"], "limit": 3})
    if r and r.get("status") == "ok":
        ranked = r.get("data", {}).get("ranked", [])
        ok("agentd semantic_history", f"{len(ranked)} results (fallback ok without API key)")
    else:
        fail("agentd semantic_history", str(r))

    # Runbook list (should return empty list gracefully)
    r = agentd({"action": "runbook_list", "dir": "/tmp"})
    if r and r.get("status") == "ok":
        ok("agentd runbook_list", f"{r.get('data',{}).get('count',0)} runbooks in /tmp")
    else:
        fail("agentd runbook_list", str(r))

    # G1: Secret detector
    r = agentd({"action": "detect_secrets", "text": "export OPENAI_API_KEY=sk-proj-abcdef1234567890abcdef1234567890"})
    if r and r.get("status") == "ok":
        d = r.get("data", {})
        if not d.get("safe") and d.get("count", 0) > 0:
            ok("agentd detect_secrets", f"caught {d['count']} secret(s): {d['secrets'][0]['type']}")
        else:
            fail("agentd detect_secrets", f"missed obvious OpenAI key — {d}")
    else:
        fail("agentd detect_secrets", str(r))

    r2 = agentd({"action": "detect_secrets", "text": "echo hello world"})
    if r2 and r2.get("data", {}).get("safe"):
        ok("agentd detect_secrets (safe text)")
    else:
        fail("agentd detect_secrets (safe text)", str(r2))

    # G2: Pre-exec risk
    r = agentd({"action": "pre_exec_risk", "command": "rm -rf /tmp/test"})
    if r and r.get("status") == "ok":
        d = r.get("data", {})
        if d.get("score", 0) >= 6:
            ok("agentd pre_exec_risk", f"score={d['score']} risk={d['risk']} reasons={d.get('reasons',[])[0] if d.get('reasons') else '?'}")
        else:
            fail("agentd pre_exec_risk", f"expected high score for rm -rf, got {d}")
    else:
        fail("agentd pre_exec_risk", str(r))

    r2 = agentd({"action": "pre_exec_risk", "command": "ls -la"})
    if r2 and r2.get("data", {}).get("risk") in ("safe", "low"):
        ok("agentd pre_exec_risk (safe cmd)")
    else:
        fail("agentd pre_exec_risk (safe cmd)", str(r2))

    # G4: Shellcheck lint
    r = agentd({"action": "shellcheck_lint", "text": "if [ $x -eq 1\nthen\n  echo hi\n", "shell": "bash"})
    if r and r.get("status") == "ok":
        d = r.get("data", {})
        ok("agentd shellcheck_lint", f"tool={d.get('tool','?')} issues={len(d.get('issues',[]))} clean={d.get('clean')}")
    else:
        fail("agentd shellcheck_lint", str(r))

    # G5: Inline diff (git repo check)
    r = agentd({"action": "inline_diff", "cwd": str(Path.home() / "dev" / "TurtleTerm")})
    if r and r.get("status") == "ok":
        d = r.get("data", {})
        ok("agentd inline_diff", f"available={d.get('available')} has_changes={d.get('has_changes')}")
    else:
        fail("agentd inline_diff", str(r))

    # G6: Env inspect
    r = agentd({"action": "env_inspect", "prefix": "HOME"})
    if r and r.get("status") == "ok":
        d = r.get("data", {})
        if d.get("env") and "HOME" in d.get("env", {}):
            ok("agentd env_inspect", f"{d.get('count',0)} vars, HOME={d['env'].get('HOME','?')[:30]}")
        else:
            fail("agentd env_inspect", f"HOME not found in env — {list(d.get('env',{}).keys())[:5]}")
    else:
        fail("agentd env_inspect", str(r))

    # G7: Docker list (graceful if Docker not running)
    r = agentd({"action": "docker_list"})
    if r and r.get("status") == "ok":
        d = r.get("data", {})
        if "error" in d and "not installed" in d["error"]:
            skip("agentd docker_list", "docker not installed")
        else:
            ok("agentd docker_list", f"{d.get('count',0)} containers")
    else:
        fail("agentd docker_list", str(r))

    # G8: SSH profiles
    r = agentd({"action": "ssh_profiles"})
    if r and r.get("status") == "ok":
        d = r.get("data", {})
        ok("agentd ssh_profiles", f"{d.get('count',0)} profiles from ~/.ssh/config")


