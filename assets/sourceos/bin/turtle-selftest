def test_gitea_surface():
    r = agentd({"action": "gitea-status"})
    assert r and r.get("status") == "ok", f"gitea-status failed: {r}"
    d = r["data"]
    # Online OR offline with correct structure — both valid without live Gitea
    assert "online" in d, f"bad gitea-status response: {d}"
    if d.get("online"):
        ok(f"gitea status (ONLINE v{d.get('version','?')} user={d.get('user','?')})")
    else:
        ok(f"gitea status (offline — GITEA_URL not set, expected in dev)")
    # PR list should handle gracefully even without Gitea
    r2 = agentd({"action": "gitea-pr-list", "cwd": "/tmp"})
    assert r2 and r2.get("status") == "ok"
    ok("gitea_pr_list (graceful without remote)")

