def test_mcp_v06():
    """Verify MCP server reports v0.5.0 or v0.6.0."""
    import subprocess as _sp_mcp
    mcp_path = Path.home() / "dev" / "TurtleTerm" / "assets" / "sourceos" / "mcp" / "turtle-mcp-server"
    r = _sp_mcp.run(
        [sys.executable, str(mcp_path)],
        input=json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"1"}}}),
        capture_output=True, text=True, timeout=10,
    )
    assert "0.5.0" in r.stdout or "0.6.0" in r.stdout or "0.7.0" in r.stdout or "0.8.0" in r.stdout or "0.9.0" in r.stdout or "1.0.0" in r.stdout, f"MCP not reporting any known version: {r.stdout[:300]}"
    ok("mcp_v0.5.0_or_later")


def test_t1_memory():
    r = _agentd({"action": "memory-add", "key": "test-selftest-key", "value": "TurtleTerm selftest memory value", "tags": ["test"]})
    assert r and r.get("status") == "ok", f"memory-add failed: {r}"
    assert r["data"].get("saved") == True, f"not saved: {r}"
    r2 = _agentd({"action": "memory-list", "query": "selftest"})
    assert r2 and r2.get("status") == "ok"
    entries = r2["data"].get("memories", [])
    assert any(m.get("key") == "test-selftest-key" for m in entries), f"memory not listed: {entries}"
    r3 = _agentd({"action": "memory-search", "query": "TurtleTerm selftest"})
    assert r3 and r3.get("status") == "ok"
    r4 = _agentd({"action": "memory-forget", "key": "test-selftest-key"})
    assert r4 and r4["data"].get("removed") == True
    _ok("T1-A memory_add/list/search/forget")

