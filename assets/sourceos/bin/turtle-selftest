def test_new_scripts():
    import subprocess
    scripts = [
        ("turtle-perf", "--help"),
        ("turtle-persona", "--help"),
        ("turtle-files", "--help"),
    ]
    bin_dir = Path.home() / "dev" / "TurtleTerm" / "assets" / "sourceos" / "bin"
    for script_name, flag in scripts:
        sp = bin_dir / script_name
        assert sp.exists(), f"script not found: {sp}"
        r = subprocess.run([sys.executable, str(sp), flag], capture_output=True, text=True, timeout=5)
        assert r.returncode == 0 or r.returncode == 1, f"{script_name} crashed: {r.stderr}"
    _ok("new scripts: turtle-perf, turtle-persona, turtle-files")


def test_synapseiq_v08_code_actions():
    """Test SynapseIQ v0.8.0 code actions endpoint."""
    import urllib.request as _ur
    import json as _jca
    payload = _jca.dumps({
        "text": "const x: number = 'hello';",
        "filename": "/tmp/test.ts",
        "range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 0}},
        "diagnostics": [],
    }).encode()
    try:
        with _ur.urlopen("http://localhost:2087/lsp/code-actions", data=payload, timeout=5) as r:
            data = _jca.loads(r.read())
        actions = data.get("code_actions", [])
        # May be empty list — that's fine, endpoint must exist and return
        assert isinstance(actions, list), f"code_actions not a list: {data}"
        ok("synapseiq code_actions endpoint")
    except Exception as e:
        fail("synapseiq code_actions endpoint", str(e))

