    assert len(r["data"]["builtin"]) >= 3
    ok(f"chain_list ({r['data']['total']} total)")

    r2 = agentd({"action": "chain-run", "name": "nonexistent-xyz"})
    assert r2 and r2.get("status") == "ok"
    assert r2["data"].get("run") == False
    ok("chain_run (graceful not-found)")

