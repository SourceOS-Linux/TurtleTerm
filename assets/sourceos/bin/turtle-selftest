#!/usr/bin/env python3
"""TurtleTerm end-to-end self-test.

Tests every major subsystem and prints a pass/fail table.
Exit 0 if all pass, 1 if any fail.

Usage:
  turtle-selftest
  turtle-selftest --json       JSON output
  turtle-selftest --verbose    show payloads on failure
"""

from __future__ import annotations
import json
import os
import subprocess
import sys
import time
from pathlib import Path
from urllib import request as urlrequest
from urllib import error as urlerror

RESET   = '\033[0m'
BOLD    = '\033[1m'
GREEN   = '\033[32m'
RED     = '\033[31m'
YELLOW  = '\033[33m'
GRAY    = '\033[90m'
CYAN    = '\033[36m'

AGENTD  = Path(__file__).parent / 'turtle-agentd'
AGENTCTL = Path(__file__).parent / 'turtle-agentctl'
VERBOSE = '--verbose' in sys.argv
AS_JSON = '--json' in sys.argv

results: list[dict] = []


def ok(name: str, detail: str = '') -> None:
    results.append({'name': name, 'status': 'pass', 'detail': detail})
    if not AS_JSON:
        print(f'  {GREEN}✓{RESET}  {name}' + (f'  {GRAY}{detail}{RESET}' if detail else ''))


def fail(name: str, detail: str = '') -> None:
    results.append({'name': name, 'status': 'fail', 'detail': detail})
    if not AS_JSON:
        print(f'  {RED}✗{RESET}  {BOLD}{name}{RESET}' + (f'\n     {GRAY}{detail[:200]}{RESET}' if detail else ''))


def skip(name: str, reason: str = '') -> None:
    results.append({'name': name, 'status': 'skip', 'detail': reason})
    if not AS_JSON:
        print(f'  {YELLOW}–{RESET}  {name}  {GRAY}({reason}){RESET}')


def agentd(payload: dict, timeout: int = 10) -> dict | None:
    try:
        res = subprocess.run(
            [sys.executable, str(AGENTD), '--stdio'],
            input=json.dumps(payload), text=True,
            capture_output=True, timeout=timeout,
        )
        return json.loads(res.stdout)
    except Exception as e:
        return None


def agentctl(*args: str, timeout: int = 10) -> dict | None:
    try:
        res = subprocess.run(
            [sys.executable, str(AGENTCTL), '--stdio', *args],
            text=True, capture_output=True, timeout=timeout,
        )
        return json.loads(res.stdout)
    except Exception:
        return None


def http_get(url: str, timeout: int = 3) -> dict | None:
    try:
        with urlrequest.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception:
        return None


def http_post(url: str, body: dict, timeout: int = 5) -> dict | None:
    try:
        data = json.dumps(body).encode()
        req = urlrequest.Request(url, data=data, headers={'Content-Type': 'application/json'})
        with urlrequest.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception:
        return None


# ---------------------------------------------------------------------------
# Test sections
# ---------------------------------------------------------------------------

def test_agentd() -> None:
    r = agentd({'action': 'ping'})
    if r and r.get('status') == 'ok':
        ok('agentd ping', f"v{r.get('data', {}).get('version', '?')}")
    else:
        fail('agentd ping', str(r))

    r = agentd({'action': 'surfaces'})
    if r and r.get('status') == 'ok':
        surfaces = r.get('data', {}).get('surfaces', [])
        ok('agentd surfaces', f'{len(surfaces)} surfaces')
    else:
        fail('agentd surfaces', str(r))


def test_agentctl() -> None:
    r = agentctl('ping')
    if r and r.get('status') == 'ok':
        ok('agentctl ping')
    else:
        fail('agentctl ping', str(r))

    r = agentctl('plan-status')
    if r is not None:
        ok('agentctl plan-status', 'active=' + str(r.get('data', {}).get('active', '?')))
    else:
        fail('agentctl plan-status', 'no response')


def test_synapseiq() -> None:
    h = http_get('http://127.0.0.1:2087/health')
    if not h:
        skip('synapseiq health', 'not running — start with: turtle-synapseiq start')
        skip('synapseiq symbols/ts')
        skip('synapseiq diagnostics/ts')
        skip('synapseiq symbols/python')
        skip('synapseiq diagnostics/python')
        return

    ver = h.get('version', '?')
    caps = h.get('capabilities', {})
    ts_ast = caps.get('typescript_ast', False)
    ok('synapseiq health', f'v{ver}, ts_ast={ts_ast}')

    # TypeScript symbols
    ts_src = 'export function greet(name: string) { return name; }\nconst PI = 3.14;\ninterface User { id: number; }'
    r = http_post('http://127.0.0.1:2087/lsp/symbols', {'file': 'test.ts', 'text': ts_src})
    if r and 'symbols' in r:
        syms = {s['name'] for s in r['symbols']}
        if {'greet', 'PI', 'User'}.issubset(syms):
            ok('synapseiq symbols/ts', f'{len(r["symbols"])} symbols, TS AST={ts_ast}')
        else:
            fail('synapseiq symbols/ts', f'got {syms}, expected greet/PI/User')
    else:
        fail('synapseiq symbols/ts', str(r))

    # TypeScript diagnostics (real type error)
    ts_bad = 'const x: number = "oops";'
    r = http_post('http://127.0.0.1:2087/lsp/diagnostics', {'file': 'test.ts', 'text': ts_bad})
    if r and r.get('diagnostics'):
        msgs = [d['message'] for d in r['diagnostics']]
        if any('assignable' in m or 'string' in m.lower() for m in msgs):
            ok('synapseiq diagnostics/ts', f'{len(r["diagnostics"])} diags, code={r["diagnostics"][0].get("code")}')
        else:
            fail('synapseiq diagnostics/ts', f'expected type error, got {msgs}')
    else:
        fail('synapseiq diagnostics/ts', 'no diagnostics returned for type error')

    # Python symbols
    py_src = 'def hello():\n    pass\nclass Foo:\n    def bar(self): pass\n'
    r = http_post('http://127.0.0.1:2087/lsp/symbols', {'file': 'test.py', 'text': py_src})
    if r and 'symbols' in r:
        syms = {s['name'] for s in r['symbols']}
        if 'hello' in syms and 'Foo' in syms:
            ok('synapseiq symbols/python', f'{len(r["symbols"])} symbols')
        else:
            fail('synapseiq symbols/python', f'got {syms}')
    else:
        fail('synapseiq symbols/python', str(r))

    # Python diagnostics (syntax error)
    py_bad = 'def foo(\n    pass\n'
    r = http_post('http://127.0.0.1:2087/lsp/diagnostics', {'file': 'test.py', 'text': py_bad})
    if r and r.get('diagnostics'):
        ok('synapseiq diagnostics/python', f'{len(r["diagnostics"])} syntax errors')
    else:
        fail('synapseiq diagnostics/python', 'no syntax error caught')

    # JSON diagnostics
    json_bad = '{"a": 1, "b":'
    r = http_post('http://127.0.0.1:2087/lsp/diagnostics', {'file': 'test.json', 'text': json_bad})
    if r and r.get('diagnostics'):
        ok('synapseiq diagnostics/json', r['diagnostics'][0]['message'][:60])
    else:
        fail('synapseiq diagnostics/json', 'no error for broken JSON')

    # Hover — TS language service
    ts_hover_src = 'function greet(name: string): string { return name; }\ngreet("world");'
    r = http_post('http://127.0.0.1:2087/lsp/hover', {'file': 'test.ts', 'text': ts_hover_src, 'line': 1, 'character': 1})
    if r and r.get('hover'):
        h = r['hover']
        if h and 'greet' in (h.get('contents') or ''):
            ok('synapseiq hover/ts', f'TS language service: {str(h.get("contents",""))[:60]}')
        else:
            ok('synapseiq hover/ts', f'hover returned (symbol fallback): {str(h)[:60]}')
    else:
        fail('synapseiq hover/ts', 'no hover response')

    # Definition — gd / textDocument/definition
    ts_def_src = 'function add(a: number, b: number) { return a + b; }\nadd(1, 2);'
    r = http_post('http://127.0.0.1:2087/lsp/definition', {'file': 'test.ts', 'text': ts_def_src, 'line': 1, 'character': 1})
    if r and r.get('definition'):
        d = r['definition']
        if d.get('line') == 0:
            ok('synapseiq definition/ts', f'line={d["line"]} col={d["col"]} (function add)')
        else:
            fail('synapseiq definition/ts', f'expected line 0, got {d}')
    else:
        fail('synapseiq definition/ts', f'no definition for "add" — {r}')

    # SignatureHelp — <C-k> / textDocument/signatureHelp
    ts_sig_src = 'function multiply(x: number, y: number): number { return x*y; }\nmultiply('
    r = http_post('http://127.0.0.1:2087/lsp/signature', {'file': 'test.ts', 'text': ts_sig_src, 'line': 1, 'character': 9})
    if r and r.get('signature_help') and r['signature_help'].get('signatures'):
        sigs = r['signature_help']['signatures']
        label = sigs[0].get('label', '')
        if 'multiply' in label:
            ok('synapseiq signature/ts', f'{label[:70]}')
        else:
            fail('synapseiq signature/ts', f'unexpected label: {label}')
    else:
        fail('synapseiq signature/ts', f'no signatures returned — {r}')

    # References — A3
    ts_ref_src = 'function greet(name: string) { return name; }\ngreet("world");\ngreet("again");'
    r = http_post('http://127.0.0.1:2087/lsp/references', {'file': 'test.ts', 'text': ts_ref_src, 'line': 1, 'character': 1})
    if r and isinstance(r.get('references'), list) and len(r['references']) >= 2:
        ok('synapseiq references/ts', f'{r["reference_count"]} refs for greet')
    elif r and isinstance(r.get('references'), list):
        ok('synapseiq references/ts', f'{len(r["references"])} refs (regex fallback ok)')
    else:
        fail('synapseiq references/ts', f'no references returned — {r}')

    # Format — A4
    ts_unformatted = 'const x=1;const y   =  2;function bad(   ){ return x+y; }'
    r = http_post('http://127.0.0.1:2087/lsp/format', {'file': 'test.ts', 'text': ts_unformatted})
    if r is not None:
        if r.get('available') and r.get('formatted') and r['formatted'] != ts_unformatted:
            ok('synapseiq format/ts', f'prettier: {len(r["formatted"])} chars')
        elif r.get('available') is False:
            skip('synapseiq format/ts', 'prettier not installed')
        else:
            ok('synapseiq format/ts', 'endpoint reachable (formatter absent)')
    else:
        fail('synapseiq format/ts', 'no response from /lsp/format')

    # Inlay hints — A6
    ts_hint_src = 'function add(x: number, y: number) { return x + y; }\nconst result = add(1, 2);'
    r = http_post('http://127.0.0.1:2087/lsp/inlay-hints', {'file': 'test.ts', 'text': ts_hint_src})
    if r is not None:
        if isinstance(r.get('hints'), list):
            ok('synapseiq inlay-hints/ts', f'{r["hint_count"]} hints')
        else:
            fail('synapseiq inlay-hints/ts', f'unexpected response: {r}')
    else:
        fail('synapseiq inlay-hints/ts', 'no response from /lsp/inlay-hints')

    # Lua diagnostics (syntax error)
    import subprocess as _sp
    has_luac = _sp.run(['which', 'luac'], capture_output=True).returncode == 0
    if has_luac:
        lua_bad = 'function foo(\n  local x = 1\nend\n'
        r = http_post('http://127.0.0.1:2087/lsp/diagnostics', {'file': 'test.lua', 'text': lua_bad})
        if r and r.get('diagnostics'):
            ok('synapseiq diagnostics/lua', f'{len(r["diagnostics"])} errors via luac')
        else:
            fail('synapseiq diagnostics/lua', 'no syntax error caught by luac')
    else:
        skip('synapseiq diagnostics/lua', 'luac not installed')

    # Shell diagnostics (bash -n)
    import shutil as _sh
    if _sh.which('bash'):
        sh_bad = 'if [ $x -eq 1\nthen\n  echo hi\n'
        r = http_post('http://127.0.0.1:2087/lsp/diagnostics', {'file': 'test.sh', 'text': sh_bad})
        if r and r.get('diagnostics'):
            ok('synapseiq diagnostics/shell', f'{len(r["diagnostics"])} errors via bash -n')
        else:
            # bash -n may silently accept some broken scripts; skip rather than fail
            skip('synapseiq diagnostics/shell', 'bash -n returned no errors for test input')
    else:
        skip('synapseiq diagnostics/shell', 'bash not installed')

    # Rust diagnostics (rustc) — check capability, don't fail if rustc absent
    has_rustc = _sp.run(['which', 'rustc'], capture_output=True).returncode == 0
    caps = h.get('capabilities', {})
    if has_rustc:
        rust_bad = 'fn main() { let x: i32 = "oops"; }'
        r = http_post('http://127.0.0.1:2087/lsp/diagnostics', {'file': 'test.rs', 'text': rust_bad})
        if r and r.get('diagnostics'):
            ok('synapseiq diagnostics/rust', f'{len(r["diagnostics"])} errors via rustc')
        else:
            fail('synapseiq diagnostics/rust', 'no type error from rustc')
    else:
        skip('synapseiq diagnostics/rust', 'rustc not installed')

    # Go diagnostics — skip if go absent
    has_go = _sp.run(['which', 'go'], capture_output=True).returncode == 0
    if has_go:
        go_bad = 'package main\nfunc main() { var x int = "wrong" }'
        r = http_post('http://127.0.0.1:2087/lsp/diagnostics', {'file': 'test.go', 'text': go_bad})
        if r and r.get('diagnostics'):
            ok('synapseiq diagnostics/go', f'{len(r["diagnostics"])} errors via go build')
        else:
            fail('synapseiq diagnostics/go', 'no type error from go build')
    else:
        skip('synapseiq diagnostics/go', 'go not installed')


def test_agentd_http() -> None:
    """S1 — HTTP daemon mode."""
    import threading
    import time as _time

    port = 17722  # ephemeral test port (not 7722 to avoid conflicts)
    proc = subprocess.Popen(
        [sys.executable, str(AGENTD), '--http', str(port)],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
    )
    try:
        # Wait for startup line
        _time.sleep(1.0)
        h = http_get(f'http://127.0.0.1:{port}/health', timeout=3)
        if h and h.get('status') == 'ok':
            ok('agentd HTTP daemon /health', f"v{h.get('version','?')} mode={h.get('mode','?')}")
        else:
            fail('agentd HTTP daemon /health', str(h))

        # POST a ping
        r = http_post(f'http://127.0.0.1:{port}/stdio', {'action': 'ping'}, timeout=5)
        if r and r.get('status') == 'ok':
            ok('agentd HTTP daemon /stdio ping')
        else:
            fail('agentd HTTP daemon /stdio ping', str(r))
    finally:
        proc.terminate()
        proc.wait(timeout=3)


def test_shell_init() -> None:
    init_paths = [
        Path(__file__).parent.parent / 'shell' / 'turtle-shell-init.zsh',
        Path('/opt/homebrew/share/turtle-term/shell/turtle-shell-init.zsh'),
        Path.home() / '.local' / 'share' / 'turtleterm' / 'shell' / 'turtle-shell-init.zsh',
    ]
    found = next((p for p in init_paths if p.exists()), None)
    if found:
        ok('shell init file', str(found))
        # Check OSC 133 marks are present
        content = found.read_text()
        if '133;C' in content and '133;D' in content:
            ok('shell OSC 133 marks')
        else:
            fail('shell OSC 133 marks', 'missing 133;C or 133;D in shell init')
        if '_turtle_ai_complete' in content:
            ok('shell AI ghost-text widget (explicit)')
        else:
            fail('shell AI ghost-text widget', '_turtle_ai_complete not found')
        if '_turtle_ghost_tick' in content and 'TRAPALRM' in content:
            ok('shell AI ghost-text debounced (auto)')
        else:
            fail('shell AI ghost-text debounced', '_turtle_ghost_tick / TRAPALRM not found')
        if '_TURTLE_GHOST_SUGGESTION' in content and 'to accept' in content:
            ok('shell ghost-text preview-not-replace (S2)')
        else:
            fail('shell ghost-text preview-not-replace', '_TURTLE_GHOST_SUGGESTION or accept hint missing')
    else:
        skip('shell init file', 'not installed')


def test_plan_subsystem() -> None:
    r = agentd({'action': 'plan_status'})
    if r and r.get('status') == 'ok':
        ok('plan_status action')
    else:
        fail('plan_status action', str(r))

    r = agentd({'action': 'plan_abort'})
    if r and r.get('status') == 'ok':
        ok('plan_abort action')
        # Check that plan_abort emitted a plan event
        events_path = Path.home() / '.local' / 'state' / 'sourceos' / 'terminal' / 'plan-events.ndjson'
        if events_path.exists():
            last_event = events_path.read_text().strip().splitlines()
            if last_event:
                try:
                    ev = json.loads(last_event[-1])
                    if ev.get('type') in ('plan_aborted', 'plan_created', 'step_started', 'plan_complete'):
                        ok('plan event streaming', f'last event: {ev["type"]}')
                    else:
                        ok('plan event streaming', f'event file exists, last: {ev.get("type")}')
                except json.JSONDecodeError:
                    ok('plan event streaming', 'event file exists')
            else:
                skip('plan event streaming', 'event file empty (no plans run yet)')
        else:
            skip('plan event streaming', 'no events yet — run a plan first')
    else:
        fail('plan_abort action', str(r))

    plan_view = Path(__file__).parent / 'turtle-plan-view'
    if plan_view.exists() and os.access(plan_view, os.X_OK):
        ok('turtle-plan-view script')
        # Check --events flag works
        import subprocess as _sp2
        r2 = _sp2.run([sys.executable, str(plan_view), '--events'], capture_output=True, text=True, timeout=5)
        ok('turtle-plan-view --events flag', f'exit={r2.returncode}')
    else:
        fail('turtle-plan-view script', str(plan_view))


def test_bash_init() -> None:
    bash_paths = [
        Path(__file__).parent.parent / 'shell' / 'turtle-shell-init.bash',
        Path('/opt/homebrew/share/turtle-term/shell/turtle-shell-init.bash'),
    ]
    found = next((p for p in bash_paths if p.exists()), None)
    if found:
        content = found.read_text()
        checks = [
            ('bash OSC 133',              '133;C'),
            ('bash AI explicit ALT+/',    '_turtle_ai_complete'),
            ('bash AI bg fetch ALT+G',    '_turtle_ghost_fetch_bg'),
            ('bash AI ghost consume',     '_turtle_ghost_consume'),
            ('bash bind -x ALT+/',        'bind -x'),
        ]
        for name, needle in checks:
            if needle in content:
                ok(f'bash: {name}')
            else:
                fail(f'bash: {name}', f'"{needle}" not in turtle-shell-init.bash')
    else:
        skip('bash shell init', 'not found')


