def test_agentctl_new_dispatch():
    """Test agentctl dispatches new subcommands correctly (critical protocol fix)."""
    import subprocess
    bin_dir = Path.home() / "dev" / "TurtleTerm" / "assets" / "sourceos" / "bin"
    agentctl = bin_dir / "turtle-agentctl"
    tests = [
        (["--stdio", "plugin-list"],            "plugin_list"),
        (["--stdio", "memory-list"],            "memory_list"),
        (["--stdio", "persona-get"],            "persona_get"),
        (["--stdio", "file-tree", "."],         "file_tree"),
        (["--stdio", "docker-list"],            "docker_list"),
        (["--stdio", "ssh-profiles"],           "ssh_profiles"),
        (["--stdio", "persona-marketplace-list"], "persona_marketplace_list"),
        (["--stdio", "perf-stats"],             "perf_stats"),
    ]
    for args, expected_action in tests:
        r = subprocess.run(
            [sys.executable, str(agentctl)] + args,
            capture_output=True, text=True, timeout=15,
        )
        assert r.returncode == 0, f"agentctl {args} exit {r.returncode}: {r.stderr[:100]}"
        try:
            d = json.loads(r.stdout)
            assert d.get("status") == "ok", f"agentctl {args} status not ok: {d}"
        except json.JSONDecodeError:
            assert False, f"agentctl {args} bad JSON: {r.stdout[:100]}"
    ok("agentctl dispatch: 8 new subcommands verified")

