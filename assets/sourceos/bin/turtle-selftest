# Main
# ---------------------------------------------------------------------------

def main() -> int:
    if not AS_JSON:
        print(f'\n{BOLD}{CYAN}  TurtleTerm Self-Test{RESET}  {GRAY}v1.0.0{RESET}\n')

    test_agentd()
    test_agentctl()
    test_agentd_http()
    test_synapseiq()
    test_shell_init()
    test_bash_init()
    test_fish_init()
    test_plan_subsystem()
    test_mcp_plan_tools()
    test_completions()
    test_agentd_new_actions()
    test_g9_alias_learning()
    test_g10_git_context()
    test_g11_session_narrate()
    test_g13_sync()
    test_g14_voice()
    test_g_coach()
    test_smart_paste()
    test_dep_vuln()
    test_mcp_v06()
    test_synapseiq_v08_code_actions()
    test_synapseiq_v08_workspace_symbols()
    test_synapseiq_v08_workspace_diagnostics()
    test_agentctl_new_dispatch()
    test_bg_agent()
    test_webhook()
    test_error_patterns()
    test_scratchpad()
    test_policy_check()
    test_install_hooks()
    test_new_scripts_v2()
    test_mcp_v08()
    test_mcp_tool_count()
    test_persona_injection()
    test_version_alignment()
    test_t1_memory()
    test_t1_persona()
    test_t1_persona_marketplace()
    test_t1_shellcheck_fix()
    test_t2_workflow_detect()
    test_t2_file_tree()
    test_t2_perf()
    test_t2_output_export()
    test_t2_output_search()
    test_t3_plugin_list()
    test_t3_team_runbooks()
    test_t3_sftp_browse()
    test_new_scripts()
    test_runbook_script()
    test_update_notifier()
    test_neovim_plugin()
    test_language_binary()
    test_lua_config()
    # v1.1.0 tests
    test_gitea_surface()
    test_process_watch()
    test_cost_tracker()
    test_history_search()
    test_mcp_v09()
    test_new_scripts_v3()
    test_agentd_version_v11()
    # v1.0.0 MCP + copilot + gh parity tests
    test_copilot()
    test_gh_parity()
    test_turtle_gh_script()
    test_mcp_v10()

    passed = sum(1 for r in results if r['status'] == 'pass')
    failed = sum(1 for r in results if r['status'] == 'fail')
    skipped = sum(1 for r in results if r['status'] == 'skip')
    total = len(results)

    if AS_JSON:
        print(json.dumps({'results': results, 'passed': passed, 'failed': failed, 'skipped': skipped, 'total': total}, indent=2))
    else:
        print(f'\n  {BOLD}Results:{RESET}  {GREEN}{passed} pass{RESET}  {RED}{failed} fail{RESET}  {GRAY}{skipped} skip{RESET}  {CYAN}{total} total{RESET}\n')

    return 0 if failed == 0 else 1


if __name__ == '__main__':
    raise SystemExit(main())
