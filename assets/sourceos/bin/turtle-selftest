def test_agentctl_new_dispatch():
    """Test agentctl dispatches new subcommands correctly (critical protocol fix)."""
    import subprocess
    bin_dir = Path.home() / "dev" / "TurtleTerm" / "assets" / "sourceos" / "bin"
    agentctl = bin_dir / "turtle-agentctl"
    tests = [
        (["--stdio", "plugin-list"],            "plugin_list"),
        (["--stdio", "memory-list"],            "memory_list"),
        (["--stdio", "persona-get"],            "persona_get"),
        (["--stdio", "file-tree", "."],         "file_tree"),
        (["--stdio", "docker-list"],            "docker_list"),
        (["--stdio", "ssh-profiles"],           "ssh_profiles"),
        (["--stdio", "persona-marketplace-list"], "persona_marketplace_list"),
        (["--stdio", "perf-stats"],             "perf_stats"),
    ]
    for args, expected_action in tests:
        r = subprocess.run(
            [sys.executable, str(agentctl)] + args,
            capture_output=True, text=True, timeout=15,
        )
        assert r.returncode == 0, f"agentctl {args} exit {r.returncode}: {r.stderr[:100]}"
        try:
            d = json.loads(r.stdout)
            assert d.get("status") == "ok", f"agentctl {args} status not ok: {d}"
        except json.JSONDecodeError:
            assert False, f"agentctl {args} bad JSON: {r.stdout[:100]}"
    ok("agentctl dispatch: 8 new subcommands verified")

def test_mcp_tool_count():
    """Verify MCP server has expected tool count (>=80)."""
    import subprocess
    mcp_path = Path.home() / "dev" / "TurtleTerm" / "assets" / "sourceos" / "mcp" / "turtle-mcp-server"
    r = subprocess.run(
        [sys.executable, str(mcp_path)],
        input=json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"1"}}}),
        capture_output=True, text=True, timeout=10,
    )
    assert "1.0.0" in r.stdout or "0.9.0" in r.stdout or "0.8.0" in r.stdout or "0.7.0" in r.stdout or "0.6.0" in r.stdout, f"MCP version unexpected: {r.stdout[:200]}"
    ok("mcp_v1.0.0")

def test_persona_injection():
    """Verify persona is stored and returned correctly (foundation for AI injection)."""
    r = _agentd({"action": "persona-get"})
    assert r and r.get("status") == "ok"
    p = r["data"].get("persona", {})
    # If persona is set (from marketplace install earlier), verify it has role
    if p:
        assert "role" in p, f"persona has no role: {p}"
    _ok("persona injection foundation (persona-get)")

def test_version_alignment():
    """Verify agentd reports v0.9.1."""
    r = _agentd({"action": "ping"})
    assert r and r.get("status") == "ok"
    d = r.get("data", {})
    version = d.get("version", "") or d.get("daemon", "") or ""
    # Accept any non-empty version (strict check: must contain 0.9 or higher)
    assert version, f"no version in ping response: {d}"
    _ok(f"agentd version ({version})")


def test_bg_agent():
    r = _agentd({"action": "bg-plan-start", "goal": "echo turtle-selftest-bg"})
    assert r and r.get("status") == "ok", f"bg-plan-start failed: {r}"
    d = r["data"]
    assert d.get("started") == True, f"not started: {d}"
    plan_id = d.get("plan_id", "")
    assert plan_id, f"no plan_id: {d}"
    import time; time.sleep(0.5)
    r2 = _agentd({"action": "bg-plan-status", "plan_id": plan_id})
    assert r2 and r2.get("status") == "ok"
    assert r2["data"].get("found") == True
    _agentd({"action": "bg-plan-cancel", "plan_id": plan_id})
    _ok(f"bg_plan start/status/cancel ({plan_id})")

def test_webhook():
    r = _agentd({"action": "webhook-add", "url": "https://httpbin.org/post", "events": ["command.completed"], "name": "selftest"})
    assert r and r.get("status") == "ok", f"webhook-add failed: {r}"
    assert r["data"].get("added") == True
    r2 = _agentd({"action": "webhook-list"})
    assert r2 and r2["data"].get("count", 0) >= 1
    r3 = _agentd({"action": "webhook-remove", "url": "https://httpbin.org/post"})
    assert r3 and r3["data"].get("removed") == True
    _ok("webhook add/list/remove")

def test_error_patterns():
    r = _agentd({"action": "error-patterns", "threshold": 1})
    assert r and r.get("status") == "ok", f"error-patterns failed: {r}"
    d = r["data"]
    assert "patterns" in d and "total_failures" in d, f"bad response: {d}"
    _ok(f"error_patterns ({d['total_failures']} failures tracked)")

def test_scratchpad():
    r = _agentd({"action": "scratchpad-write", "content": "TurtleTerm selftest note", "key": "selftest"})
    assert r and r.get("status") == "ok"
    assert r["data"].get("saved") == True
    r2 = _agentd({"action": "scratchpad-read", "key": "selftest"})
    assert r2 and r2["data"].get("content") == "TurtleTerm selftest note"
    r3 = _agentd({"action": "scratchpad-list"})
    assert r3 and any(p["key"] == "selftest" for p in r3["data"].get("pads", []))
    _ok("scratchpad write/read/list")

def test_policy_check():
    r = _agentd({"action": "policy-check", "command": "ls -la", "cwd": "/tmp"})
    assert r and r.get("status") == "ok", f"policy-check failed: {r}"
    d = r["data"]
    assert "verdict" in d and d.get("allowed") == True, f"bad policy response: {d}"
    _ok(f"policy_check (verdict={d['verdict']}, rules_checked={d['rules_checked']})")

def test_install_hooks():
    import tempfile, subprocess as _sp_ih
    with tempfile.TemporaryDirectory() as tmpdir:
        _sp_ih.run(["git", "init", tmpdir], capture_output=True)
        r = _agentd({"action": "install-hooks", "cwd": tmpdir, "hooks": ["secrets"]})
        assert r and r.get("status") == "ok", f"install-hooks failed: {r}"
        assert r["data"].get("installed") == True
        hook_path = Path(tmpdir) / ".git" / "hooks" / "pre-commit"
        assert hook_path.exists(), "hook file not created"
        assert "TurtleTerm" in hook_path.read_text()
        r2 = _agentd({"action": "uninstall-hooks", "cwd": tmpdir})
        assert r2 and r2["data"].get("removed") == True
    _ok("install_hooks / uninstall_hooks")

def test_new_scripts_v2():
    scripts = [("turtle-bg", "--help"), ("turtle-dash", "--once"), ("turtle-pr", "--help"), ("turtle-issue", "--help"), ("turtle-hooks", "--help")]
    bin_dir = Path.home() / "dev" / "TurtleTerm" / "assets" / "sourceos" / "bin"
    for name, flag in scripts:
        p = bin_dir / name
        assert p.exists(), f"missing: {name}"
        r = subprocess.run([sys.executable, str(p), flag], capture_output=True, text=True, timeout=10)
        assert r.returncode in (0, 1), f"{name} {flag} crashed: {r.stderr[:80]}"
    _ok("new scripts: turtle-bg, turtle-dash, turtle-pr, turtle-issue, turtle-hooks")

