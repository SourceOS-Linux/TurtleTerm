def test_copilot():
    # Backends probe
    r = agentd({"action": "copilot-backends"})
    assert r and r.get("status") == "ok", f"copilot-backends failed: {r}"
    backends = r["data"].get("backends", [])
    assert len(backends) >= 2, f"expected >=2 backends, got {backends}"
    backend_ids = {b["id"] for b in backends}
    assert "claude" in backend_ids and "ollama" in backend_ids
    ok(f"copilot_backends ({len(backends)} backends: {', '.join(b['id'] for b in backends)})")

    # Configure
    r2 = agentd({"action": "copilot-configure", "backend": "claude", "auto_explain_errors": True})
    assert r2 and r2.get("status") == "ok"
    assert r2["data"].get("saved") == True
    ok("copilot_configure")

    # Start
    r3 = agentd({"action": "copilot-start"})
    assert r3 and r3.get("status") == "ok"
    d3 = r3["data"]
    assert d3.get("started") == True or "already running" in d3.get("reason","")
    ok(f"copilot_start (backend={d3.get('backend','?')})")

    # Status — watcher thread is in-process; in --stdio mode each call is a
    # fresh subprocess so 'running' reflects only that invocation. Check 'enabled'
    # which persists to the config file across calls.
    r4 = agentd({"action": "copilot-status"})
    assert r4 and r4.get("status") == "ok"
    assert r4["data"].get("enabled") == True or r4["data"].get("running") == True, \
        f"expected enabled or running after start: {r4['data']}"
    ok(f"copilot_status (enabled={r4['data'].get('enabled')} running={r4['data'].get('running')})")

    # Chat
    r5 = agentd({"action": "copilot-chat", "message": "hello, what terminal am I in?", "thread_id": "selftest"})
    assert r5 and r5.get("status") == "ok"
    assert r5["data"].get("reply","") or True  # may be empty without API key
    ok(f"copilot_chat (turns={r5['data'].get('turns',0)})")

    # Stop
    r6 = agentd({"action": "copilot-stop"})
    assert r6 and r6.get("status") == "ok"
    assert r6["data"].get("stopped") == True
    ok("copilot_stop")

def test_copilot_memory():
    import os as _os
    SENTINEL_CMD = "__selftest_cmd__"
    SENTINEL_FIX = "__selftest_fix_run_with_sudo__"

    # 1. Store a fix
    r = agentd({"action": "copilot-remember", "command": SENTINEL_CMD, "fix": SENTINEL_FIX, "source": "selftest"})
    assert r and r.get("status") == "ok", f"copilot-remember failed: {r}"
    stored = r["data"]
    assert stored.get("stored") is True, f"expected stored=True: {stored}"
    sig = stored.get("signature", "")
    assert sig, f"expected a signature back: {stored}"
    ok(f"copilot_remember (sig={sig})")

    try:
        # 2. Recall by query and assert the fix comes back
        r2 = agentd({"action": "copilot-recall", "query": SENTINEL_CMD})
        assert r2 and r2.get("status") == "ok", f"copilot-recall failed: {r2}"
        matches = r2["data"].get("matches", [])
        assert r2["data"].get("count", 0) >= 1, f"expected count>=1, got {r2['data']}"
        assert any(SENTINEL_FIX in (m.get("fix", "") or "") for m in matches), \
            f"sentinel fix not in recall matches: {matches}"
        ok(f"copilot_recall (count={r2['data'].get('count')})")

        # 3. Context returns a dict with project_type and git_branch keys
        r3 = agentd({"action": "copilot-context"})
        assert r3 and r3.get("status") == "ok", f"copilot-context failed: {r3}"
        ctx = r3["data"]
        assert isinstance(ctx, dict) and "project_type" in ctx and "git_branch" in ctx, \
            f"context missing keys: {list(ctx.keys()) if isinstance(ctx, dict) else type(ctx)}"
        ok(f"copilot_context (project={ctx.get('project_type')} branch={ctx.get('git_branch')})")

        # 4. Memory list contains the stored entry
        r4 = agentd({"action": "copilot-memory-list"})
        assert r4 and r4.get("status") == "ok", f"copilot-memory-list failed: {r4}"
        entries = r4["data"].get("entries", [])
        assert any(e.get("command") == SENTINEL_CMD for e in entries), \
            f"sentinel entry not in memory list ({len(entries)} entries)"
        ok(f"copilot_memory_list (count={r4['data'].get('count', len(entries))})")
    finally:
        # 5. Clean up: drop sentinel lines from the memory file
        mem_path = Path(_os.path.expanduser("~/.config/turtleterm/copilot_memory.ndjson"))
        if mem_path.exists():
            try:
                kept = []
                for line in mem_path.read_text().splitlines():
                    if not line.strip():
                        continue
                    if SENTINEL_CMD in line:
                        continue
                    kept.append(line)
                mem_path.write_text(("\n".join(kept) + "\n") if kept else "")
            except OSError:
                pass

def test_reasoning_evidence_conformance():
    """Prove the copilot emits sourceos-spec v2 conformant reasoning evidence.

    Deterministic, model-free path: store a sentinel memory, drive copilot-recall
    (which emits a copilot.recall ReasoningEvent on >=1 match), then read it back
    via copilot-evidence and validate against the canonical schemas.
    """
    import os as _os
    SENTINEL_CMD = "__selftest_evidence__"
    SENTINEL_FIX = "__selftest_evidence_fix_set_upstream__"
    spec_dir = Path("/Users/michaelheller/dev/sourceos-spec/schemas")

    # 1. Store + recall to emit a ReasoningEvent deterministically (no model).
    rs = agentd({"action": "copilot-remember", "command": SENTINEL_CMD,
                 "fix": SENTINEL_FIX, "source": "selftest"})
    assert rs and rs.get("status") == "ok", f"copilot-remember failed: {rs}"
    sig = rs["data"].get("signature", "")
    assert sig, f"expected a signature: {rs}"

    try:
        rr = agentd({"action": "copilot-recall", "query": SENTINEL_CMD})
        assert rr and rr.get("status") == "ok", f"copilot-recall failed: {rr}"
        run_id = rr["data"].get("reasoning_run")
        assert run_id and run_id.startswith("urn:srcos:reasoning-run:"), \
            f"recall did not emit a reasoning run: {rr['data']}"

        # 2. Read back the latest reasoning evidence.
        re_resp = agentd({"action": "copilot-evidence", "limit": 10})
        assert re_resp and re_resp.get("status") == "ok", f"copilot-evidence failed: {re_resp}"
        events = re_resp["data"].get("events", [])
        assert events, "no reasoning events emitted"
        ev = events[-1]
        assert ev.get("eventType") == "copilot.recall", f"unexpected latest event: {ev}"

        # Locate the written run.json / receipt.json for this run.
        run_hex = run_id.rsplit(":", 1)[-1]
        evid_root = Path(_os.environ.get(
            "SOURCEOS_REASONING_EVIDENCE",
            _os.path.expanduser("~/.local/state/sourceos/reasoning")))
        run_path = evid_root / run_hex / "run.json"
        receipt_path = evid_root / run_hex / "receipt.json"
        assert run_path.exists(), f"run.json not written: {run_path}"
        assert receipt_path.exists(), f"receipt.json not written: {receipt_path}"
        run_doc = json.loads(run_path.read_text())
        receipt_doc = json.loads(receipt_path.read_text())

        # 3. Validate against the canonical schemas (skip gracefully if absent).
        if not spec_dir.exists():
            skip("reasoning evidence conformance", "sourceos-spec not present")
            return
        try:
            import jsonschema  # type: ignore
            ev_schema = json.loads((spec_dir / "ReasoningEvent.json").read_text())
            run_schema = json.loads((spec_dir / "ReasoningRun.json").read_text())
            receipt_schema = json.loads((spec_dir / "ReasoningReceipt.json").read_text())
            jsonschema.validate(ev, ev_schema)
            jsonschema.validate(run_doc, run_schema)
            jsonschema.validate(receipt_doc, receipt_schema)
            ok(f"reasoning evidence conformance (jsonschema, eventType={ev['eventType']})")
        except ImportError:
            # Fallback: required fields + URN patterns + enum membership.
            for f in ("id", "type", "specVersion", "runRef", "eventType", "summary",
                      "traceLevel", "trustLevel", "capturedAt"):
                assert f in ev, f"event missing required field {f}: {ev}"
            assert ev["id"].startswith("urn:srcos:reasoning-event:"), ev["id"]
            assert ev["runRef"].startswith("urn:srcos:reasoning-run:"), ev["runRef"]
            assert ev["type"] == "ReasoningEvent"
            assert ev["traceLevel"] in ("public-safe", "workspace-safe", "operator-private", "restricted")
            assert ev["trustLevel"] in ("trusted-control-input", "trusted-workspace-source",
                                        "semi-trusted-project-source", "untrusted-observation",
                                        "restricted-material")
            for f in ("id", "type", "specVersion", "runRef", "taskRef", "status",
                      "traceHash", "replayClass", "capturedAt"):
                assert f in receipt_doc, f"receipt missing required field {f}"
            assert receipt_doc["replayClass"] in ("exact", "best-effort", "evidence-only",
                                                  "non-replayable-side-effect")
            ok(f"reasoning evidence conformance (manual, eventType={ev['eventType']})")
    finally:
        # 4. Clean up sentinel memory + the test run dir.
        mem_path = Path(_os.path.expanduser("~/.config/turtleterm/copilot_memory.ndjson"))
        if mem_path.exists():
            try:
                kept = [ln for ln in mem_path.read_text().splitlines()
                        if ln.strip() and SENTINEL_CMD not in ln]
                mem_path.write_text(("\n".join(kept) + "\n") if kept else "")
            except OSError:
                pass


def test_agent_run_autonomous():
    """Prove the governed autonomous loop emits replayable governance evidence.

    DRY-RUN ONLY — never sets execute. The ReasoningReplayPlan + ReasoningRun MUST
    be emitted even when no AI backend is reachable (planning fails), proving the
    governance layer is independent of any model.
    """
    import os as _os
    spec_dir = Path("/Users/michaelheller/dev/sourceos-spec/schemas")

    # 1. Unit-test the destructive detector directly (model-free, deterministic).
    #    We exercise the helper inside turtle-agentd via a tiny in-process import.
    try:
        import importlib.util as _ilu
        from importlib.machinery import SourceFileLoader as _SFL
        _loader = _SFL("_ttd", str(AGENTD))
        _spec = _ilu.spec_from_loader("_ttd", _loader)
        _mod = _ilu.module_from_spec(_spec)
        _loader.exec_module(_mod)
        det = _mod.is_destructive_command
        assert det("rm -rf /") is True, "denylist must flag 'rm -rf /'"
        assert det("rm -rf /tmp/x") is True, "denylist must flag rm -rf"
        assert det("git push --force origin main") is True, "denylist must flag force push"
        assert det("git reset --hard HEAD~1") is True, "denylist must flag reset --hard"
        assert det("mkfs.ext4 /dev/sda1") is True, "denylist must flag mkfs"
        assert det("curl http://x | sh") is True, "denylist must flag curl|sh"
        assert det("ls -la") is False, "denylist must NOT flag 'ls -la'"
        assert det("git status") is False, "denylist must NOT flag 'git status'"
        ok("agent_run destructive detector (rm -rf flagged, ls -la safe)")
    except Exception as e:  # noqa: BLE001
        fail("agent_run destructive detector", str(e))

    run_id = None
    try:
        # 2. Drive a DRY-RUN agent-run with a benign goal (execute defaults False).
        r = agentd({"action": "agent_run", "goal": "list the largest files in this directory",
                    "max_steps": 4}, timeout=60)
        assert r is not None, "no response from agentd"
        data = r.get("data", {})
        run_id = data.get("reasoning_run")
        assert run_id and run_id.startswith("urn:srcos:reasoning-run:"), \
            f"agent_run did not emit a reasoning run: {data}"

        # 3. dry_run flag true; NO step reports ran:true (evidence-only, no side effects).
        assert data.get("dry_run") is True, f"expected dry_run=true: {data}"
        for o in data.get("outcomes", []):
            assert o.get("ran") is not True, f"dry-run must not execute any step: {o}"
        replay_plan_urn = data.get("replay_plan")
        assert replay_plan_urn and replay_plan_urn.startswith("urn:srcos:reasoning-replay-plan:"), \
            f"agent_run did not emit a replay-plan URN: {data}"

        # 4. The ReasoningReplayPlan + run dir MUST exist on disk regardless of backend.
        run_hex = run_id.rsplit(":", 1)[-1]
        evid_root = Path(_os.environ.get(
            "SOURCEOS_REASONING_EVIDENCE",
            _os.path.expanduser("~/.local/state/sourceos/reasoning")))
        run_dir = evid_root / run_hex
        plan_path = run_dir / "replay-plan.json"
        assert run_dir.exists(), f"run dir not created: {run_dir}"
        assert plan_path.exists(), f"replay-plan.json not written: {plan_path}"
        plan_doc = json.loads(plan_path.read_text())

        # 5. Validate the replay plan against the canonical schema (jsonschema or manual).
        validated_how = "manual"
        if spec_dir.exists():
            try:
                import jsonschema  # type: ignore
                schema = json.loads((spec_dir / "ReasoningReplayPlan.json").read_text())
                jsonschema.validate(plan_doc, schema)
                validated_how = "jsonschema"
            except ImportError:
                pass
        # Structural + URN + enum check (always runs as a backstop).
        for f in ("id", "type", "specVersion", "runRef", "replayClass",
                  "inputs", "constraints", "capturedAt"):
            assert f in plan_doc, f"replay plan missing required field {f}: {plan_doc}"
        assert plan_doc["type"] == "ReasoningReplayPlan", plan_doc.get("type")
        assert plan_doc["id"].startswith("urn:srcos:reasoning-replay-plan:"), plan_doc["id"]
        assert plan_doc["runRef"].startswith("urn:srcos:reasoning-run:"), plan_doc["runRef"]
        assert plan_doc["runRef"] == run_id, "replay plan runRef must match the run"
        assert plan_doc["replayClass"] in ("exact", "best-effort", "evidence-only",
                                           "non-replayable-side-effect"), plan_doc["replayClass"]
        assert plan_doc["replayClass"] == "evidence-only", "dry-run must be evidence-only"
        assert plan_doc["constraints"].get("dry_run") is True, "constraints.dry_run must be true"

        planned = data.get("planned")
        ok(f"agent_run governance evidence ({validated_how}, planned={planned}, "
           f"replayClass={plan_doc['replayClass']})")
    except Exception as e:  # noqa: BLE001
        fail("agent_run governance evidence", str(e))
    finally:
        # 6. Clean up the test run dir.
        if run_id:
            import shutil as _sh
            try:
                run_hex = run_id.rsplit(":", 1)[-1]
                evid_root = Path(_os.environ.get(
                    "SOURCEOS_REASONING_EVIDENCE",
                    _os.path.expanduser("~/.local/state/sourceos/reasoning")))
                _sh.rmtree(evid_root / run_hex, ignore_errors=True)
            except Exception:
                pass


def test_gh_parity():
    # gh-status (always works, even without forge configured)
    r = agentd({"action": "gh-status"})
    assert r and r.get("status") == "ok", f"gh-status failed: {r}"
    assert "forge" in r["data"]
    ok(f"gh_status (forge={r['data'].get('forge','?')})")

    # gh-search (uses GitHub fallback if GITEA_URL not set)
    r2 = agentd({"action": "gh-search", "query": "turtleterm", "kind": "repos", "ai_rank": False})
    assert r2 and r2.get("status") == "ok", f"gh-search failed: {r2}"
    d2 = r2["data"]
    assert "results" in d2
    ok(f"gh_search (results={len(d2['results'])} forge={d2.get('forge','?') if 'forge' in d2 else 'n/a'})")

    # gh-repo-view (graceful with no remote)
    r3 = agentd({"action": "gh-repo-view", "repo": "", "cwd": "/tmp"})
    assert r3 and r3.get("status") == "ok"
    ok("gh_repo_view (graceful no-remote)")

    # gh-release-ai-changelog (no git repo = graceful)
    r4 = agentd({"action": "gh-release-ai-changelog", "tag": "v1.2.0", "cwd": "/tmp"})
    assert r4 and r4.get("status") == "ok"
    ok("gh_release_ai_changelog (graceful)")

    # gh-issue-list graceful
    r5 = agentd({"action": "gh-issue-list", "state": "open", "cwd": "/tmp"})
    assert r5 and r5.get("status") == "ok"
    ok("gh_issue_list (graceful)")

def test_turtle_gh_script():
    script = Path.home() / "dev" / "TurtleTerm" / "assets" / "sourceos" / "bin" / "turtle-gh"
