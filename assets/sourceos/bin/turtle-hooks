#!/usr/bin/env python3
"""turtle-hooks — Manage TurtleTerm git hooks.

Installs pre-commit hooks that scan for secrets, shellcheck issues,
and policy violations before every commit.

Usage:
  turtle-hooks install [DIR]      Install hooks in git repo (default: cwd)
  turtle-hooks uninstall [DIR]    Remove TurtleTerm hooks
  turtle-hooks status [DIR]       Show hook status
  turtle-hooks test [DIR]         Test hooks without committing
"""
from __future__ import annotations
import json, subprocess, sys
from pathlib import Path

AGENTCTL = Path(__file__).parent / "turtle-agentctl"

def agentd(payload: dict) -> dict | None:
    try:
        r = subprocess.run([sys.executable, str(AGENTCTL), "--stdio"],
            input=json.dumps(payload), text=True, capture_output=True, timeout=20)
        return json.loads(r.stdout)
    except Exception: return None

def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__); return 0

    subcmd = args[0]
    cwd = args[1] if len(args) > 1 and not args[1].startswith("-") else "."

    if subcmd == "install":
        hooks_arg = ["secrets", "shellcheck", "policy"]
        r = agentd({"action": "install-hooks", "cwd": cwd, "hooks": hooks_arg})
        if not r: print("agentd not responding", file=sys.stderr); return 1
        d = r.get("data", {})
        if d.get("installed"):
            print(f"✓ Hooks installed: {d['path']}")
            print(f"  Checks: {', '.join(d.get('hooks', []))}")
        else:
            print(f"Failed: {d.get('reason','?')}", file=sys.stderr); return 1
        return 0

    if subcmd == "uninstall":
        r = agentd({"action": "uninstall-hooks", "cwd": cwd})
        if not r: print("agentd not responding", file=sys.stderr); return 1
        d = r.get("data", {})
        print("✓ Hooks removed." if d.get("removed") else f"Note: {d.get('reason','?')}")
        return 0

    if subcmd == "status":
        hook_path = Path(cwd) / ".git" / "hooks" / "pre-commit"
        if not hook_path.exists():
            print("No pre-commit hook installed.")
        else:
            content = hook_path.read_text()
            managed = "TurtleTerm" in content
            print(f"Hook: {hook_path}")
            print(f"Managed by TurtleTerm: {'yes' if managed else 'no'}")
            if managed:
                checks = []
                if "detect-secrets" in content: checks.append("secrets")
                if "shellcheck" in content: checks.append("shellcheck")
                if "policy" in content: checks.append("policy")
                print(f"Checks: {', '.join(checks)}")
        return 0

    if subcmd == "test":
        print("Running pre-commit hook dry-run...")
        hook_path = Path(cwd) / ".git" / "hooks" / "pre-commit"
        if not hook_path.exists():
            print("No hook installed. Run: turtle-hooks install"); return 1
        result = subprocess.run(["sh", str(hook_path)], cwd=cwd)
        return result.returncode

    print(f"Unknown: {subcmd}", file=sys.stderr); return 1

if __name__ == "__main__": raise SystemExit(main())
