#!/usr/bin/env python3
"""TurtleTerm MCP server.

Exposes TurtleTerm terminal/session tools to MCP-compatible clients (Claude
Code, Cursor, VS Code, etc.) over stdio JSON-RPC 2.0.

Tools exposed (all read-only or proposal-only — no ambient shell authority):
  terminal_sessions                  List known terminal sessions from the event stream.
  terminal_inspect                   Return recent events for a session.
  terminal_summarize                 Summarize a session's completed commands.
  terminal_propose                   Propose a command (records but does not execute).
  terminal_receipts                  List receipt file paths for a session.
  terminal_execute_with_confirmation Inject a command into the terminal for human confirmation.
  terminal_events_since              Return terminal events after a given timestamp (streaming moat).
  terminal_wait_for_command          Wait for the next command to complete and return its result.
  language_diagnostics               Diagnostics for a file via SynapseIQ LSP or fallback.
  language_symbols                   Symbol list for a file via SynapseIQ LSP or fallback.
  language_hover                     Hover info (type/docs) for a symbol at a position.
  language_definition                Jump-to-definition for a symbol at a position.
  language_references                All references to a symbol at a position.
  language_format                    Format a source file with the appropriate formatter.
  noetica_status                     Check Noetica reachability.
  noetica_query                      Send a query to Noetica /api/chat.
  bookmark_add                       Save a shell command to the bookmark list.
  bookmark_list                      List all saved TurtleTerm command bookmarks.
  bookmark_remove                    Remove a command from TurtleTerm bookmarks.
  runbook_list                       List available runbooks from project and user directories.
  runbook_run                        Run a named runbook as a terminal plan.
  runbook_show                       Show the steps of a named runbook without running it.
  detect_secrets                     Scan text for secrets, API keys, and credentials.
  pre_exec_risk                      Assess risk level of a shell command before running it.
  shellcheck_lint                    Lint a shell script with shellcheck or bash -n fallback.
  inline_diff                        Get git diff of working tree after a file-modifying command.
  env_inspect                        Inspect environment variables with diff vs saved baseline.
  docker_list                        List running Docker containers (docker ps).
  docker_exec                        Exec into a Docker container via terminal prompt injection.
  ssh_profiles                       List SSH profiles from ~/.ssh/config.
  ssh_connect                        Inject an SSH connect command into the terminal.

Wiring to Claude Code (add to ~/.claude/settings.json mcpServers):
  {
    "turtleterm": {
      "type": "stdio",
      "command": "/path/to/turtle-mcp-server"
    }
  }
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any


AGENTD = Path(__file__).parent.parent / "bin" / "turtle-agentd"
LANGUAGE = Path(__file__).parent.parent / "bin" / "turtle-language"


def _agentd(request: dict[str, Any]) -> dict[str, Any]:
    """Call turtle-agentd --stdio and return parsed response."""
    result = subprocess.run(
        [sys.executable, str(AGENTD), "--stdio"],
        input=json.dumps(request),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=10,
        check=False,
    )
    if result.returncode not in (0, 1):
        return {"status": "error", "message": result.stderr.strip() or "agentd error"}
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return {"status": "error", "message": "agentd returned non-JSON"}


def _language(args: list[str]) -> dict[str, Any]:
    """Call turtle-language and return parsed response."""
    result = subprocess.run(
        [sys.executable, str(LANGUAGE), *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=10,
        check=False,
    )
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return {"status": "error", "message": result.stderr.strip() or "language CLI error"}


def _synapseiq(endpoint: str, payload: dict[str, Any]) -> dict[str, Any]:
    """Call SynapseIQ LSP HTTP API directly (faster than subprocess)."""
    import urllib.request
    import urllib.error
    import os as _os
    port = int(_os.environ.get("SYNAPSEIQ_LSP_PORT", "2087"))
    url = f"http://127.0.0.1:{port}{endpoint}"
    try:
        body = json.dumps(payload).encode()
        req = urllib.request.Request(url, data=body, method="POST",
                                     headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return {"status": "error", "message": f"SynapseIQ LSP not reachable on :{port} — start with: turtle-synapseiq start"}


