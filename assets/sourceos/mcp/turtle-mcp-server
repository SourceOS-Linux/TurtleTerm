    if name == 'memory_add': return _agentd({'action': 'memory-add', 'key': arguments.get('key'), 'value': arguments.get('value'), 'tags': arguments.get('tags', [])})
    if name == 'memory_list': return _agentd({'action': 'memory-list', 'query': arguments.get('query', ''), 'limit': arguments.get('limit', 20)})
    if name == 'memory_forget': return _agentd({'action': 'memory-forget', 'key': arguments.get('key')})
    if name == 'memory_search': return _agentd({'action': 'memory-search', 'query': arguments.get('query', ''), 'limit': arguments.get('limit', 5)})
    if name == 'persona_set': return _agentd({'action': 'persona-set', 'role': arguments.get('role'), 'stack': arguments.get('stack'), 'style': arguments.get('style'), 'preferred_tools': arguments.get('preferred_tools'), 'notes': arguments.get('notes')})
