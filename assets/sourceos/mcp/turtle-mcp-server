# ---------------------------------------------------------------------------
# Tool dispatch
# ---------------------------------------------------------------------------

def call_tool(name: str, arguments: dict[str, Any]) -> Any:
    if name == "terminal_sessions":
        return _agentd({"action": "sessions"})
    if name == "terminal_inspect":
        return _agentd({"action": "inspect", "session_id": arguments.get("session_id")})
    if name == "terminal_summarize":
        return _agentd({"action": "summarize", "session_id": arguments.get("session_id")})
    if name == "terminal_propose":
        cmd = arguments.get("command", "")
        if not cmd:
            return {"error": "command is required"}
        return _agentd({"action": "propose_command", "command": cmd})
    if name == "terminal_receipts":
        return _agentd({"action": "receipts", "session_id": arguments.get("session_id")})
    if name == "language_diagnostics":
        return _language(["diagnostics", arguments["file"]])
    if name == "language_symbols":
        return _language(["symbols", arguments["file"]])
    if name in ("language_hover", "language_definition", "language_references", "language_format"):
        file_path = arguments.get("file", "")
        text = arguments.get("text", "")
        if not text and file_path:
            try:
                text = Path(file_path).read_text(encoding="utf-8", errors="replace")
            except OSError:
                return {"error": f"could not read file: {file_path}"}
        endpoint_map = {
            "language_hover":       "/lsp/hover",
            "language_definition":  "/lsp/definition",
            "language_references":  "/lsp/references",
            "language_format":      "/lsp/format",
        }
        return _synapseiq(endpoint_map[name], {
            "file": file_path,
            "text": text,
            "line": arguments.get("line", 0),
            "character": arguments.get("character", 0),
        })
    if name == "noetica_status":
        return _agentd({"action": "noetica_status"})
    if name == "noetica_query":
        return _agentd({
            "action": "noetica_query",
            "text": arguments.get("text", ""),
            "session_id": arguments.get("session_id"),
        })
    if name == "policy_status":
        return _agentd({"action": "policy_status"})
    if name == "policy_evaluate":
        return _agentd({
            "action": "request_execution",
            "command": arguments.get("command", ""),
        })
    if name == "agent_machine_probe":
        return _agentd({"action": "agent_machine_probe"})
    if name == "bearbrowser_handoff":
        return _agentd({
            "action": "bearbrowser_handoff",
            "task": arguments.get("task", ""),
        })
    if name == "explain_selection":
        return _agentd({
            "action": "explain_selection",
            "text": arguments.get("text", ""),
            "context": {"cwd": arguments.get("cwd", "")},
        })
    if name == "nl_to_shell":
        return _agentd({
            "action": "nl_to_shell",
            "text": arguments.get("text", ""),
            "context": {
                "cwd": arguments.get("cwd", ""),
                "shell": arguments.get("shell", "zsh"),
            },
        })
    if name == "atlas_context":
        return _agentd({
            "action": "atlas_context",
            "cwd": arguments.get("cwd", ""),
        })
    if name == "atlas_acp_register":
        return _agentd({"action": "atlas_acp_register"})
    if name == "terminal_execute_with_confirmation":
        cmd = arguments.get("command", "").strip()
        desc = arguments.get("description", "")
        if not cmd:
            return {"error": "command is required"}
        return _agentd({
            "action": "terminal_execute_with_confirmation",
            "command": cmd,
            "description": desc,
        })
    if name == "plan_create":
        goal = arguments.get("goal", "")
        if not goal:
            return {"error": "goal is required"}
        return _agentd({"action": "plan_execute", "goal": goal})
    if name == "plan_status":
        return _agentd({"action": "plan_status"})
    if name == "plan_advance":
        return _agentd({"action": "plan_next"})
    if name == "plan_abort":
        return _agentd({"action": "plan_abort"})
    if name == "terminal_events_since":
        since_ms = float(arguments.get("since_ms", 0)) / 1000.0  # convert to seconds
        session_id = arguments.get("session_id", "")
        event_types = arguments.get("event_types", [])
        return _agentd({
            "action": "events_since",
            "since": since_ms,
            "session_id": session_id or None,
            "event_types": event_types or None,
        })
    if name == "terminal_wait_for_command":
        timeout_ms = min(int(arguments.get("timeout_ms", 30000)), 120000)
        session_id = arguments.get("session_id", "")
        return _agentd({
            "action": "wait_for_command",
            "timeout": timeout_ms / 1000.0,
            "session_id": session_id or None,
        })
    if name == "bookmark_add":
        return _agentd({"action": "bookmark_add", "command": arguments.get("command", ""), "note": arguments.get("note", "")})
    if name == "bookmark_list":
        return _agentd({"action": "bookmark_list"})
    if name == "bookmark_remove":
        return _agentd({"action": "bookmark_remove", "command": arguments.get("command", "")})
    if name == "runbook_list":
        return _agentd({"action": "runbook_list", "dir": arguments.get("dir", ".")})
    if name == "runbook_run":
        return _agentd({"action": "runbook_run", "name": arguments.get("name", ""), "dir": arguments.get("dir", ".")})
    if name == "runbook_show":
        return _agentd({"action": "runbook_show", "name": arguments.get("name", "")})
    if name == "detect_secrets":
        return _agentd({"action": "detect_secrets", "text": arguments.get("text", "")})
    if name == "pre_exec_risk":
        return _agentd({"action": "pre_exec_risk", "command": arguments.get("command", "")})
    if name == "shellcheck_lint":
        return _agentd({"action": "shellcheck_lint", "text": arguments.get("text", ""), "shell": arguments.get("shell", "bash")})
    if name == "inline_diff":
        return _agentd({"action": "inline_diff", "cwd": arguments.get("cwd", "."), "command": arguments.get("command", "")})
    if name == "env_inspect":
        return _agentd({"action": "env_inspect", "prefix": arguments.get("prefix", ""), "subaction": arguments.get("subaction", "list")})
    if name == "docker_list":
        return _agentd({"action": "docker_list"})
    if name == "docker_exec":
        return _agentd({"action": "docker_exec", "container": arguments.get("container", ""), "command": arguments.get("command", "bash")})
    if name == "ssh_profiles":
        return _agentd({"action": "ssh_profiles"})
    if name == "ssh_connect":
        return _agentd({"action": "ssh_connect", "host": arguments.get("host", ""), "user": arguments.get("user", ""), "port": arguments.get("port", "22")})
    if name == "workspace_list":
        import os as _os
        ws_dir = Path.home() / ".config" / "turtleterm" / "workspaces"
        if not ws_dir.exists():
            return {"workspaces": [], "note": "No workspaces saved yet — use CMD+SHIFT+S in TurtleTerm to save one."}
        workspaces = []
        for p in sorted(ws_dir.glob("*.json")):
            try:
                data = json.loads(p.read_text())
                workspaces.append({
                    "name": data.get("name", p.stem),
                    "saved_at": data.get("saved_at"),
                    "tab_count": len(data.get("tabs", [])),
                })
            except (json.JSONDecodeError, OSError):
                workspaces.append({"name": p.stem, "saved_at": None, "tab_count": None})
        return {"workspaces": workspaces, "count": len(workspaces)}
    return {"error": f"unknown tool: {name}"}


# ---------------------------------------------------------------------------
# JSON-RPC 2.0 over stdio
# ---------------------------------------------------------------------------

def send(obj: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def handle(msg: dict[str, Any]) -> dict[str, Any] | None:
    method = msg.get("method", "")
    msg_id = msg.get("id")

    if method == "initialize":
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "turtleterm", "version": "0.4.0"},
            },
        }

    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": msg_id, "result": {"tools": TOOLS}}

    if method == "tools/call":
        params = msg.get("params", {})
        name = params.get("name", "")
        arguments = params.get("arguments", {})
        try:
            result = call_tool(name, arguments)
        except Exception as exc:  # noqa: BLE001
            result = {"error": str(exc)}
        content = [{"type": "text", "text": json.dumps(result, indent=2, sort_keys=True)}]
        return {"jsonrpc": "2.0", "id": msg_id, "result": {"content": content}}

    if method == "notifications/initialized":
        return None  # no response for notifications

    if msg_id is not None:
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "error": {"code": -32601, "message": f"Method not found: {method}"},
        }
    return None


def main() -> None:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
            continue
        resp = handle(msg)
        if resp is not None:
            send(resp)


if __name__ == "__main__":
    main()
